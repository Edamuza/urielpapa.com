{
  "name": "urielpapa-com",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm lint && pnpm format:check && astro check && astro build && node scripts/vercel-routes.mjs && node scripts/check-html.mjs && pagefind --site .vercel/output/static",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/react": "^7.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.16",
    "@fontsource/albert-sans": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "dayjs": "^1.11.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-callouts": "^2.2.0",
    "satori": "^0.26.0",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^4.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^2.1.1",
    "globals": "^17.13.0",
    "pagefind": "^1.5.2",
    "prettier": "3.9.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "packageManager": "pnpm@10.28.0",
  "description": "urielpapa.com: a personal knowledge-sharing site built with Astro, Tailwind CSS and Keystatic."
