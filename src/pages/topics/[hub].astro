---
import { getEntries, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PostCard from "@/components/PostCard.astro";
import NewsletterBox from "@/components/NewsletterBox.astro";
import { SHOW_DRAFTS } from "@/config";
import {
  answerUrl,
  getAllBlogEntries,
  getAnswers,
  getReleases,
  getTerms,
  releaseUrl,
  termUrl,
  getHubs,
  getNotes,
  getProjects,
  noteUrl,
  postUrl,
  projectUrl,
  readingTime,
  type Hub,
  type Post,
} from "@/utils/content";
import { breadcrumbNode, collectionNode } from "@/utils/schema";

export async function getStaticPaths() {
  const hubs = await getHubs();
  return hubs.map(hub => ({ params: { hub: hub.id }, props: { hub } }));
}

type Props = { hub: Hub };
const { hub } = Astro.props;
const { Content } = await render(hub);

const blog = (await getAllBlogEntries()).filter(p => p.data.hub === hub.id);
const notes = (await getNotes()).filter(n => n.data.hub === hub.id);
const articles = blog.filter(p => p.data.frame !== "event-note");
const eventNotes = blog.filter(p => p.data.frame === "event-note");
const projects = (await getProjects())
  .filter(p => (p.data.hubs as string[]).includes(hub.id))
  .slice(0, 3);

// Short pages for this hub: newest 10 of each, with a link to the full list.
const SHORT_LIMIT = 10;
const hubAnswers = (await getAnswers()).filter(a => a.data.hub === hub.id);
const hubTerms = (await getTerms()).filter(t => t.data.hub === hub.id);
const hubReleases = (await getReleases()).filter(r => r.data.hub === hub.id);
const shortBlocks = [
  {
    id: "answers",
    heading: "Answers",
    total: hubAnswers.length,
    all: { href: "/answers", label: "All answers" },
    items: hubAnswers.slice(0, SHORT_LIMIT).map(a => ({
      href: answerUrl(a),
      title: a.data.question,
    })),
  },
  {
    id: "glossary",
    heading: "Glossary",
    total: hubTerms.length,
    all: { href: "/glossary", label: "The full glossary" },
    items: hubTerms.slice(0, SHORT_LIMIT).map(t => ({
      href: termUrl(t),
      title: t.data.term,
    })),
  },
  {
    id: "releases",
    heading: "Latest releases",
    total: hubReleases.length,
    all: { href: "/releases", label: "All release notes" },
    items: hubReleases.slice(0, SHORT_LIMIT).map(r => ({
      href: releaseUrl(r),
      title: r.data.title,
    })),
  },
].filter(b => b.items.length > 0);

const picks = await getEntries(hub.data.startHere.map(s => s.post));
const startHere = hub.data.startHere
  .map((s, i) => ({ ...s, entry: picks[i] as Post | undefined }))
  .filter(s => s.entry && (SHOW_DRAFTS || !s.entry.data.draft));

// Posts and notes together, newest first, each with its format label.
const all = [
  ...articles.map(p => ({
    href: postUrl(p),
    title: p.data.title,
    summary: p.data.dek,
    date: p.data.published,
    frame: p.data.frame as string,
    minutes: readingTime(p.body),
    draft: p.data.draft,
  })),
  ...notes.map(n => ({
    href: noteUrl(n),
    title: n.data.title,
    summary: n.data.description,
    date: n.data.published,
    frame: "Note",
    minutes: undefined,
    draft: n.data.draft,
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());
// Long posts and notes first, so news takes never push the guides down the page.
const guides = all.filter(a => a.frame !== "news-take");
const news = all.filter(a => a.frame === "news-take");

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Topics", href: "/topics" },
  { name: hub.data.title, href: `/topics/${hub.id}` },
];
const schema = [
  collectionNode({
    path: `/topics/${hub.id}`,
    name: hub.data.title,
    description: hub.data.description,
    items: all.map(a => ({ name: a.title, href: a.href })),
  }),
  breadcrumbNode(crumbs),
];
---

<Layout
  title={hub.data.seoTitle}
  description={hub.data.description}
  schema={schema}
>
  <div class="app-layout page-top">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="h1">{hub.data.title}</h1>
    <div class="app-prose mt-4 text-lg"><Content /></div>

    {
      startHere.length > 0 && (
        <section class="max-w-read section-gap" aria-labelledby="start-h">
          <h2 id="start-h" class="h2 mb-4">
            Start here
          </h2>
          <ol class="space-y-4">
            {startHere.map(s => (
              <li class="bg-muted rounded-lg p-4">
                <a href={postUrl(s.entry!)} class="font-semibold">
                  {s.entry!.data.title}
                </a>
                <p class="mt-1 text-[0.95rem]">{s.reason}</p>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <section class="max-w-read section-gap" aria-labelledby="all-h">
      <h2 id="all-h" class="h2 mb-4">
        Guides and notes on{" "}
        {hub.data.title.replace(/^The /, "the ")}
      </h2>
      {
        guides.length > 0 ? (
          <ul>
            {guides.map(a => (
              <PostCard
                href={a.href}
                title={a.title}
                summary={a.summary}
                date={a.date}
                minutes={a.minutes}
                frame={a.frame}
                draft={a.draft}
                showHub={false}
              />
            ))}
          </ul>
        ) : news.length === 0 ? (
          <p>
            The first posts on this topic are being written. Subscribe below to
            get them by email.
          </p>
        ) : (
          <p>
            The first long posts on this topic are being written. Meanwhile,
            here are the latest news takes.
          </p>
        )
      }
    </section>

    {
      news.length > 0 && (
        <section class="max-w-read section-gap" aria-labelledby="news-h">
          <h2 id="news-h" class="h2 mb-4">
            News takes on {hub.data.title.replace(/^The /, "the ")}
          </h2>
          <ul>
            {news.map(a => (
              <PostCard
                href={a.href}
                title={a.title}
                summary={a.summary}
                date={a.date}
                minutes={a.minutes}
                frame={a.frame}
                draft={a.draft}
                showHub={false}
              />
            ))}
          </ul>
        </section>
      )
    }

    {
      shortBlocks.map(b => (
        <section
          class="max-w-read section-gap"
          aria-labelledby={`short-${b.id}`}
        >
          <h2 id={`short-${b.id}`} class="h2 mb-4">
            {b.heading}
          </h2>
          <ul class="space-y-2">
            {b.items.map(i => (
              <li>
                <a href={i.href} title={i.title}>
                  {i.title}
                </a>
              </li>
            ))}
          </ul>
          <p class="meta mt-3">
            <a href={b.all.href} title={b.all.label}>
              {b.all.label}
            </a>
            {b.total > b.items.length && ` (${b.total} on this topic)`}
          </p>
        </section>
      ))
    }

    {
      projects.length > 0 && (
        <section class="max-w-read section-gap" aria-labelledby="proj-h">
          <h2 id="proj-h" class="h2 mb-4">
            Related projects
          </h2>
          <ul class="space-y-2">
            {projects.map(p => (
              <li>
                <a href={projectUrl(p)}>{p.data.title}</a>: {p.data.outcome}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      eventNotes.length > 0 && (
        <section class="max-w-read section-gap" aria-labelledby="ev-h">
          <h2 id="ev-h" class="h2 mb-4">
            Events on this topic
          </h2>
          <ul>
            {eventNotes.map(e => (
              <PostCard
                href={postUrl(e)}
                title={e.data.title}
                date={e.data.published}
                draft={e.data.draft}
                showHub={false}
              />
            ))}
          </ul>
        </section>
      )
    }

    <NewsletterBox from={`hub:${hub.id}`} />
  </div>
</Layout>
