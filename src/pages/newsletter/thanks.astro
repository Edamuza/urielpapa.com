---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Check your inbox"
  description="Confirm your newsletter subscription."
  noindex
>
  <div class="app-layout max-w-read pt-12">
    <h1 class="h1">Almost done: check your inbox</h1>
    <p class="mt-4 text-lg">
      I've sent you an email to confirm your address. Click the link in it and
      you're subscribed.
    </p>
    <p class="mt-6"><a href="/blog">Back to the writing</a></p>
  </div>
</Layout>
