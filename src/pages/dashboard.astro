    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  th {
    font-weight: 600;
    color: var(--muted-foreground);
  }
  .r {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .status {
    display: inline-block;
    width: 1.1em;
    text-align: center;
