---
/**
 * Private site dashboard: posts published, scheduled-task runs and problems,
 * what is queued next, what still needs indexing, and search numbers. Runs on
 * demand behind a password (DASHBOARD_PASSWORD) and is never indexed. Data
 * sources are described in src/lib/dashboard.ts.
 */
import { dashboardGate } from "@/lib/dashboard-auth";
import { refreshSetup } from "@/lib/search-refresh";
import Layout from "@/layouts/Layout.astro";
import { hubName } from "@/data/hubs";
import { countSources, daysSinceLaunch, listPages } from "@/lib/site-stats";
import {
  SEARCH,
  contentTotals,
  hubCoverage,
  indexingQueue,
  keywordStats,
  longFormQueue,
  newsRuns,
  postsPerDay,
  problems,
  gscInspectUrl,
  refreshQueue,
  todayManila,
  type RunStatus,
} from "@/lib/dashboard";
import { formatDate } from "@/utils/content";
import { CLARITY_PROJECT_ID } from "@/config";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");

// Open on localhost; in production (and preview deployments) it needs the password.
const blocked = dashboardGate(Astro.request);
if (blocked) return blocked;

const today = todayManila();
const totals = await contentTotals();
const pages = await listPages();
const sources = await countSources();
const days = daysSinceLaunch();
const perDay = await postsPerDay(30);
const maxDay = Math.max(1, ...perDay.map(d => d.total));
const runs = await newsRuns(21);
const issues = await problems(21);
const queue = await longFormQueue();
const upcoming = queue.filter(q => !q.live);
const coverage = await hubCoverage();
const refresh = await refreshQueue();
const toIndex = await indexingQueue(pages);
const kw = keywordStats();
const g = SEARCH.google;
const perf = g.performance;
const bing = SEARCH.bing;
const checkedPages = SEARCH.inspections
  ? [...pages].filter(p => SEARCH.inspections?.[p]).length
  : null;
const clarity = SEARCH.clarity;
const isTraffic = (name: string) => /^traffic$/i.test(name.replace(/\s/g, ""));
const clarityTraffic =
  clarity?.metrics.find(m => isTraffic(m.name))?.values ?? {};
const claritySignals = clarity?.metrics.filter(m => !isTraffic(m.name)) ?? [];
const claritySessions = clarityTraffic.totalSessionCount ?? null;
/** "sessionsWithMetricPercentage" → "Sessions with metric %". */
const fieldLabel = (key: string) =>
  key
    .replace(/Percentage$/, " %")
    .replace(/([a-z])([A-Z])/g, "$1 $2")
    .toLowerCase()
    .replace(/^./, c => c.toUpperCase());
const clarityUrl = CLARITY_PROJECT_ID
  ? `https://clarity.microsoft.com/projects/view/${CLARITY_PROJECT_ID}/dashboard`
  : null;

const fmt = (n: number | null | undefined, digits = 0) =>
  n === null || n === undefined
    ? "–"
    : n.toLocaleString("en-US", {
        minimumFractionDigits: digits,
        maximumFractionDigits: digits,
      });
const pct = (n: number | null | undefined) =>
  n === null || n === undefined ? "–" : `${(n * 100).toFixed(1)}%`;
const day = (iso: string | null | undefined, format = "D MMM") =>
  iso ? formatDate(new Date(`${iso}T12:00:00+08:00`), format) : "–";
const range = (from: string | null, to: string | null) =>
  from && to
    ? `${day(from)} to ${day(to, "D MMM YYYY")}`
    : "date range unknown";
const ageDays = (iso: string) =>
  Math.round(
    (Date.parse(`${today}T00:00:00Z`) - Date.parse(`${iso}T00:00:00Z`)) /
      86_400_000
  );

const STATUS: Record<RunStatus, { mark: string; label: string }> = {
  published: { mark: "✓", label: "Published" },
  warning: { mark: "!", label: "Published, with issues" },
  skipped: { mark: "–", label: "Skipped" },
  failed: { mark: "✕", label: "Failed" },
  "no-run": { mark: "?", label: "No run recorded" },
  unlogged: { mark: "·", label: "Not logged" },
  attention: { mark: "→", label: "Needs attention" },
};

const lastRun = runs.find(r => r.status !== "no-run" || r.date !== today);
const streak = (() => {
  let n = 0;
  for (const r of runs) {
    if (r.date === today && r.status === "no-run") continue;
    if (["published", "warning", "unlogged"].includes(r.status) && r.slug) n++;
    else break;
  }
  return n;
})();
const nextLongForm = upcoming[0];
const requestToday = toIndex.filter(i => !i.requestedOn).slice(0, 10);
const indexLater = toIndex.filter(i => !i.requestedOn).slice(10);
const requested = toIndex.filter(i => i.requestedOn);
const snapshotAge = ageDays(g.checkedOn);
const setup = refreshSetup();
const refreshResult = Astro.url.searchParams.get("refresh");
const refreshNote = Astro.url.searchParams.get("note") ?? "";
const failures = issues.filter(
  i => i.kind === "failed" || i.kind === "no-run"
).length;

const sections = [
  ["overview", "Overview"],
  ["publishing", "Publishing"],
  ["runs", "Daily task log"],
  ["errors", "Errors and warnings"],
  ["next", "Up next"],
  ["indexing", "Indexing"],
  ["search", "Search and keywords"],
  ["behavior", "Visitor behavior"],
  ["coverage", "Topic coverage"],
] as const;
---

<Layout
  title="Dashboard"
  description="Private dashboard for urielpapa.com: posts, scheduled task logs, the publishing queue, indexing and search numbers."
  noindex
>
  <div class="app-layout pt-8 pb-16">
    <header class="mb-8">
      <h1 class="h1">Site dashboard</h1>
      <p class="max-w-read mt-3 text-lg">
        Everything about urielpapa.com in one place: what has been published,
        what the daily task did, what goes out next, what still needs indexing
        and how the site shows up in search.
      </p>
      <p class="meta mt-3">
        Built {day(today, "D MMMM YYYY")} (Manila) from the repository. Search numbers
        are a snapshot from {day(g.checkedOn, "D MMM YYYY")}
        {snapshotAge > 7 ? `, ${snapshotAge} days old` : ""}.
      </p>
      <form
        method="post"
        action="/dashboard/refresh"
        class="refresh mt-4"
        aria-describedby="refresh-help"
      >
        <button type="submit" disabled={!setup.ready}>
          Refresh search data
        </button>
        <p id="refresh-help" class="meta">
          {
            setup.ready
              ? "Reads Search Console, Bing and Clarity now, checks the index status of as many pages as fit in a minute (the rest on the next refresh), then saves it. The new numbers show after the site redeploys, about 2 minutes later." +
                (setup.missing.length
                  ? " Not connected yet: " + setup.missing.join(", ") + "."
                  : "")
              : "Not set up yet. Add " +
                setup.missing.join(", ") +
                " in Vercel (see the README)."
          }
        </p>
        <div class="refresh-progress" data-state="running" hidden>
          <div
            class="refresh-bar"
            role="progressbar"
            aria-label="Refresh progress"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
          >
            <span></span>
          </div>
          <p class="refresh-status" role="status" aria-live="polite">
            <strong data-label>Starting</strong>
            <span class="meta" data-elapsed></span>
          </p>
          <p class="refresh-detail meta" data-detail></p>
          <button type="button" class="refresh-reload" data-reload hidden>
            Reload the dashboard
          </button>
        </div>
        {
          refreshResult && (
            <p class="refresh-note" data-status={refreshResult} role="status">
              <strong>
                {refreshResult === "ok"
                  ? "Saved. Reload in about 2 minutes to see it."
                  : refreshResult === "partial"
                    ? "Saved, but a source failed and kept its old numbers."
                    : "Refresh failed."}
              </strong>{" "}
              {refreshNote}
            </p>
          )
        }
      </form>
      <nav aria-label="Dashboard sections" class="mt-4">
        <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
          {
            sections.map(([id, label]) => (
              <li>
                <a href={`#${id}`} title={`Jump to ${label}`}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <section id="overview" aria-labelledby="overview-h" class="dash-section">
      <h2 id="overview-h" class="h2 mb-4">Overview</h2>
      <dl class="grid grid-cols-2 gap-3 md:grid-cols-4">
        <div class="tile">
          <dt>Posts published</dt>
          <dd class="num">{fmt(totals.posts)}</dd>
          <dd class="meta">
            {fmt(totals.news)} news, {fmt(totals.longForm)} long-form, {
              fmt(totals.events)
            } event
          </dd>
        </div>
        <div class="tile">
          <dt>This week</dt>
          <dd class="num">{fmt(totals.last7)}</dd>
          <dd class="meta">Posts in the last 7 days</dd>
        </div>
        <div class="tile">
          <dt>Pages on the site</dt>
          <dd class="num">{fmt(pages.size)}</dd>
          <dd class="meta">As the sitemap lists them</dd>
        </div>
        <div class="tile">
          <dt>Indexed in Google</dt>
          <dd class="num">{fmt(g.indexing.indexed)}</dd>
          <dd class="meta">
            {fmt(g.indexing.notIndexed)} not indexed{
              checkedPages !== null && checkedPages < pages.size
                ? `, ${fmt(pages.size - checkedPages)} not checked yet`
                : ""
            }, as of {day(g.indexing.lastUpdated ?? g.checkedOn)}
          </dd>
        </div>
        <div class="tile">
          <dt>Drafts waiting</dt>
          <dd class="num">{fmt(totals.drafts)}</dd>
          <dd class="meta">
            {
              nextLongForm
                ? `Next due ${day(nextLongForm.publishOn)}${nextLongForm.overdue ? " (overdue)" : ""}`
                : "Queue is empty"
            }
          </dd>
        </div>
        <div class="tile">
          <dt>Daily news streak</dt>
          <dd class="num">{fmt(streak)}</dd>
          <dd class="meta">
            {
              lastRun
                ? `Last run ${day(lastRun.date)}: ${STATUS[lastRun.status].label.toLowerCase()}`
                : "No runs yet"
            }
          </dd>
        </div>
        <div class="tile">
          <dt>Search keywords</dt>
          <dd class="num">{fmt(kw.total)}</dd>
          <dd class="meta">{fmt(kw.top10)} in the top 10 on Google</dd>
        </div>
        <div class="tile">
          <dt>Google clicks</dt>
          <dd class="num">{fmt(perf.clicks)}</dd>
          <dd class="meta">
            {fmt(perf.impressions)} impressions, {range(perf.from, perf.to)}
          </dd>
        </div>
        <div class="tile">
          <dt>Words published</dt>
          <dd class="num">{fmt(totals.words)}</dd>
          <dd class="meta">Posts and notes</dd>
        </div>
        <div class="tile">
          <dt>Sources cited</dt>
          <dd class="num">{fmt(sources)}</dd>
          <dd class="meta">Outside pages linked</dd>
        </div>
        <div class="tile">
          <dt>Days live</dt>
          <dd class="num">{fmt(days)}</dd>
          <dd class="meta">
            Notes {fmt(totals.notes)}, projects {fmt(totals.projects)}
          </dd>
        </div>
        <div class="tile">
          <dt>Problems, 21 days</dt>
          <dd class="num">{fmt(issues.length)}</dd>
          <dd class="meta">
            {fmt(failures)} failed or silent runs
          </dd>
        </div>
      </dl>
    </section>

    <section
      id="publishing"
      aria-labelledby="publishing-h"
      class="dash-section"
    >
      <h2 id="publishing-h" class="h2 mb-1">Posts per day</h2>
      <p class="meta mb-4">
        Last 30 days, Manila dates. Most days the daily task adds one news take;
        the tall bars are days when batches of posts went live.
      </p>
      <div
        class="chart"
        role="img"
        aria-label={`Posts per day for the last 30 days. Highest: ${maxDay} in a day.`}
      >
        <span class="chart-max meta" aria-hidden="true">{maxDay}</span>
        <ol class="bars">
          {
            perDay.map(d => (
              <li
                tabindex="0"
                data-tip={`${day(d.day)}: ${d.total} ${d.total === 1 ? "post" : "posts"}${d.total ? ` (${d.news} news, ${d.other} other)` : ""}`}
                style={`--h:${(d.total / maxDay) * 100}%`}
                class={d.total ? "" : "empty"}
              >
                <span class="sr-only">
                  {day(d.day)}: {d.total}
                </span>
              </li>
            ))
          }
        </ol>
        <div class="chart-axis meta" aria-hidden="true">
          <span>{day(perDay[0].day)}</span>
          <span>{day(perDay[14].day)}</span>
          <span>{day(perDay.at(-1)?.day)}</span>
        </div>
      </div>
      <details class="mt-3">
        <summary class="meta cursor-pointer">Show as a table</summary>
        <div class="table-wrap mt-2">
          <table>
            <thead>
              <tr><th>Day</th><th>News</th><th>Other</th><th>Total</th></tr>
            </thead>
            <tbody>
              {
                [...perDay].reverse().map(d => (
                  <tr>
                    <td>{day(d.day, "ddd D MMM")}</td>
                    <td>{d.news}</td>
                    <td>{d.other}</td>
                    <td>{d.total}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </details>
    </section>

    <section id="runs" aria-labelledby="runs-h" class="dash-section">
      <h2 id="runs-h" class="h2 mb-1">Daily news task log</h2>
      <p class="meta mb-4">
        One row per run, newest first, from <code>docs/publish-log.md</code>.
        Days before the log started are filled in from the posts' publish dates.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Date</th><th>Status</th><th>Post</th><th>Note</th></tr>
          </thead>
          <tbody>
            {
              runs.map(r => (
                <tr data-status={r.status}>
                  <td class="whitespace-nowrap">{day(r.date, "ddd D MMM")}</td>
                  <td class="whitespace-nowrap">
                    <span class="status" aria-hidden="true">
                      {STATUS[r.status].mark}
                    </span>{" "}
                    {STATUS[r.status].label}
                  </td>
                  <td>
                    {r.url ? (
                      <a href={r.url} title={`Read the news take: ${r.title}`}>
                        {r.title}
                      </a>
                    ) : r.slug ? (
                      r.title
                    ) : (
                      "–"
                    )}
                  </td>
                  <td class="meta">{r.note}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section id="errors" aria-labelledby="errors-h" class="dash-section">
      <h2 id="errors-h" class="h2 mb-1">Errors and warnings</h2>
      <p class="meta mb-4">
        Failed, skipped or warned runs from the log, days with no run, news
        takes without photos, overdue long-form posts and drafts outside the
        queue.
      </p>
      {
        issues.length ? (
          <ul class="issues">
            {issues.map(i => (
              <li data-status={i.kind}>
                <span class="whitespace-nowrap">
                  <span class="status" aria-hidden="true">
                    {STATUS[i.kind].mark}
                  </span>{" "}
                  <strong>{STATUS[i.kind].label}</strong>
                </span>
                <span class="meta whitespace-nowrap">{day(i.date)}</span>
                <span>{i.text}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p>Nothing went wrong in the last 21 days.</p>
        )
      }
    </section>

    <section id="next" aria-labelledby="next-h" class="dash-section">
      <h2 id="next-h" class="h2 mb-1">Up next</h2>
      <p class="meta mb-4">
        The daily news take publishes every morning on its own. Long-form posts
        follow the queue in <code>docs/content-plan.md</code>, Tuesdays and
        Fridays, once their <code>[Uriel: …]</code> spots are filled.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Publish on</th><th>Post</th><th>Topic</th><th>Format</th><th
                >Ready?</th
              >
            </tr>
          </thead>
          <tbody>
            {
              upcoming.map(q => (
                <tr>
                  <td class="whitespace-nowrap">
                    {day(q.publishOn, "ddd D MMM")}
                    {q.overdue && <span class="meta"> (overdue)</span>}
                  </td>
                  <td>
                    {q.title}
                    <div class="meta">{q.question}</div>
                  </td>
                  <td>{hubName(q.hub)}</td>
                  <td>{q.frame}</td>
                  <td>
                    {q.missing
                      ? "Not written yet"
                      : q.markers
                        ? `Needs your input (${q.markers} ${q.markers === 1 ? "spot" : "spots"})`
                        : "Written, waiting for your go-ahead"}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      {upcoming.length === 0 && <p>The long-form queue is empty.</p>}
    </section>

    <section id="indexing" aria-labelledby="indexing-h" class="dash-section">
      <h2 id="indexing-h" class="h2 mb-1">Next to index in Search Console</h2>
      <p class="meta mb-4">
        Pages Search Console's Page indexing report lists as not indexed (report
        last updated {day(g.indexing.lastUpdated ?? g.checkedOn, "D MMM YYYY")},
        read {day(g.checkedOn)}), then pages published or updated after that.
        Hub and listing pages come first, because they link everything else.
        Search Console allows about 10 indexing requests a day.
      </p>
      <h3 class="h3 mb-2">Request today ({requestToday.length})</h3>
      {
        requestToday.length ? (
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <>
                    <th>Page</th>
                    <th>Why</th>
                    <th>Since</th>
                    <th>Inspect</th>
                  </>
                </tr>
              </thead>
              <tbody>
                {requestToday.map(i => (
                  <tr>
                    <td>
                      <a href={i.path} title={`Open ${i.path} on the site`}>
                        {i.path}
                      </a>
                    </td>
                    <td>{i.why}</td>
                    <td class="whitespace-nowrap">{day(i.since)}</td>
                    <td>
                      <a
                        href={gscInspectUrl(i.path)}
                        rel="noopener"
                        target="_blank"
                        title={`Inspect ${i.path} in Google Search Console`}
                      >
                        Inspect
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p>Nothing waiting: every page was indexed or requested.</p>
        )
      }
      {
        indexLater.length > 0 && (
          <details class="mt-3">
            <summary class="meta cursor-pointer">
              {indexLater.length} more for the following days
            </summary>
            <ul class="mt-2 text-sm">
              {indexLater.map(i => (
                <li>
                  <a href={i.path} title={`Open ${i.path} on the site`}>
                    {i.path}
                  </a>{" "}
                  <span class="meta">
                    {i.why}, {day(i.since)}
                  </span>
                </li>
              ))}
            </ul>
          </details>
        )
      }
      {
        requested.length > 0 && (
          <details class="mt-3">
            <summary class="meta cursor-pointer">
              {requested.length} already requested, waiting for Google
            </summary>
            <ul class="mt-2 text-sm">
              {requested.map(i => (
                <li>
                  <a href={i.path} title={`Open ${i.path} on the site`}>
                    {i.path}
                  </a>{" "}
                  <span class="meta">requested {day(i.requestedOn)}</span>
                </li>
              ))}
            </ul>
          </details>
        )
      }
      {
        g.indexing.reasons.length > 0 && (
          <>
            <h3 class="h3 mt-6 mb-2">Why pages aren't indexed</h3>
            <ul class="text-sm">
              {g.indexing.reasons.map(r => (
                <li>
                  <strong>{r.reason}</strong>: {r.urls.length}{" "}
                  {r.urls.length === 1 ? "page" : "pages"}
                </li>
              ))}
            </ul>
          </>
        )
      }
      <h3 class="h3 mt-6 mb-2">Bing</h3>
      <p class="meta mb-3">
        {fmt(bing.clicks)} clicks and {fmt(bing.impressions)} impressions{
          bing.from ? ` (${range(bing.from, bing.to)})` : ""
        }. {bing.notes} New and changed posts reach Bing through IndexNow on each
        deploy; unchanged pages are not re-sent.
      </p>
      <dl class="grid grid-cols-2 gap-3 md:grid-cols-4">
        <div class="tile">
          <dt>In Bing's index</dt>
          <dd class="num">{fmt(bing.indexed)}</dd>
          <dd class="meta">of {fmt(pages.size)} pages</dd>
        </div>
        <div class="tile">
          <dt>Crawled by Bing</dt>
          <dd class="num">{fmt(bing.crawl?.crawledPages)}</dd>
          <dd class="meta">
            {bing.crawl ? "on " + day(bing.crawl.date) : "no crawl data yet"}
          </dd>
        </div>
        <div class="tile">
          <dt>Crawl errors</dt>
          <dd class="num">{fmt(bing.crawl?.crawlErrors)}</dd>
          <dd class="meta">
            {
              bing.crawl
                ? "4xx " +
                  fmt(bing.crawl.code4xx) +
                  ", 5xx " +
                  fmt(bing.crawl.code5xx) +
                  ", timeouts " +
                  fmt(bing.crawl.timeouts)
                : "–"
            }
          </dd>
        </div>
        <div class="tile">
          <dt>Blocked by robots.txt</dt>
          <dd class="num">{fmt(bing.crawl?.blockedByRobots)}</dd>
          <dd class="meta">
            {bing.crawl ? fmt(bing.crawl.inLinks) + " links in" : "–"}
          </dd>
        </div>
      </dl>
      {
        bing.sitemaps && (
          <>
            <h4 class="mt-4 mb-1 font-semibold">Sitemaps Bing knows</h4>
            {bing.sitemaps.length ? (
              <ul class="text-sm">
                {bing.sitemaps.map(f => (
                  <li>
                    <strong>{f.url}</strong>{" "}
                    <span class="meta">
                      {[
                        f.status,
                        f.urlCount !== null ? fmt(f.urlCount) + " URLs" : "",
                        f.submitted ? "submitted " + day(f.submitted) : "",
                        f.lastCrawled ? "read " + day(f.lastCrawled) : "",
                      ]
                        .filter(Boolean)
                        .join(", ")}
                    </span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-sm">
                {bing.actions?.length
                  ? bing.actions.join(" ")
                  : "None yet. The next refresh submits the sitemap to Bing."}
              </p>
            )}
          </>
        )
      }
      {
        bing.issues && bing.issues.length > 0 && (
          <>
            <h4 class="mt-4 mb-1 font-semibold">Pages Bing had trouble with</h4>
            <ul class="text-sm">
              {bing.issues.map(i => (
                <li>
                  {i.url.replace(/^https?:\/\/(www\.)?urielpapa\.com/i, "") ||
                    "/"}{" "}
                  <span class="meta">
                    {i.issues}
                    {i.httpCode ? " (HTTP " + i.httpCode + ")" : ""}
                  </span>
                </li>
              ))}
            </ul>
          </>
        )
      }
      {
        bing.history && bing.history.length > 1 && (
          <p class="meta mt-4">
            Index trend:{" "}
            {bing.history
              .slice(-10)
