    flex: 1 1 18rem;
    margin: 0;
  }
  .refresh button {
    border: 1px solid var(--foreground);
    border-radius: 0.5rem;
    padding: 0.5rem 1rem;
    font-weight: 600;
    background: var(--foreground);
    color: var(--background);
    cursor: pointer;
  }
  .refresh button:disabled {
    background: transparent;
    color: var(--muted-foreground);
    border-color: var(--border);
    cursor: not-allowed;
  }
  .refresh-progress {
    --ok: #15803d;
    --warn: #b45309;
    --bad: #b91c1c;
    flex-basis: 100%;
    display: grid;
    gap: 0.375rem;
  }
  :global([data-theme="dark"]) .refresh-progress {
    --ok: #4ade80;
    --warn: #fbbf24;
    --bad: #f87171;
  }
  .refresh-progress[hidden] {
    display: none;
  }
  .refresh-bar {
    height: 0.5rem;
    border-radius: 999px;
    background: var(--muted);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .refresh-bar span {
    display: block;
    height: 100%;
    width: var(--pct, 0%);
    background: var(--foreground);
    transition: width 0.4s ease;
  }
  .refresh-progress[data-state="ok"] .refresh-bar span {
    background: var(--ok);
  }
  .refresh-progress[data-state="error"] .refresh-bar span {
    background: var(--bad);
  }
  .refresh-progress[data-state="warn"] .refresh-bar span {
    background: var(--warn);
  }
  .refresh-progress[data-state="warn"] [data-label] {
    color: var(--warn);
  }
  .refresh-progress[data-state="ok"] [data-label] {
    color: var(--ok);
  }
  .refresh-progress[data-state="error"] [data-label] {
    color: var(--bad);
  }
  .refresh-progress p {
    margin: 0;
  }
  .refresh-status [data-elapsed] {
    margin-left: 0.5rem;
  }
  .refresh-detail:empty {
    display: none;
  }
  .refresh .refresh-reload {
    justify-self: start;
  }
  .refresh-note {
    flex-basis: 100% !important;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
  }
  .tile {
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.875rem 1rem;
    min-width: 0;
  }
