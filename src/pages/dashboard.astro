<script>
  /*
   * Progress bar for "Refresh search data". Step 1 streams the server's
   * progress (Google sign-in, ~100 URL Inspections, Bing, saving to GitHub).
   * Step 2 waits for Vercel to finish the redeploy that the save starts, by
   * polling /deploy-version.json (a stamp written at every build, public and
   * not behind the password, so the poll needs no credentials) until it
   * changes. Without
   * JavaScript the form still posts and the page comes back with a note.
   */
  type Line =
    | { type: "step"; label: string; percent: number }
    | {
        type: "done";
        status: "ok" | "partial" | "error";
        note: string;
        commit?: string;
      };

  const form = document.querySelector<HTMLFormElement>("form.refresh");
  const box = form?.querySelector<HTMLElement>(".refresh-progress");
  if (form && box) {
    const button = form.querySelector<HTMLButtonElement>(
      "button[type=submit]"
    )!;
    const bar = box.querySelector<HTMLElement>(".refresh-bar")!;
    const label = box.querySelector<HTMLElement>("[data-label]")!;
    const elapsed = box.querySelector<HTMLElement>("[data-elapsed]")!;
    const detail = box.querySelector<HTMLElement>("[data-detail]")!;
    const reload = box.querySelector<HTMLButtonElement>("[data-reload]")!;
    /** The live build's stamp, or "" when it can't be read. */
    const buildStamp = async () => {
      try {
        const res = await fetch("/deploy-version.json", { cache: "no-store" });
        return res.ok
          ? (((await res.json()) as { build?: string }).build ?? "")
          : "";
      } catch {
        return "";
      }
    };
    let startDeploy = "";
    let timer = 0;

    const set = (pct: number, text: string, state = "running") => {
      const p = Math.max(0, Math.min(100, Math.round(pct)));
      bar.style.setProperty("--pct", `${p}%`);
      bar.setAttribute("aria-valuenow", String(p));
      label.textContent = text;
      box.dataset.state = state;
    };
    const clock = (from: number, suffix = "") => {
      window.clearInterval(timer);
      const tick = () => {
        const s = Math.round((Date.now() - from) / 1000);
        elapsed.textContent = `${s} s${suffix}`;
      };
      tick();
      timer = window.setInterval(tick, 1000);
      return () => Math.round((Date.now() - from) / 1000);
    };
    /** state: ok (green), warn (amber: saved, a source failed), error (red). */
    const finish = (
      state: "ok" | "warn" | "error",
      text: string,
      note = ""
    ) => {
      window.clearInterval(timer);
      elapsed.textContent = (elapsed.textContent ?? "").replace(/ \(.*\)$/, "");
      set(100, text, state);
      detail.textContent = note;
      button.disabled = false;
      button.textContent =
        state === "error" ? "Try again" : "Refresh search data";
    };

    reload.addEventListener("click", () => {
      window.location.assign("/dashboard#search");
    });

    /* Step 2: wait for the redeploy that the GitHub commit starts. */
    const waitForDeploy = async (note: string, partial: boolean) => {
      const seconds = clock(Date.now());
      detail.textContent = note;
      if (!startDeploy) {
        set(
          100,
          "Saved. The site is redeploying; reload in about 2 minutes.",
          partial ? "warn" : "ok"
        );
        reload.hidden = false;
        window.clearInterval(timer);
        return;
      }
      while (seconds() < 360) {
        const s = seconds();
        set(
          5 + Math.min(90, (s / 120) * 90),
          "Step 2 of 2: the site is redeploying with the new numbers (about 2 minutes)"
        );
        await new Promise(r => window.setTimeout(r, 10_000));
        try {
          const id = await buildStamp();
          if (id && id !== startDeploy) {
            finish(
              partial ? "warn" : "ok",
              partial
                ? "Done, but a source failed and kept its old numbers."
                : "Done. The new numbers are live.",
              note
            );
            reload.hidden = false;
            return;
          }
        } catch {
          /* A failed poll is retried on the next round. */
        }
      }
      finish(
        "warn",
        "Saved, but the redeploy is taking longer than 6 minutes.",
        "The numbers are saved on GitHub. Check the latest deployment in Vercel, then reload this page."
      );
      reload.hidden = false;
    };

    form.addEventListener("submit", async event => {
      event.preventDefault();
      form.querySelector(".refresh-note")?.remove();
      box.hidden = false;
      reload.hidden = true;
      detail.textContent = "";
      button.disabled = true;
      button.textContent = "Refreshing";
      set(2, "Step 1 of 2: starting");
      startDeploy = await buildStamp();
      const seconds = clock(Date.now(), " (usually 30 to 60 s)");

      // Until the server reports a step, creep along by time so the bar is
      // never frozen; real steps take over as soon as they arrive.
      let real = false;
      const creep = window.setInterval(() => {
        if (!real)
          set(
            Math.min(85, (seconds() / 60) * 85),
            "Step 1 of 2: reading Google, Bing and Clarity"
          );
      }, 1000);

      let result: Extract<Line, { type: "done" }> | undefined;
      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/x-ndjson" },
          cache: "no-store",
        });
        if (res.status === 401)
          throw new Error(
            "The dashboard password was not sent. Reload the page, sign in again and retry."
          );
        if (!res.ok || !res.body)
          throw new Error(
            `The server answered ${res.status} ${res.statusText}.`
          );
        const reader = res.body
          .pipeThrough(new TextDecoderStream())
          .getReader();
        let buffer = "";
        for (;;) {
          const { value, done } = await reader.read();
          if (value) buffer += value;
          const lines = buffer.split("\n");
          buffer = lines.pop() ?? "";
          for (const raw of lines) {
            if (!raw.trim()) continue;
            const line = JSON.parse(raw) as Line;
            if (line.type === "step") {
              real = true;
              set(line.percent, `Step 1 of 2: ${line.label}`);
            } else result = line;
          }
          if (done) break;
        }
      } catch (error) {
        window.clearInterval(creep);
        finish(
          "error",
          "Refresh failed.",
          error instanceof Error ? error.message : String(error)
        );
        return;
      }
      window.clearInterval(creep);
      if (!result)
        finish(
          "error",
          "Refresh stopped without an answer.",
          `It ran for ${seconds()} s. Vercel stops it at 60 s, so it probably ran out of time. Try again; if it keeps happening, tell Claude.`
        );
      else if (result.status === "error")
        finish("error", "Refresh failed.", result.note);
      else {
        button.textContent = "Saved";
        await waitForDeploy(result.note, result.status === "partial");
      }
    });
  }
</script>

