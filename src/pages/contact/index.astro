---
import { PUBLIC_TURNSTILE_SITE_KEY } from "astro:env/client";
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import {
  CONTACT,
  SITE,
  SOCIALS,
  WORK_QUESTIONS,
  SPEAKING_QUESTIONS,
  WORK_WITH_ME_OFFER,
} from "@/config";
import SocialIcon from "@/components/SocialIcon.astro";
import { abs, breadcrumbNode, PERSON_ID } from "@/utils/schema";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Contact", href: "/contact" },
];
const topics = [
  { value: "work", label: "Work together" },
  { value: "speaking", label: "Speaking or event" },
  { value: "question", label: "Question about a post" },
  { value: "other", label: "Something else" },
];
const steps = [
  {
    title: "Tell me about it",
    text: 'Pick "Work together" or "Speaking or event" and answer a few quick questions.',
  },
  {
    title: "Pick a time",
    text: "Choose a free 15-minute slot. The call goes straight into my calendar.",
  },
  {
    title: "Get the invite",
    text: "Google Calendar sends you the invite with the Meet link.",
  },
];
const schema = [
  {
    "@type": "ContactPage",
    "@id": `${abs("/contact")}#page`,
    url: abs("/contact"),
    name: `Contact ${SITE.name}`,
    mainEntity: { "@id": PERSON_ID },
  },
  breadcrumbNode(crumbs),
];
---

<Layout
  title="Contact"
  description="Contact Uriel Papa to work together, invite Uriel to speak at an event, or ask about something on the site. Every message is read and answered."
  schema={schema}
>
  <div class="contact app-layout page-top">
    <Breadcrumbs crumbs={crumbs} />

    <div class="contact-grid">
      <aside class="contact-aside">
        <div class="contact-intro">
          <h1 class="h1">Contact</h1>
          <p class="mt-4 text-lg">
            I read every message. Write if you'd like to work together, invite
            me to speak, or ask about something I wrote.
          </p>
          <p class="text-muted-foreground mt-3">{CONTACT.kindOfWork}</p>

          <section class="contact-offer" aria-labelledby="c-offer-h">
            <h2 id="c-offer-h" class="contact-offer__title">
              {WORK_WITH_ME_OFFER}
            </h2>
            <ol class="steps">
              {
                steps.map(s => (
                  <li>
                    <p class="font-semibold">{s.title}</p>
                    <p class="meta mt-0.5">{s.text}</p>
                  </li>
                ))
              }
            </ol>
          </section>
        </div>

        <div class="contact-alt">
          <p>
            Prefer email? Write to <a
              href={`mailto:${SITE.email}`}
              title="Email Uriel Papa">{SITE.email}</a
            >
          </p>
          <ul class="contact-socials" aria-label="Uriel Papa elsewhere">
            {
              SOCIALS.map(s => (
                <li>
                  <a
                    href={s.url}
                    rel="me noopener"
                    class="inline-flex items-center gap-1.5"
                    title={`Uriel Papa on ${s.label}`}
                  >
                    <SocialIcon name={s.name} />
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>

      <form
        id="contact-form"
        method="post"
        action="/api/contact"
        class="contact-form"
        novalidate
      >
        <fieldset class="form-section" aria-describedby="c-topic-err">
          <legend class="section-title">What's this about?</legend>
          <div class="choice-grid">
            {
              topics.map((t, i) => (
                <label class="choice">
                  <input
                    type="radio"
                    name="topic"
                    value={t.value}
                    required
                    checked={i === 0}
                  />
                  {t.label}
                </label>
              ))
            }
          </div>
          <p id="c-topic-err" class="field-error" data-error-for="topic"></p>
        </fieldset>

        <fieldset class="form-section">
          <legend class="section-title">About you</legend>
          <div class="field-grid">
            <div>
              <label for="c-name" class="field-label">Name</label>
              <input
                id="c-name"
                name="name"
                type="text"
                required
                maxlength="120"
                autocomplete="name"
                class="field"
                aria-describedby="c-name-err"
              />
              <p id="c-name-err" class="field-error" data-error-for="name"></p>
            </div>
            <div>
              <label for="c-email" class="field-label">Email</label>
              <input
                id="c-email"
                name="email"
                type="email"
                required
                maxlength="200"
                autocomplete="email"
                inputmode="email"
                spellcheck="false"
                class="field"
                aria-describedby="c-email-err"
              />
              <p id="c-email-err" class="field-error" data-error-for="email">
              </p>
            </div>
          </div>
        </fieldset>

        {
          /* Business questions, only when "Work together" is picked (CSS :has),
           and only the set for the kind of sender picked. */
        }
        <fieldset class="form-section work-only" aria-describedby="c-work-note">
          <legend class="section-title">A few quick questions</legend>
          <p id="c-work-note" class="section-note">
            All optional. They help me come to the call prepared.
          </p>

          <fieldset class="mt-5">
            <legend class="field-label">Who's writing?</legend>
            <div class="choice-grid">
              {
                (["client", "employer"] as const).map((k, i) => (
                  <label class="choice">
                    <input
                      type="radio"
                      name="workKind"
                      value={k}
                      checked={i === 0}
                    />
                    {WORK_QUESTIONS[k].label}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="client-fields field-grid mt-5">
            <div>
              <label for="c-company" class="field-label">Business name</label>
              <input
                id="c-company"
                name="company"
                type="text"
                maxlength="160"
                autocomplete="organization"
                class="field"
              />
            </div>
            <div>
              <label for="c-site" class="field-label">Website</label>
              <input
                id="c-site"
                name="site"
                type="url"
                maxlength="300"
                placeholder="https://"
                class="field"
              />
            </div>
            <div>
              <label for="c-industry" class="field-label">Industry</label>
              <input
                id="c-industry"
                name="industry"
                type="text"
                maxlength="120"
                placeholder="e.g. clinic, restaurant, law firm"
                class="field"
              />
            </div>
            <div>
              <label for="c-need" class="field-label">What do you need?</label>
              <select id="c-need" name="need" class="field">
                {WORK_QUESTIONS.client.needs.map(o => <option>{o}</option>)}
              </select>
            </div>
            <div>
              <label for="c-budget" class="field-label">Budget</label>
              <select id="c-budget" name="budget" class="field">
                {WORK_QUESTIONS.client.budgets.map(o => <option>{o}</option>)}
              </select>
            </div>
            <div>
              <label for="c-timeline" class="field-label"
                >When do you need it?</label
              >
              <select id="c-timeline" name="timeline" class="field">
                {WORK_QUESTIONS.client.timelines.map(o => <option>{o}</option>)}
              </select>
            </div>
          </div>

          <div class="employer-fields field-grid mt-5">
            <div>
              <label for="c-employer" class="field-label">Company</label>
              <input
                id="c-employer"
                name="employer"
                type="text"
                maxlength="160"
                autocomplete="organization"
                class="field"
              />
            </div>
            <div>
              <label for="c-role" class="field-label">Role title</label>
              <input
                id="c-role"
                name="role"
                type="text"
                maxlength="160"
                placeholder="e.g. AI automation engineer"
                class="field"
              />
            </div>
            <div>
              <label for="c-type" class="field-label">Employment type</label>
              <select id="c-type" name="employmentType" class="field">
                {WORK_QUESTIONS.employer.types.map(o => <option>{o}</option>)}
              </select>
            </div>
            <div>
              <label for="c-setup" class="field-label">Work setup</label>
              <select id="c-setup" name="workSetup" class="field">
                {WORK_QUESTIONS.employer.setups.map(o => <option>{o}</option>)}
              </select>
            </div>
            <div>
              <label for="c-salary" class="field-label">Salary range</label>
              <input
                id="c-salary"
                name="salary"
                type="text"
                maxlength="120"
                placeholder="e.g. ₱80k to ₱120k a month"
                class="field"
              />
            </div>
            <div>
              <label for="c-post" class="field-label">Job post link</label>
              <input
                id="c-post"
                name="jobPost"
                type="url"
                maxlength="300"
                placeholder="https://"
                class="field"
              />
            </div>
          </div>
        </fieldset>

        <fieldset
          class="form-section speaking-only"
          aria-describedby="c-event-note"
        >
          <legend class="section-title">About the event</legend>
          <p id="c-event-note" class="section-note">
            All optional. Share what you know so far.
          </p>
          <div class="field-grid mt-5">
            <div>
              <label for="c-event" class="field-label">Event name</label>
              <input
                id="c-event"
                name="eventName"
                type="text"
                maxlength="160"
                class="field"
              />
            </div>
            <div>
              <label for="c-event-date" class="field-label">Event date</label>
              <input
                id="c-event-date"
                name="eventDate"
                type="date"
                class="field"
                data-event-date
              />
            </div>
            <div>
              <label for="c-event-format" class="field-label">Format</label>
              <select id="c-event-format" name="eventFormat" class="field">
                {SPEAKING_QUESTIONS.formats.map(o => <option>{o}</option>)}
              </select>
            </div>
            <div>
              <label for="c-event-place" class="field-label">Location</label>
              <input
                id="c-event-place"
                name="eventLocation"
                type="text"
                maxlength="160"
                placeholder="City and venue, or the platform"
                class="field"
              />
            </div>
          </div>
        </fieldset>

        {
          /* "Question about a post": search every post and news take by title
           (list from /contact/posts.json). Without JavaScript the box is a
           plain text field, sent as typed. */
        }
        <div class="form-section question-only" data-post-search>
          <label for="c-post-search" class="section-title block"
            >Which post?</label
          >
          <p class="section-note" id="c-post-note">
            Search by title, or leave it blank.
          </p>
          <div class="post-search" data-post-box>
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              class="icon post-search__icon"
              ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"
              ></path></svg
            >
            <input
              id="c-post-search"
              name="post"
              type="text"
              maxlength="300"
              autocomplete="off"
              spellcheck="false"
              placeholder="Search posts and news"
              class="field post-search__input"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="c-post-list"
              aria-describedby="c-post-note"
            />
            <ul
              id="c-post-list"
              class="post-list"
              role="listbox"
              aria-label="Matching posts"
              hidden
            >
            </ul>
          </div>
          <p class="meta mt-2" aria-live="polite" data-post-empty></p>
          <input type="hidden" name="postUrl" />
          <div class="post-picked" data-post-picked hidden>
            <div class="min-w-0 flex-1">
              <p class="meta" data-post-picked-kind></p>
              <a
                class="font-semibold"
                href="/blog"
                title="Open the post in a new tab"
                target="_blank"
                rel="noopener"
                data-post-picked-link></a>
            </div>
            <button type="button" class="text-btn" data-post-change
              >Change</button
            >
          </div>
        </div>

        <div class="form-section">
          <label for="c-message" class="section-title block">Your message</label
          >
          <textarea
            id="c-message"
            name="message"
            rows="6"
            required
            minlength="10"
            maxlength="5000"
            placeholder="What's the problem, and what have you tried so far?"
            data-placeholder-work="What's the problem, and what have you tried so far?"
            data-placeholder-speaking="Tell me about the event, the audience and what you'd like me to talk about."
            data-placeholder-question="What would you like to ask or talk about?"
            data-placeholder-other="What's on your mind?"
            class="field"
            aria-describedby="c-message-err"></textarea>
          <p id="c-message-err" class="field-error" data-error-for="message">
          </p>
        </div>

        {
          /* The free discovery call. Free slots from Uriel's Google Calendar are
           filled in by the script below from /api/slots; the slot radios stay
           inside this form, so the picked time is sent with it. Without slots
           (or without JavaScript) it asks for good call times instead. */
        }
        <fieldset
          class="form-section call-only booking"
          data-booking
          data-state="off"
          aria-describedby="c-slot-note c-slot-err"
        >
          <legend class="section-title">Your free 15-minute call</legend>
          <p id="c-slot-note" class="section-note booking-meta">
            <span class="inline-flex items-center gap-1.5"
              ><svg aria-hidden="true" viewBox="0 0 24 24" class="icon"
                ><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"
                ></path></svg
              >15 min</span
            >
            <span class="inline-flex items-center gap-1.5"
              ><svg aria-hidden="true" viewBox="0 0 24 24" class="icon"
                ><rect x="3" y="6" width="12" height="12" rx="2"></rect><path
                  d="m15 10 6-3v10l-6-3"></path></svg
              >Google Meet</span
            >
            <span>Optional</span>
          </p>

          <div class="picker" data-picker>
            {
              /* The form shows one calm line: a button to choose a time, or
               the chosen time with Change and Remove. The calendar opens in
               a dialog; it stays inside the form, so the picked radio is
               sent with it. */
            }
            <button
              type="button"
              class="slot-open"
              aria-haspopup="dialog"
              data-slot-open
              disabled
            >
              <span class="slot-open__icon" aria-hidden="true"
                ><svg viewBox="0 0 24 24" class="icon"
                  ><rect x="3" y="5" width="18" height="16" rx="2"></rect><path
                    d="M16 3v4M8 3v4M3 10h18"></path></svg
                ></span
              >
              <span class="slot-open__text">
                <span class="slot-open__title">Choose a day and time</span>
                <span class="slot-open__sub" data-slot-next-free
                  >Checking my calendar…</span
                >
              </span>
              <svg aria-hidden="true" viewBox="0 0 24 24" class="icon"
                ><path d="m9 6 6 6-6 6"></path></svg
              >
            </button>

            <div class="picked" data-slot-picked hidden>
              <span class="slot-open__icon" aria-hidden="true"
                ><svg viewBox="0 0 24 24" class="icon"
                  ><path d="m5 12 5 5 9-10"></path></svg
                ></span
              >
              <p class="picked__text">
                <span class="picked__label">Your call</span>
                <span data-slot-picked-text></span>
              </p>
              <div class="picked__actions">
                <button type="button" class="text-btn" data-slot-change
                  >Change</button
                >
                <button type="button" class="text-btn" data-slot-clear
                  >Remove</button
                >
              </div>
            </div>

            <dialog
              class="slot-dialog"
              aria-labelledby="c-slot-title"
              aria-describedby="c-slot-tz"
              data-slot-dialog
            >
              <div class="slot-dialog__head">
                <div>
                  <h2 id="c-slot-title" class="slot-dialog__title">
                    Pick a time for your call
                  </h2>
                  <p class="slot-dialog__meta">
                    15 min · Google Meet · <span id="c-slot-tz" data-slot-tz
                    ></span>
                  </p>
                </div>
                <button
                  type="button"
                  class="icon-btn"
                  aria-label="Close without choosing"
                  data-slot-cancel
                  ><svg aria-hidden="true" viewBox="0 0 24 24" class="icon"
                    ><path d="M6 6l12 12M18 6 6 18"></path></svg
                  ></button
                >
              </div>

              <div class="slot-dialog__body">
                <div class="cal">
                  <div class="cal__head">
                    <p class="cal__month" aria-live="polite" data-cal-month></p>
                    <div class="flex gap-1.5">
                      <button
                        type="button"
                        class="icon-btn"
                        aria-label="Previous month"
                        data-cal-prev
                        ><svg
                          aria-hidden="true"
                          viewBox="0 0 24 24"
                          class="icon"><path d="m15 6-6 6 6 6"></path></svg
                        ></button
                      >
                      <button
                        type="button"
                        class="icon-btn"
                        aria-label="Next month"
                        data-cal-next
                        ><svg
                          aria-hidden="true"
                          viewBox="0 0 24 24"
                          class="icon"><path d="m9 6 6 6-6 6"></path></svg
                        ></button
                      >
                    </div>
                  </div>
                  <div class="cal__dows" aria-hidden="true" data-cal-dows></div>
                  <div
                    class="cal__grid"
                    role="group"
                    aria-label="Days with free times"
                    data-cal-grid
                  >
                  </div>
                </div>

                <div class="times" data-times>
                  <p class="times__day" data-times-day></p>
                  <div
                    class="slot-times"
                    role="group"
                    aria-labelledby="c-slot-title"
                    data-slot-times
                  >
                  </div>
                </div>
              </div>

              <div class="slot-dialog__foot">
                <p
                  class="slot-dialog__choice"
                  aria-live="polite"
                  data-slot-choice
                >
                  Choose a day, then a time.
                </p>
                <div class="slot-dialog__buttons">
                  <button type="button" class="text-btn" data-slot-cancel
                    >Cancel</button
                  >
                  <button
                    type="button"
                    class="btn btn-filled btn-primary slot-confirm"
                    disabled
                    data-slot-confirm>Use this time</button
                  >
                </div>
              </div>
            </dialog>
          </div>

          <div class="call-times" data-call-times>
            <label for="c-call" class="field-label">Good times for a call</label
            >
            <input
              id="c-call"
              name="callTimes"
              type="text"
              maxlength="300"
              placeholder="e.g. weekdays after 2 PM, Philippine time"
              class="field"
            />
          </div>
          <p id="c-slot-err" class="field-error" data-error-for="slot"></p>
        </fieldset>

        <!-- Honeypot: hidden from people, often filled by bots -->
        <div class="hidden" aria-hidden="true">
          <label for="c-website">Leave this empty</label>
          <input
            id="c-website"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <div class="form-footer">
          {
            PUBLIC_TURNSTILE_SITE_KEY && (
              <div
                class="cf-turnstile mb-5"
                data-sitekey={PUBLIC_TURNSTILE_SITE_KEY}
                data-theme="auto"
              />
            )
          }
          <button type="submit" class="btn btn-filled btn-primary submit-btn"
            >Send message</button
          >
          <p
            class="form-status"
            role="alert"
            aria-live="assertive"
            id="form-status"
          >
          </p>
          <p class="meta mt-4">
            {CONTACT.replyTime} Your name, email, message and answers are sent to
            my inbox and used only to reply to you. Nothing is added to a mailing
            list. By sending this you agree to the <a
              href="/privacy"
              title="How urielpapa.com handles what you send">privacy policy</a
            >.
          </p>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  import { track } from "@/scripts/events";
  import { loadTurnstileOnInteraction } from "@/scripts/turnstile";

  loadTurnstileOnInteraction();

  const form = document.querySelector<HTMLFormElement>("#contact-form")!;
  const status = document.querySelector<HTMLElement>("#form-status")!;
  const submit = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
  const topic = () =>
    form.querySelector<HTMLInputElement>("input[name=topic]:checked")?.value ??
    "";
  // "Work together" and "Speaking or event" can book the free call.
  const isWork = () => topic() === "work" || topic() === "speaking";
  const pickedSlot = () =>
    form.querySelector<HTMLInputElement>("input[name=slot]:checked");

  // The button says what will happen: a plain message, or a message plus a
  // booked call. The message prompt fits the topic.
  const message = form.querySelector<HTMLTextAreaElement>("[name=message]")!;
  function updateSubmit() {
    message.placeholder =
      message.dataset[
        `placeholder${topic().replace(/^./, c => c.toUpperCase())}`
      ] ?? message.dataset.placeholderOther!;
    if (submit.disabled) return;
    submit.textContent =
      isWork() && pickedSlot() ? "Send and book my call" : "Send message";
  }

  // An event can't be in the past.
  const eventDate = form.querySelector<HTMLInputElement>("[data-event-date]")!;
  const today = new Date();
  eventDate.min = new Date(today.getTime() - today.getTimezoneOffset() * 60_000)
    .toISOString()
    .slice(0, 10);

  // #work (from every "Work with me" link) or #speaking preselects the topic. A fragment
  // keeps one crawlable URL for this page; ?topic= still works for links shared before.
  function preselectTopic() {
    const topic =
      location.hash.slice(1) ||
      new URLSearchParams(location.search).get("topic");
    if (!topic) return;
    const radio = form.querySelector<HTMLInputElement>(
      `input[name=topic][value="${CSS.escape(topic)}"]`
    );
    if (radio) radio.checked = true;
    loadSlots();
    updateSubmit();
  }
  // The footer's "Work with me" link only changes the hash when you're already here.
  window.addEventListener("hashchange", preselectTopic);

  // The three required fields, checked when you leave them (only once
  // something is typed) and cleared as soon as they're right.
  const rules: Record<string, (el: HTMLInputElement) => string> = {
    name: el => (el.value.trim() ? "" : "Please enter your name."),
    email: el =>
      el.value.trim() && el.checkValidity()
        ? ""
        : "Please enter a valid email address.",
    message: el =>
      el.value.trim().length >= 10
        ? ""
        : "Please write a little more (at least 10 characters).",
  };
  function setError(name: string, text: string) {
    const out = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
    if (out) out.textContent = text;
    if (name !== "slot")
      form
        .querySelector(`[name="${name}"]`)
        ?.setAttribute("aria-invalid", text ? "true" : "false");
  }
  for (const [name, rule] of Object.entries(rules)) {
    const el = form.querySelector<HTMLInputElement>(`[name="${name}"]`)!;
    el.addEventListener("blur", () => {
      if (el.value.trim()) setError(name, rule(el));
    });
    el.addEventListener("input", () => {
      if (el.getAttribute("aria-invalid") === "true" && !rule(el))
        setError(name, "");
    });
  }

  function showErrors(errors: Record<string, string>) {
    for (const el of form.querySelectorAll<HTMLElement>("[data-error-for]"))
      setError(el.dataset.errorFor!, errors[el.dataset.errorFor!] ?? "");
    // A time that was just taken leaves the picker, so it can't be sent again.
    if (errors.slot) {
      pickedSlot()?.closest("label")?.remove();
      afterSlotChange();
    }
    const first = Object.keys(errors)[0];
    if (!first) return;
    const target =
      first === "slot"
        ? form.querySelector<HTMLElement>("[data-slot-open]")
        : form.querySelector<HTMLElement>(`[name="${first}"]`);
    target?.focus();
  }

  form.addEventListener("submit", async e => {
    e.preventDefault();
    const errors: Record<string, string> = {};
    for (const [name, rule] of Object.entries(rules)) {
      const text = rule(
        form.querySelector<HTMLInputElement>(`[name="${name}"]`)!
      );
      if (text) errors[name] = text;
    }
    showErrors(errors);
    if (Object.keys(errors).length) {
      status.textContent = "Please fix the highlighted fields.";
      return;
    }

    const data = new FormData(form);
    const label = submit.textContent;
    submit.disabled = true;
    submit.setAttribute("aria-busy", "true");
    submit.textContent = pickedSlot() && isWork() ? "Booking…" : "Sending…";
    status.textContent = "";
    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: data,
        headers: { Accept: "application/json" },
      });
      const body = (await res.json().catch(() => ({}))) as {
        message?: string;
        errors?: Record<string, string>;
        redirect?: string;
      };
      if (!res.ok) {
        if (body.errors) showErrors(body.errors);
        throw new Error(
          body.message ??
            "Your message couldn't be sent. Please try again or email me directly."
        );
      }
      track("contact_submit", { topic: String(data.get("topic") ?? "") });
      location.href =
        body.redirect ??
        `/contact/thanks?topic=${encodeURIComponent(String(data.get("topic") ?? ""))}`;
    } catch (err) {
      status.textContent =
        err instanceof Error ? err.message : "Something went wrong.";
      submit.disabled = false;
      submit.removeAttribute("aria-busy");
      submit.textContent = label;
      updateSubmit();
      // Turnstile tokens are single-use, so get a fresh one for the next try.
      const widget = form.querySelector(".cf-turnstile");
      const turnstile = (
        window as unknown as { turnstile?: { reset: (el?: Element) => void } }
      ).turnstile;
      if (widget) turnstile?.reset(widget);
    }
  });

  // Discovery-call slots: loaded once, the first time "Work together" or
  // "Speaking or event" is picked. The form shows one line; the calendar and
  // times open in a dialog. Picking there is a draft: "Use this time" keeps
  // it, Cancel, Escape or the close button put back what was there before.
  // Times show in the visitor's own time zone.
  const booking = form.querySelector<HTMLElement>("[data-booking]")!;
  const q = <T extends HTMLElement = HTMLElement>(sel: string) =>
    booking.querySelector<T>(sel)!;
  const dialog = q<HTMLDialogElement>("[data-slot-dialog]");
  const openBtn = q<HTMLButtonElement>("[data-slot-open]");
  const nextFree = q("[data-slot-next-free]");
  const picked = q("[data-slot-picked]");
  const pickedText = q("[data-slot-picked-text]");
  const grid = q("[data-cal-grid]");
  const monthLabel = q("[data-cal-month]");
  const prevMonth = q<HTMLButtonElement>("[data-cal-prev]");
  const nextMonth = q<HTMLButtonElement>("[data-cal-next]");
  const times = q("[data-slot-times]");
  const timesDay = q("[data-times-day]");
  const choice = q("[data-slot-choice]");
  const confirmBtn = q<HTMLButtonElement>("[data-slot-confirm]");
  let describe: (iso: string) => string = () => "";
  let showDay: (key: string) => void = () => {};
  let showMonth: (index: number) => void = () => {};
  let dayOf: (iso: string) => string = () => "";
  let before: string | null = null;

  function afterSlotChange() {
    const slot = pickedSlot();
    picked.hidden = !slot;
    openBtn.hidden = !!slot;
    if (slot) pickedText.textContent = describe(slot.value);
    setError("slot", "");
    updateSubmit();
  }
  function draftChanged() {
    const slot = pickedSlot();
    choice.textContent = slot
      ? describe(slot.value)
      : "Choose a day, then a time.";
    confirmBtn.disabled = !slot;
  }
  function openDialog() {
    before = pickedSlot()?.value ?? null;
    if (before) showDay(dayOf(before));
    draftChanged();
    dialog.showModal();
    // Focus lands on the chosen day, or the first day with free times.
    (
      grid.querySelector<HTMLElement>("[aria-pressed=true]") ??
      grid.querySelector<HTMLElement>("button:not(:disabled)")
    )?.focus();
  }
  function restore() {
    for (const r of form.querySelectorAll<HTMLInputElement>("input[name=slot]"))
      r.checked = r.value === before;
  }
  function closeDialog(keep: boolean) {
    if (!keep) restore();
    dialog.close();
    afterSlotChange();
    (pickedSlot() ? q("[data-slot-change]") : openBtn).focus();
  }
  // Escape closes like Cancel.
  dialog.addEventListener("cancel", e => {
    e.preventDefault();
    closeDialog(false);
  });
  // A click on the dimmed backdrop (the dialog element itself) closes too.
  dialog.addEventListener("click", e => {
    if (e.target === dialog) closeDialog(false);
  });
  for (const b of booking.querySelectorAll("[data-slot-cancel]"))
    b.addEventListener("click", () => closeDialog(false));
  confirmBtn.addEventListener("click", () => closeDialog(true));
  openBtn.addEventListener("click", openDialog);
  q("[data-slot-change]").addEventListener("click", openDialog);
  q("[data-slot-clear]").addEventListener("click", () => {
    const slot = pickedSlot();
    if (slot) slot.checked = false;
    afterSlotChange();
    openBtn.focus();
  });

  let slotsAsked = false;
  async function loadSlots() {
    if (slotsAsked || !isWork()) return;
    slotsAsked = true;
    booking.dataset.state = "loading";
    const data = (await fetch("/api/slots")
      .then(r => r.json())
      .catch(() => null)) as {
      enabled?: boolean;
      minutes?: number;
      slots?: string[];
    } | null;
    if (!data?.enabled || !data.slots?.length) {
      booking.dataset.state = "off";
      return;
    }

    const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    const fmt = (o: Intl.DateTimeFormatOptions) =>
      new Intl.DateTimeFormat(undefined, o);
    const keyFmt = fmt({ year: "numeric", month: "2-digit", day: "2-digit" });
    const partsOf = (d: Date) => {
      const p = Object.fromEntries(
        new Intl.DateTimeFormat("en-CA", {
          year: "numeric",
          month: "numeric",
          day: "numeric",
        })
          .formatToParts(d)
          .map(x => [x.type, Number(x.value)])
      );
      return { y: p.year!, m: p.month! - 1, d: p.day! };
    };
    const longDay = fmt({ weekday: "long", month: "long", day: "numeric" });
    const shortDay = fmt({ weekday: "short", month: "short", day: "numeric" });
    const timeFmt = fmt({ hour: "numeric", minute: "2-digit" });
    const hourFmt = fmt({ hour: "numeric", hourCycle: "h23" });
    const monthFmt = new Intl.DateTimeFormat(undefined, {
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    });
    const dowFmt = new Intl.DateTimeFormat(undefined, {
      weekday: "narrow",
      timeZone: "UTC",
    });
    const minutes = data.minutes ?? 15;
    describe = iso => {
      const at = new Date(iso);
      const end = new Date(at.getTime() + minutes * 60_000);
      return `${longDay.format(at)}, ${timeFmt.format(at)} to ${timeFmt.format(end)}`;
    };
    dayOf = iso => keyFmt.format(new Date(iso));

    // Slots grouped by the visitor's local day.
    const byDay = new Map<string, Date[]>();
    const dayParts = new Map<string, { y: number; m: number; d: number }>();
    for (const iso of data.slots) {
      const at = new Date(iso);
      const key = keyFmt.format(at);
      byDay.set(key, [...(byDay.get(key) ?? []), at]);
      if (!dayParts.has(key)) dayParts.set(key, partsOf(at));
    }
    const keyFor = new Map<string, string>(); // "y-m-d" -> day key
    for (const [key, p] of dayParts) keyFor.set(`${p.y}-${p.m}-${p.d}`, key);
    const months = [
      ...new Set([...dayParts.values()].map(p => p.y * 12 + p.m)),
    ].sort((a, b) => a - b);

    // One panel of time chips per day, morning and afternoon; only the
    // chosen day's panel shows.
    times.replaceChildren();
    for (const [key, list] of byDay) {
      const panel = document.createElement("div");
      panel.dataset.day = key;
      panel.className = "time-panel";
      panel.hidden = true;
      const groups: [string, Date[]][] = [
        ["Morning", list.filter(d => Number(hourFmt.format(d)) < 12)],
        ["Afternoon", list.filter(d => Number(hourFmt.format(d)) >= 12)],
      ];
      for (const [name, group] of groups) {
        if (!group.length) continue;
        const heading = document.createElement("p");
        heading.className = "time-group";
        heading.textContent = name;
        const chips = document.createElement("div");
        chips.className = "time-grid";
        for (const at of group) {
          const label = document.createElement("label");
          label.className = "time-chip";
          const input = document.createElement("input");
          input.type = "radio";
          input.name = "slot";
          input.value = at.toISOString();
          input.className = "sr-only";
          input.addEventListener("change", draftChanged);
          label.append(input, timeFmt.format(at));
          chips.append(label);
        }
        panel.append(heading, chips);
      }
      times.append(panel);
    }

    // Weekday initials, Sunday first.
    const dows = q("[data-cal-dows]");
    dows.replaceChildren(
      ...Array.from({ length: 7 }, (_, i) => {
        const s = document.createElement("span");
        s.textContent = dowFmt.format(Date.UTC(2023, 0, 1 + i));
        return s;
      })
    );

    let current = 0;
    let chosenDay = "";
    showMonth = index => {
      current = Math.max(0, Math.min(months.length - 1, index));
      const y = Math.floor(months[current] / 12);
      const m = months[current] % 12;
      monthLabel.textContent = monthFmt.format(Date.UTC(y, m, 1));
      prevMonth.disabled = current === 0;
      nextMonth.disabled = current === months.length - 1;
      const lead = new Date(Date.UTC(y, m, 1)).getUTCDay();
      const count = new Date(Date.UTC(y, m + 1, 0)).getUTCDate();
      const cells: HTMLElement[] = [];
      for (let i = 0; i < lead; i++) {
        const pad = document.createElement("span");
        pad.setAttribute("aria-hidden", "true");
        cells.push(pad);
      }
      for (let d = 1; d <= count; d++) {
        const key = keyFor.get(`${y}-${m}-${d}`);
        const b = document.createElement("button");
        b.type = "button";
        b.className = "cal__day";
        b.textContent = String(d);
        if (key) {
          const list = byDay.get(key)!;
          b.dataset.day = key;
          b.setAttribute("aria-pressed", String(key === chosenDay));
          b.setAttribute(
            "aria-label",
            `${longDay.format(list[0])}, ${list.length} ${list.length === 1 ? "time" : "times"} free`
          );
          b.addEventListener("click", () => {
            showDay(key);
            // On a narrow sheet the times sit below the calendar.
            if (matchMedia("(max-width: 47.99rem)").matches)
              q("[data-times]").scrollIntoView({
                block: "nearest",
                behavior: "smooth",
              });
          });
        } else {
          b.disabled = true;
          b.setAttribute(
            "aria-label",
            `${fmt({ month: "long", day: "numeric", timeZone: "UTC" }).format(Date.UTC(y, m, d))}, no free times`
          );
        }
        cells.push(b);
      }
      grid.replaceChildren(...cells);
    };
    showDay = key => {
      if (!byDay.has(key)) return;
      chosenDay = key;
      const p = dayParts.get(key)!;
      const idx = months.indexOf(p.y * 12 + p.m);
      if (idx !== current || !grid.querySelector(`[data-day="${key}"]`))
        showMonth(idx);
      for (const b of grid.querySelectorAll<HTMLElement>("[data-day]"))
        b.setAttribute("aria-pressed", String(b.dataset.day === key));
      for (const panel of times.querySelectorAll<HTMLElement>(".time-panel"))
        panel.hidden = panel.dataset.day !== key;
      timesDay.textContent = longDay.format(byDay.get(key)![0]);
    };
    prevMonth.addEventListener("click", () => showMonth(current - 1));
    nextMonth.addEventListener("click", () => showMonth(current + 1));

    // Arrow keys move between days that have free times; Home and End jump
    // to the first and last of the month.
    grid.addEventListener("keydown", e => {
      const all = [
        ...grid.querySelectorAll<HTMLButtonElement>("button:not(:disabled)"),
      ];
      const at = all.indexOf(document.activeElement as HTMLButtonElement);
      if (at < 0) return;
      const step: Record<string, number> = {
        ArrowRight: 1,
        ArrowLeft: -1,
        ArrowDown: 1,
        ArrowUp: -1,
      };
      const to =
        e.key in step
          ? at + step[e.key]
          : e.key === "Home"
            ? 0
            : e.key === "End"
              ? all.length - 1
              : null;
      if (to === null) return;
      e.preventDefault();
      all[Math.max(0, Math.min(all.length - 1, to))]?.focus();
    });

    q("[data-slot-tz]").textContent = `your time (${zone.replace(/_/g, " ")})`;
    const firstKey = byDay.keys().next().value!;
    const firstAt = byDay.get(firstKey)![0];
    nextFree.textContent = `Next free: ${shortDay.format(firstAt)} at ${timeFmt.format(firstAt)}. It's booked when you send this form.`;
    showMonth(0);
    showDay(firstKey);
    openBtn.disabled = false;
    booking.dataset.state = "ready";
  }

  // "Which post?": a search box over every post and news take. The list is
  // fetched once, the first time the box is used.
  type Entry = { title: string; url: string; kind: string; date: string };
  const postSection = form.querySelector<HTMLElement>("[data-post-search]")!;
  const postBox = postSection.querySelector<HTMLElement>("[data-post-box]")!;
  const postInput =
    postSection.querySelector<HTMLInputElement>("#c-post-search")!;
  const postList = postSection.querySelector<HTMLUListElement>("#c-post-list")!;
  const postEmpty =
    postSection.querySelector<HTMLElement>("[data-post-empty]")!;
  const postUrlInput = form.querySelector<HTMLInputElement>("[name=postUrl]")!;
  const postPicked =
    postSection.querySelector<HTMLElement>("[data-post-picked]")!;
  const postLink = postSection.querySelector<HTMLAnchorElement>(
    "[data-post-picked-link]"
  )!;
  const dateFmt = new Intl.DateTimeFormat(undefined, {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
  let entries: Entry[] | null = null;
  let matches: Entry[] = [];
  let active = -1;
  const loadEntries = async () => {
    entries ??= await fetch("/contact/posts.json")
      .then(r => r.json() as Promise<Entry[]>)
      .catch(() => []);
    return entries;
  };
  const meta = (e: Entry) =>
    `${e.kind} · ${dateFmt.format(new Date(`${e.date}T12:00:00`))}`;

  function closeList() {
    postList.hidden = true;
    postInput.setAttribute("aria-expanded", "false");
    postInput.removeAttribute("aria-activedescendant");
    active = -1;
  }
  function setActive(i: number) {
    active = i;
    const items = [...postList.children] as HTMLElement[];
    items.forEach((li, n) => li.setAttribute("aria-selected", String(n === i)));
    if (items[i]) {
      postInput.setAttribute("aria-activedescendant", items[i].id);
      items[i].scrollIntoView({ block: "nearest" });
    } else postInput.removeAttribute("aria-activedescendant");
  }
  async function search() {
    const all = await loadEntries();
    const words = postInput.value.toLowerCase().split(/\s+/).filter(Boolean);
    matches = (
      words.length
        ? all.filter(e => words.every(w => e.title.toLowerCase().includes(w)))
        : all
    ).slice(0, 8);
    postList.replaceChildren(
      ...matches.map((e, i) => {
        const li = document.createElement("li");
        li.id = `c-post-opt-${i}`;
        li.role = "option";
        li.className = "post-option";
        li.setAttribute("aria-selected", "false");
        const t = document.createElement("span");
        t.className = "post-option__title";
        t.textContent = e.title;
        const m = document.createElement("span");
        m.className = "post-option__meta";
        m.textContent = meta(e);
        li.append(t, m);
        // mousedown, so the box doesn't lose focus and close first.
        li.addEventListener("mousedown", ev => {
          ev.preventDefault();
          pick(e);
        });
        return li;
      })
    );
    postEmpty.textContent =
      words.length && !matches.length
        ? "No post matches that. Tell me which one in your message."
        : "";
    postList.hidden = !matches.length;
    postInput.setAttribute("aria-expanded", String(!postList.hidden));
    setActive(-1);
  }
  function pick(e: Entry) {
    postInput.value = e.title;
    postUrlInput.value = e.url;
    postLink.textContent = e.title;
    postLink.href = e.url;
    postSection.querySelector("[data-post-picked-kind]")!.textContent = meta(e);
    closeList();
    postBox.hidden = true;
    postPicked.hidden = false;
    postEmpty.textContent = "";
    message.focus();
  }
  postInput.addEventListener("focus", search);
  postInput.addEventListener("input", () => {
    postUrlInput.value = "";
    search();
  });
  postInput.addEventListener("blur", closeList);
  postInput.addEventListener("keydown", e => {
    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      e.preventDefault();
      if (postList.hidden) return void search();
      const n = matches.length;
      setActive(
        e.key === "ArrowDown" ? (active + 1) % n : (active - 1 + n) % n
      );
    } else if (e.key === "Enter" && !postList.hidden && matches[active]) {
      e.preventDefault();
      pick(matches[active]);
    } else if (e.key === "Escape" && !postList.hidden) {
      e.preventDefault();
      closeList();
    }
  });
  postSection
    .querySelector("[data-post-change]")!
    .addEventListener("click", () => {
      postPicked.hidden = true;
      postBox.hidden = false;
      postInput.value = "";
      postUrlInput.value = "";
      postInput.focus();
    });

  preselectTopic();
  updateSubmit();
  loadSlots();
  form.addEventListener("change", e => {
    if ((e.target as HTMLInputElement).name === "topic") loadSlots();
    updateSubmit();
  });
</script>

<style is:global>
  /* Contact page (ux-ui-spec.md §5.9). Hairlines for structure; inputs get a
     darker edge so their boundary passes 3:1 in both themes. */
  .contact {
    --field-border: color-mix(
      in oklab,
      var(--foreground) 48%,
      var(--background)
    );
    --choice-border: color-mix(
      in oklab,
      var(--foreground) 22%,
      var(--background)
    );
    --chosen-bg: color-mix(in oklab, var(--foreground) 5%, var(--background));
    caret-color: var(--foreground);
    color-scheme: light;
  }
  /* Native radios, selects and their menus follow the theme. */
  [data-theme="dark"] .contact {
    color-scheme: dark;
  }
  .contact ::selection {
    background: var(--foreground);
    color: var(--background);
  }

  /* Phones: intro, form, then other ways to reach me. Wide screens: the intro
     and the other ways stay in view beside the form. */
  .contact-grid {
    display: grid;
    grid-template-areas: "intro" "form" "alt";
    row-gap: 2.5rem;
  }
  .contact-aside {
    display: contents;
  }
  .contact-intro {
    grid-area: intro;
  }
  .contact-form {
    grid-area: form;
    min-width: 0;
  }
  .contact-alt {
    grid-area: alt;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }
  @media (min-width: 64rem) {
    .contact-grid {
      grid-template-columns: minmax(0, 21rem) minmax(0, 38rem);
      grid-template-areas: "intro form" "intro alt";
      grid-template-rows: auto 1fr;
      justify-content: space-between;
      column-gap: 4rem;
      row-gap: 0;
    }
    .contact-intro {
      align-self: start;
    }
    .contact-form {
      padding-top: 0.75rem;
    }
    .contact-alt {
      margin-top: 2rem;
    }
  }
  /* The intro stays beside the form while it scrolls, when it fits. */
  @media (min-width: 64rem) and (min-height: 50rem) {
    .contact-intro {
      position: sticky;
      top: 5.5rem;
    }
  }

  .contact-offer {
    margin-top: 2rem;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }
  .contact-offer__title {
    font-family: var(--ff-display);
    font-size: 1.125rem;
    font-weight: 600;
  }
  /* What happens next, joined by a thin line. */
  .steps {
    counter-reset: step;
    margin-top: 1.25rem;
  }
  .steps li {
    position: relative;
    padding-left: 2.75rem;
    padding-bottom: 1.25rem;
  }
  .steps li:last-child {
    padding-bottom: 0;
  }
  .steps li::before {
    counter-increment: step;
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    border: 1px solid var(--field-border);
    border-radius: 999px;
    background: var(--background);
    font-family: var(--ff-display);
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .steps li:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 0.9375rem;
    top: 2.125rem;
    bottom: 0.25rem;
    width: 1px;
    background: var(--border);
  }
  .contact-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }

  /* Form sections, separated by hairlines. */
  .form-section {
    min-width: 0;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .form-section:first-child {
    padding-top: 0;
    border-top: 0;
  }
  /* A floated legend leaves the fieldset's border notch, so the hairline
     above the section stays whole. */
  legend.section-title {
    float: left;
    width: 100%;
  }
  legend.section-title + * {
    clear: both;
  }
  .section-title {
    font-family: var(--ff-display);
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 1rem;
    padding: 0;
  }
  .section-note {
    margin-top: -0.625rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }
  .field-label {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 0;
  }
  .field-grid {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 40rem) {
    .field-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .field {
    display: block;
    width: 100%;
    min-height: 2.875rem;
    margin-top: 0.375rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--field-border);
