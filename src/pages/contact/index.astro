  /* Only the questions that apply: work questions for "Work together" (the
     set for the kind of sender picked), event questions for "Speaking or
     event", the post search for "Question about a post", and the call for
     work and speaking. */
  .work-only,
  .speaking-only,
  .question-only,
  .call-only,
  .client-fields,
  .employer-fields {
    display: none;
