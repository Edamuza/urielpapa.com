---
import { PUBLIC_TURNSTILE_SITE_KEY } from "astro:env/client";
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { CONTACT, SITE, SOCIALS } from "@/config";
import SocialIcon from "@/components/SocialIcon.astro";
import { abs, breadcrumbNode, PERSON_ID } from "@/utils/schema";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Contact", href: "/contact" },
];
const topics = [
  { value: "work", label: "Work together" },
  { value: "speaking", label: "Speaking or event" },
  { value: "question", label: "Question about a post" },
  { value: "other", label: "Something else" },
];
const schema = [
  {
    "@type": "ContactPage",
    "@id": `${abs("/contact")}#page`,
    url: abs("/contact"),
    name: `Contact ${SITE.name}`,
    mainEntity: { "@id": PERSON_ID },
  },
  breadcrumbNode(crumbs),
];
const field =
  "border-foreground bg-background mt-1 block min-h-11 w-full rounded-lg border px-3 py-2";
---

<Layout
  title="Contact"
  description="Contact Uriel Papa to work together, invite Uriel to speak at an event, or ask about something on the site. Every message is read and answered."
  schema={schema}
>
  {
    PUBLIC_TURNSTILE_SITE_KEY && (
      <script
        is:inline
        slot="head"
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer
      />
    )
  }
  <div class="app-layout max-w-read pt-8">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="h1">Contact</h1>
    <p class="mt-4 text-lg">
      I read every message. Write if you'd like to work together, invite me to
      speak, or ask about something I wrote.
    </p>
    <p class="mt-3">{CONTACT.kindOfWork}</p>

    <form
      id="contact-form"
      method="post"
      action="/api/contact"
      class="mt-8 space-y-5"
      novalidate
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="c-name" class="font-semibold"
            >Name <span aria-hidden="true">*</span></label
          >
          <input
            id="c-name"
            name="name"
            type="text"
            required
            maxlength="120"
            autocomplete="name"
            class={field}
            aria-describedby="c-name-err"
          />
          <p
            id="c-name-err"
            class="mt-1 text-sm font-semibold"
            data-error-for="name"
          >
          </p>
        </div>
        <div>
          <label for="c-email" class="font-semibold"
            >Email <span aria-hidden="true">*</span></label
          >
          <input
            id="c-email"
            name="email"
            type="email"
            required
            maxlength="200"
            autocomplete="email"
            class={field}
            aria-describedby="c-email-err"
          />
          <p
            id="c-email-err"
            class="mt-1 text-sm font-semibold"
            data-error-for="email"
          >
          </p>
        </div>
      </div>

      <fieldset aria-describedby="c-topic-err">
        <legend class="font-semibold"
          >What's this about? <span aria-hidden="true">*</span></legend
        >
        <div class="mt-2 grid gap-2 sm:grid-cols-2">
          {
            topics.map((t, i) => (
              <label class="border-border has-[:checked]:border-foreground flex min-h-11 cursor-pointer items-center gap-3 rounded-lg border px-3 py-2">
                <input
                  type="radio"
                  name="topic"
                  value={t.value}
                  required
                  checked={i === 0}
                  class="size-4 accent-current"
                />
                {t.label}
              </label>
            ))
          }
        </div>
        <p
          id="c-topic-err"
          class="mt-1 text-sm font-semibold"
          data-error-for="topic"
        >
        </p>
      </fieldset>

      <div>
        <label for="c-message" class="font-semibold"
          >Message <span aria-hidden="true">*</span></label
        >
        <textarea
          id="c-message"
          name="message"
          rows="5"
          required
          minlength="10"
          maxlength="5000"
          class={field}
          aria-describedby="c-message-err"></textarea>
        <p
          id="c-message-err"
          class="mt-1 text-sm font-semibold"
          data-error-for="message"
        >
        </p>
      </div>

      <!-- Honeypot: hidden from people, often filled by bots -->
      <div class="hidden" aria-hidden="true">
        <label for="c-website">Leave this empty</label>
        <input
          id="c-website"
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      {
        PUBLIC_TURNSTILE_SITE_KEY && (
          <div
            class="cf-turnstile"
            data-sitekey={PUBLIC_TURNSTILE_SITE_KEY}
            data-theme="auto"
          />
        )
      }

      <div>
        <button type="submit" class="btn btn-filled">Send message</button>
        <p
          class="mt-3 font-semibold"
          role="alert"
          aria-live="assertive"
          id="form-status"
        >
        </p>
        <p class="meta mt-3">
          Your name, email and message are sent to my inbox and used only to
          reply to you. Nothing is added to a mailing list. By sending this you
          agree to the <a href="/privacy">privacy policy</a>.
        </p>
      </div>
    </form>

    <div class="border-border mt-10 border-t pt-6">
      <p>
        Or email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>{
          SOCIALS.map(s => (
            <>
              {" "}
              ·{" "}
              <a
                href={s.url}
                rel="me noopener"
                class="inline-flex items-center gap-1"
              >
                <SocialIcon name={s.name} />
                {s.label}
              </a>
            </>
          ))
        }
      </p>
      <p class="meta mt-2">{CONTACT.replyTime}</p>
    </div>
  </div>
</Layout>

<script>
  import { track } from "@/scripts/events";

  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLElement>("#form-status");

  // #work (from every "Work with me" link) or #speaking preselects the topic. A fragment
  // keeps one crawlable URL for this page; ?topic= still works for links shared before.
  function preselectTopic() {
    const topic =
      location.hash.slice(1) ||
      new URLSearchParams(location.search).get("topic");
    if (!topic || !form) return;
    const radio = form.querySelector<HTMLInputElement>(
      `input[name=topic][value="${CSS.escape(topic)}"]`
    );
    if (radio) radio.checked = true;
  }
  preselectTopic();
  // The footer's "Work with me" link only changes the hash when you're already here.
  window.addEventListener("hashchange", preselectTopic);

  function showErrors(errors: Record<string, string>) {
    for (const el of form?.querySelectorAll<HTMLElement>("[data-error-for]") ??
      []) {
      const name = el.dataset.errorFor!;
      el.textContent = errors[name] ?? "";
      const input = form?.querySelector<HTMLElement>(`[name=${name}]`);
      input?.setAttribute("aria-invalid", errors[name] ? "true" : "false");
    }
    const first = Object.keys(errors)[0];
    if (first) form?.querySelector<HTMLElement>(`[name=${first}]`)?.focus();
  }

  form?.addEventListener("submit", async e => {
    e.preventDefault();
    const data = new FormData(form);
    const errors: Record<string, string> = {};
    if (!String(data.get("name") ?? "").trim())
      errors.name = "Please enter your name.";
    const email = form.querySelector<HTMLInputElement>("[name=email]");
    if (!email?.value.trim() || !email.checkValidity())
      errors.email = "Please enter a valid email address.";
    if (String(data.get("message") ?? "").trim().length < 10)
      errors.message = "Please write a little more (at least 10 characters).";
    showErrors(errors);
    if (Object.keys(errors).length) {
      if (status) status.textContent = "Please fix the highlighted fields.";
      return;
    }

    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    if (button) button.disabled = true;
    if (status) status.textContent = "Sending…";
    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: data,
        headers: { Accept: "application/json" },
      });
      const body = (await res.json().catch(() => ({}))) as {
        message?: string;
        errors?: Record<string, string>;
      };
      if (!res.ok) {
        if (body.errors) showErrors(body.errors);
        throw new Error(
          body.message ??
            "Your message couldn't be sent. Please try again or email me directly."
        );
      }
      track("contact_submit", { topic: String(data.get("topic") ?? "") });
      location.href = `/contact/thanks?topic=${encodeURIComponent(String(data.get("topic") ?? ""))}`;
    } catch (err) {
      if (status)
        status.textContent =
          err instanceof Error ? err.message : "Something went wrong.";
      if (button) button.disabled = false;
      // Turnstile tokens are single-use, so get a fresh one for the next try.
      const widget = form.querySelector(".cf-turnstile");
      const turnstile = (
        window as unknown as { turnstile?: { reset: (el?: Element) => void } }
      ).turnstile;
      if (widget) turnstile?.reset(widget);
    }
  });
</script>
