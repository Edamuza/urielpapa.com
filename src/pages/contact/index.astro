    left: 0.9375rem;
    top: 2.125rem;
    bottom: 0.25rem;
    width: 1px;
    background: var(--border);
  }
  .contact-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }

  /* Form sections, separated by hairlines. */
  .form-section {
    min-width: 0;
    padding-block: 2rem;
    border-top: 1px solid var(--border);
  }
  .form-section:first-child {
    padding-top: 0;
    border-top: 0;
  }
  /* A floated legend leaves the fieldset's border notch, so the hairline
     above the section stays whole. */
  legend.section-title {
    float: left;
    width: 100%;
  }
  legend.section-title + * {
    clear: both;
  }
  .section-title {
    font-family: var(--ff-display);
    font-size: 1.1875rem;
    font-weight: 600;
