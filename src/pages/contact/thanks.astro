---
import Layout from "@/layouts/Layout.astro";
import PostCard from "@/components/PostCard.astro";
import { BOOKING_URL, CONTACT, WORK_WITH_ME_OFFER } from "@/config";
import { getPosts, postUrl } from "@/utils/content";

const latest = (await getPosts()).filter(p => !p.data.draft).slice(0, 3);
---

<Layout title="Message sent" description="Your message was sent." noindex>
  <div class="app-layout max-w-read pt-12">
    <h1 class="h1">Thanks, your message is on its way</h1>
    <p class="mt-4 text-lg">
      It went straight to my inbox. {CONTACT.replyTime}
    </p>
    {
      BOOKING_URL && (
        <section
          id="book"
          class="border-foreground mt-8 rounded-lg border p-4 sm:p-5"
          aria-labelledby="book-h"
          hidden
          data-booking
        >
          <h2 id="book-h" class="h3">
            Pick a time for your free 15-minute call
          </h2>
          <p class="mt-1">
            {WORK_WITH_ME_OFFER}. Choose a slot below and you'll get a Google
            Calendar invite with the meeting link.
          </p>
          <iframe
            data-src={BOOKING_URL}
            title="Book a free 15-minute discovery call with Uriel Papa on Google Calendar"
            class="border-border mt-4 h-[640px] w-full rounded-lg border bg-white"
            loading="lazy"
          />
          <p class="meta mt-2">
            Calendar not loading?{" "}
            <a
              href={BOOKING_URL}
              target="_blank"
              rel="noopener"
              title="Open Uriel Papa's Google Calendar booking page in a new tab"
            >
              Open the booking page
            </a>
            .
          </p>
        </section>
      )
    }
    {
      latest.length > 0 && (
        <section class="mt-10">
          <h2 class="h2 mb-4">While you wait</h2>
          <ul>
            {latest.map(p => (
              <PostCard
                href={postUrl(p)}
                title={p.data.title}
                hub={p.data.hub}
                date={p.data.published}
              />
            ))}
          </ul>
        </section>
      )
    }
    <p class="mt-8">
      <a href="/" title="Back to Uriel Papa's home page"
        >Back to the home page</a
      >
    </p>
  </div>
</Layout>

<script>
  // Only "Work together" messages get the booking step. The iframe loads
  // when it is shown, so other visitors never load Google Calendar.
  const booking = document.querySelector<HTMLElement>("[data-booking]");
  if (booking && new URLSearchParams(location.search).get("topic") === "work") {
    const frame = booking.querySelector<HTMLIFrameElement>("iframe");
    if (frame?.dataset.src) frame.src = frame.dataset.src;
    booking.hidden = false;
  }
</script>
