---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { formatDate, isoDate } from "@/utils/content";
import { PERSON_ID, breadcrumbNode } from "@/utils/schema";

const page = await getEntry("pages", "now");
if (!page) throw new Error("Missing src/content/pages/now.md");
const { Content } = await render(page);
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Now", href: "/now" },
];
---

<Layout
  title={page.data.title}
  description={page.data.description}
  modifiedTime={page.data.updated}
  schema={[breadcrumbNode(crumbs)]}
  webPage={{ about: { "@id": PERSON_ID } }}
>
  <div class="app-layout max-w-read pt-8">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="h1">{page.data.title}</h1>
    <p class="meta mt-3">
      Updated <time datetime={isoDate(page.data.updated)}
        >{formatDate(page.data.updated, "D MMMM YYYY")}</time
      >. This is a <a href="https://nownownow.com/about" rel="noopener"
        >now page</a
      >.
    </p>
    <div class="app-prose mt-6"><Content /></div>
  </div>
</Layout>
