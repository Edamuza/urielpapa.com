---
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import SocialIcon from "@/components/SocialIcon.astro";
import StackMarquee from "@/components/StackMarquee.astro";
import CertificationList from "@/components/CertificationList.astro";
import { SITE, SOCIALS, WORK_WITH_ME_HREF } from "@/config";
import { HUBS } from "@/data/hubs";
import events from "@/data/events.json";
import { BUILD_TOOLS, GROW_TOOLS } from "@/data/tech-stack";
import { getProjects, projectUrl } from "@/utils/content";
import { abs, breadcrumbNode, PERSON_ID } from "@/utils/schema";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "About", href: "/about" },
];

// Everything below comes from the site and Uriel's resume (November 2026).

const method = [
  {
    word: "See",
    line: "the problem",
    proof: [
      "A client fit-check form and consultation playbook that qualify leads before a call.",
      "A 23-page semantic SEO master plan built from Search Console, GA4, Bing Webmaster and Google Trends data.",
      "12 SOPs, plus the job descriptions and contracts the team worked from.",
    ],
  },
  {
    word: "Build",
    line: "the solution",
    proof: [
      "An ERP with 115 pages, 144 data models and 5,241 automated tests, in under 3 months.",
      "An NFC card platform with 497 tests and a client quotation portal with 174.",
      "A multi-agent Claude Code pipeline that audits a production codebase in under 6 minutes.",
    ],
  },
  {
    word: "Grow",
    line: "the business",
    proof: [
      "Close rate from 15% to 30% across 40 consultations.",
      "33 lead conversations in 5 days of Meta ads, about US$1 each.",
      "150 NFC cards sold in their first 2 months, and clients' organic clicks up about 40%.",
    ],
  },
];

/** A photo from Uriel's own library, served from public/images/about at
 * 640 and 1280 wide (AVIF and WebP, metadata stripped). Captions say only
 * what the photo itself shows, or when and where it was taken. */
type Photo = {
  src: string;
  width: number;
  height: number;
  alt: string;
  caption: string;
  /** A line or two on what was happening, shown under the caption. It is
   * trusted HTML written here, so it may hold links (each with a title). */
  story?: string;
};
/** One stop on a year's timeline, in month order. A stop with no `what` only
 * carries photos. The page gathers each year's photos into one strip, in
 * this order. */
type Entry = {
  when: string;
  what?: string;
  note?: string;
  photos?: Photo[];
};
type Chapter = {
  year: string;
  lead?: string[];
  entries: Entry[];
};
const photo = (
  src: string,
  width: number,
  height: number,
  alt: string,
  caption: string,
  story?: string
): Photo => ({
  src: `/images/about/${src}`,
  width,
  height,
  alt,
  caption,
  story,
});
const years: Chapter[] = [
  {
    year: "2023",
    entries: [
      {
        when: "Feb",
        what: "Marketing specialist, part-time",
        note: "Grew a car repair shop finder's Facebook page to 2,000 followers and signed up 50 shops.",
      },
      {
        when: "Oct",
        what: "WordPress developer, freelance",
        note: "Built client sites for international marketing and advertising agencies.",
      },
    ],
  },
  {
    year: "2024",
    entries: [
      {
        when: "Jun",
        what: "Team leader",
        note: "Led 8 developers, SEO specialists, a writer and a designer.",
      },
      {
        when: "Nov",
        what: "Project manager",
        note: "Ran 10 client projects and delivered 95% on time.",
      },
      {
        when: "Dec",
        photos: [
          photo(
            "2024-12-group",
            1280,
            853,
            "Uriel Papa with a group of twelve people outdoors at night under string lights",
            "December 2024.",
            "Our first year-end get-together. Most of these people had only ever been faces on a video call until that night."
          ),
        ],
      },
    ],
  },
  {
    year: "2025",
    lead: [
      "I founded VITE SEO Digital Advertising in March 2025, still an undergraduate. It grew to up to 22 people across sales, development, marketing and SEO.",
    ],
    entries: [
      {
        when: "Mar",
        what: "Founded VITE SEO Digital Advertising",
        note: "At 21. Onboarded and trained 15 hires and wrote 12 SOPs.",
      },
      {
        when: "May",
        photos: [
          photo(
            "2025-05-office",
            1280,
            720,
            "Uriel Papa in a black suit and sunglasses at the opening of his agency's first office, with blue cubicles and balloons",
            "Office opening, May 2025.",
            "Opening day of our first office, back when we were Vercel Digital Marketing, the agency that soon became VITE SEO. We celebrated with balloons and soda."
          ),
          photo(
            "2025-05-mirror",
            1280,
            1707,
            "Uriel Papa in a black shirt taking a mirror photo against a dark green wall",
            "Pasay, May 2025.",
            "A quiet night out after a long week of client calls. I've learned to stop and mark the small wins."
          ),
        ],
      },
      {
        when: "Nov",
        what: "Philippine SME Business Expo",
        note: "Attended, and wrote up what I learned about how small businesses adopt technology.",
        photos: [
          photo(
            "2025-11-sme-expo",
            1280,
            1707,
            "Uriel Papa wearing a Philippine SME Business Expo badge in a crowded exhibition hall",
            "At the expo, November 2025.",
            "I walked every aisle asking owners what slowed them down most. The answer was almost always the same: time."
          ),
        ],
      },
    ],
  },
  {
    year: "2026",
    entries: [
      {
        when: "Feb",
        what: "Speakerscon",
        note: "Attended The Premier Branding and Marketing Conference of 2026.",
        photos: [
          photo(
            "2026-02-speakerscon",
            1280,
            1707,
            "Uriel Papa in a grey suit holding a briefcase in front of the Speakerscon welcome backdrop",
            "At Speakerscon, February 2026.",
            "I came to learn how the best brands tell their story, and left with pages of notes for our clients."
          ),
        ],
      },
      {
        when: "Feb",
        photos: [
          photo(
            "2026-02-talk",
            1280,
            720,
            "Uriel Papa standing and speaking to a seated group in a café",
            "February 2026. Photo by Bruce Dan Reyes.",
            "My first time sharing what we'd learned with a room of business owners. I was nervous, and they were kind."
          ),
          photo(
            "2026-02-group",
            1280,
            720,
            "Uriel Papa in a group of about twenty people around café tables",
            "Makati, February 2026.",
            "Breakfast with fellow founders. Everyone at those tables was building something, and everyone was willing to help."
          ),
          photo(
            "2026-02-microsoft",
            1280,
            1707,
            "Uriel Papa in a black blazer in front of a Microsoft sign and a gold slatted wall",
            "Microsoft's office in Makati, February 2026.",
            "Walking through Microsoft's office reminded me how far good systems can take a small team."
          ),
        ],
      },
      {
        when: "May",
        photos: [
          photo(
            "2026-05-certificates",
            1280,
            960,
            "Uriel Papa with four teammates holding green certificate folders under a university welcome sign after finishing their TravelEase thesis",
            "TravelEase thesis team, Manila, May 2026.",
            'Finishing our thesis and capstone, <a href="/projects/travelease" title="TravelEase, a tourism portal for Tagaytay built as a capstone thesis">TravelEase</a>.'
          ),
        ],
      },
      {
        when: "Jul",
        what: "Built the company's own ERP",
        note: "With the in-house team: HR and payroll, CRM, projects and accounting behind one login.",
      },
      {
        when: "Jul",
        photos: [
          photo(
            "2026-07-taguig",
            1280,
            1707,
            "Uriel Papa standing beside another attendee at the first App Builders PH event, in an office in Taguig",
            "First App Builders PH event, Taguig, July 2026.",
            'The first <a href="https://www.appbuildersph.com/" title="App Builders PH, the community for Filipino app builders" target="_blank" rel="noopener">App Builders PH</a> event, hosted by <a href="https://bryllim.com/" title="Bryl Lim, AI and software engineer and founder of App Builders PH" target="_blank" rel="noopener">Bryl Lim</a>. A room full of Filipino builders sharing what they were making.'
          ),
        ],
      },
      {
        when: "Aug",
        what: "Graduated cum laude",
        note: "BS Information Systems, Technological University of the Philippines.",
        photos: [
          photo(
            "2026-06-graduation",
            1280,
            1920,
            "Uriel Papa's graduation portrait in a black toga with a gold hood",
            "Graduation portrait.",
            "Four years of juggling classes and clients, finished cum laude."
          ),
        ],
      },
      {
        when: "Oct",
        what: "AppBuildersPH Hackathon",
        note: "Co-developed Tell Liora, an offline maternal-care app.",
      },
    ],
  },
];

const BUILDS = [
  "vite-seo-erp",
  "nfc-card-platform",
  "quotation-portal",
  "wordpress-seo-plugins",
  "travelease",
  "tell-liora",
  "archive-downloader",
];
const projects = (await getProjects())
  .filter(p => BUILDS.includes(p.id))
  .sort((a, b) => BUILDS.indexOf(a.id) - BUILDS.indexOf(b.id));

// The result each build is known for. `figure` is set in large type; builds
// without a number carry a short `text` instead.
const results: Record<
  string,
  { pre?: string; figure?: string; label?: string; text?: string }
> = {
  "vite-seo-erp": { pre: "About", figure: "US$390", label: "a month saved" },
  "nfc-card-platform": { figure: "150", label: "cards sold in 2 months" },
  "quotation-portal": { figure: "174", label: "automated tests" },
  "wordpress-seo-plugins": {
    figure: "10 min",
    label: "for a site audit, down from 2 hours",
  },
  travelease: { figure: "411", label: "automated tests" },
  "tell-liora": { text: "AppBuildersPH Hackathon 2026" },
  "archive-downloader": { text: "Wayback pages to WordPress" },
};

const schema = [
  {
    "@type": "ProfilePage",
    "@id": `${abs("/about")}#page`,
    url: abs("/about"),
    name: `About ${SITE.name}`,
    mainEntity: { "@id": PERSON_ID },
  },
  breadcrumbNode(crumbs),
];
---

<Layout
  title="About Uriel Papa, Builder and Founder"
  description="Uriel Papa is a builder and founder in the Philippines who shares lessons on AI, automation, tech stacks, SEO, GEO and AEO, marketing and business."
  ogType="profile"
  schema={schema}
>
  <div class="about-page">
    <div class="app-layout page-top">
      <Breadcrumbs crumbs={crumbs} />
    </div>

    <section class="app-layout hero" aria-labelledby="about-h">
      <figure class="portrait">
        <div class="plate">
          <picture class="contents">
            <source
              type="image/avif"
              srcset="/images/uriel-papa-portrait-320.avif 320w, /images/uriel-papa-portrait-480.avif 480w, /images/uriel-papa-portrait-560.avif 560w, /images/uriel-papa-portrait-800.avif 800w, /images/uriel-papa-portrait.avif 1200w"
              sizes="(min-width: 64rem) 500px, (min-width: 40rem) 440px, 300px"
            />
            <img
              src="/images/uriel-papa-portrait.webp"
              srcset="/images/uriel-papa-portrait-320.webp 320w, /images/uriel-papa-portrait-480.webp 480w, /images/uriel-papa-portrait-560.webp 560w, /images/uriel-papa-portrait-800.webp 800w, /images/uriel-papa-portrait.webp 1200w"
              sizes="(min-width: 64rem) 500px, (min-width: 40rem) 440px, 300px"
              width="1200"
              height="1787"
              alt="Uriel Papa smiling, wearing black-framed glasses, a dark charcoal suit and a white open-collar shirt"
              title="Uriel Papa"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="plate__img"
            />
          </picture>
        </div>
        <figcaption class="portrait__caption">{SITE.name}, 2026</figcaption>
      </figure>

      <div class="ident">
        <div class="ident__top">
          <h1 id="about-h" class="ident__name">{SITE.name}</h1>
          <p class="ident__role">{SITE.jobTitle}&nbsp;· {SITE.location}</p>
        </div>
        <div class="ident__body">
          <p class="ident__creed">
            <span>I see the problem.</span>
            <span>I build the solution.</span>
            <span>I grow the business.</span>
          </p>
          <p class="ident__intro">
            I'm a technical leader who thinks strategically before anything gets
            built. I question the plan, find the real problem, then lead the
            work until it ships. I'm hungry to grow, and I don't wait for luck.
            I earn my place by giving a company or a client enough value that we
            grow together. My motto is if you want to win the lottery, you've
            got to make money to buy a ticket.
          </p>
          <a
            href="#story"
            class="ident__cue"
            title="Jump to Uriel Papa's story"
          >
            Read the story
            <svg viewBox="0 0 12 16" aria-hidden="true">
              <path d="M6 1v13M1.5 9.5 6 14l4.5-4.5"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <div class="app-layout">
      <section class="sec sec--first" aria-labelledby="work-h">
        <div class="work__head">
          <h2 id="work-h" class="sec-h">What I've built</h2>
          <a
            href="/projects"
            class="work__all"
            title="All of Uriel Papa's projects">All projects</a
          >
        </div>
        <ul class="work">
          {
            projects.map((p, i) => {
              const r = results[p.id];
              return (
                <li>
                  <a
                    href={projectUrl(p)}
                    title={`Read the ${p.data.title} case study`}
                    class:list={["work__row", i === 0 && "work__row--lead"]}
                  >
                    <p class="work__result">
                      {r?.figure ? (
                        <>
                          {r.pre && <span class="work__pre">{r.pre} </span>}
                          <span class="work__figure">{r.figure}</span>
                          <span class="work__label"> {r.label}</span>
                        </>
                      ) : (
                        <span class="work__text">{r?.text}</span>
                      )}
                    </p>
                    <div class="work__about">
                      <h3 class="work__title">{p.data.title}</h3>
                      <p class="work__outcome">{p.data.outcome}</p>
                    </div>
                    <span class="work__year">{p.data.year}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </section>

      <section class="sec" aria-labelledby="method-h">
        <h2 id="method-h" class="sec-h">How I work</h2>
        <ol class="method">
          {
            method.map(m => (
              <li>
                <h3 class="method__word">
                  {m.word} <span>{m.line}</span>
                </h3>
                <ul class="method__proof">
                  {m.proof.map(p => (
                    <li>{p}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="sec" id="story" aria-labelledby="story-h">
        <h2 id="story-h" class="sec-h">My story</h2>
        <ol class="years">
          {
            years.map(y => (
              <>
                {y.year === "2025" && (
                  <li class="interlude">
                    <figure class="print">
                      <img
                        src="/images/uriel-papa.jpg"
                        width="480"
                        height="480"
                        alt="Uriel Papa outdoors in black-framed glasses, with palm trees and a school building behind him"
                        title="Uriel Papa, off the clock"
                        loading="lazy"
                        decoding="async"
                      />
                      <figcaption>Off the clock.</figcaption>
                    </figure>
                    <p class="interlude__line">
                      I started the agency with the clients who followed me from
                      freelance work.
                    </p>
                  </li>
                )}
                <li class="year">
                  <p class="year__num">{y.year}</p>
                  <div class="year__body">
                    {y.lead && (
                      <div class="year__lead">
                        {y.lead.map(l => (
                          <p>{l}</p>
                        ))}
                        <p>
                          Before it closed, we built 12 WordPress sites for
                          clients like Noyona Cosmetics and Icamen Legal, and{" "}
                          <a
                            href="/blog/n8n-messenger-instagram-chatbot"
                            title="How to Build an AI Chatbot for Messenger and Instagram with n8n"
                          >
                            an AI chatbot that answers 120 inquiries a month
                          </a>
                          . The sales process I designed took our close rate
                          from 15% to 30%.
                        </p>
                      </div>
                    )}
                    <ol class="year__entries">
                      {y.entries
                        .filter(e => e.what)
                        .map(e => (
                          <li>
                            <p class="year__what">
                              <span>{e.what}</span>
                              <span class="year__when">{e.when}</span>
                            </p>
                            {e.note && <p class="year__note">{e.note}</p>}
                          </li>
                        ))}
                    </ol>
                    {y.entries.some(e => e.photos) && (
                      <ul
                        class="snaps"
                        aria-label={`Photos from ${y.year}`}
                        tabindex="0"
                      >
                        {y.entries
                          .flatMap(e => e.photos ?? [])
                          .map(ph => (
                            <li
                              class="snap"
                              style={`--ar: ${ph.width / ph.height}`}
                            >
                              <figure>
                                <picture>
                                  <source
                                    type="image/avif"
                                    srcset={`${ph.src}-640.avif 640w, ${ph.src}-1280.avif ${ph.width}w`}
                                    sizes="(min-width: 48rem) 360px, 290px"
                                  />
                                  <img
                                    src={`${ph.src}-640.webp`}
                                    srcset={`${ph.src}-640.webp 640w, ${ph.src}-1280.webp ${ph.width}w`}
                                    sizes="(min-width: 48rem) 360px, 290px"
                                    width={ph.width}
                                    height={ph.height}
                                    alt={ph.alt}
                                    title={ph.caption.replace(/\.$/, "")}
                                    loading="lazy"
                                    decoding="async"
                                  />
                                </picture>
                                <figcaption>
                                  {ph.caption}
                                  {ph.story && (
                                    <span
                                      class="snap__story"
                                      set:html={ph.story}
                                    />
                                  )}
                                </figcaption>
                              </figure>
                            </li>
                          ))}
                      </ul>
                    )}
                    {y.year === "2026" && (
                      <p class="year__close">
                        The agency closed after financial losses. I'm
                        rebuilding, and writing down what I learned:{" "}
                        <a
                          href="/blog/closing-my-agency"
                          title="What Losing My Agency Taught Me as a Founder"
                        >
                          What Losing My Agency Taught Me as a Founder
                        </a>
                        .
                      </p>
                    )}
                  </div>
                </li>
              </>
            ))
          }
        </ol>
      </section>
    </div>

    <section class="stack" aria-labelledby="stack-h">
      <div class="app-layout stack__head">
        <h2 id="stack-h" class="sec-h">What I build with</h2>
        <p class="stack__intro">
          The languages, frameworks, AI models and tools I've shipped with, from
          code to search. <a
            href="/stack"
            title="How Uriel Papa uses each tool on the Stack page"
            >How I use each one</a
          >.
        </p>
      </div>
      <StackMarquee
        rows={[
          { label: "Languages, frameworks and data", tools: BUILD_TOOLS },
          {
            label: "AI, automation, search and hosting",
            tools: GROW_TOOLS,
            reverse: true,
          },
        ]}
      />
    </section>

    <div class="app-layout">
      <section class="sec more" aria-label="Writing, training and languages">
        <div>
          <h2 class="sub-h">What I write about</h2>
          <ul class="more__topics">
            {
              HUBS.map(h => (
                <li>
                  <a
                    href={`/topics/${h.id}`}
                    class="more__link"
                    title={`Uriel Papa's writing on ${h.name}`}
                  >
                    {h.name}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="more__also">
            Also <a href="/news" title="Uriel Papa's takes on tech news"
              >takes on tech news</a
            > and <a
              href="/events"
              title="Uriel Papa's notes from seminars and trainings"
              >notes from seminars</a
            >.
          </p>
          <h2 class="sub-h sub-h--next">Languages</h2>
          <p class="more__lang">
            Filipino (native) and English (professional working proficiency).
          </p>
        </div>
        <div>
          <h2 class="sub-h">Seminars and training</h2>
          <ul class="more__list">
            {
              events.attended.map(e => (
                <li class="more__event">
                  <span class="font-semibold">{e.name}</span>
                  <span class="more__note">
                    {e.organizer} · {e.dateLabel}
                  </span>
                </li>
              ))
            }
          </ul>
          {
            events.sponsored.map(e => (
              <p class="more__also">
                Also a {e.role.toLowerCase()} of{" "}
                <a
                  href={e.sponsorsUrl}
                  title={`See Uriel Papa on the ${e.name} sponsors page`}
                  rel="noopener"
                >
                  {e.name}
                </a>{" "}
                in {e.city}, supporting the WordPress community I built my first
                client sites in.
              </p>
            ))
          }
        </div>
        <div class="more__certs">
          <h2 class="sub-h">Certifications</h2>
          <CertificationList />
        </div>
      </section>

      <section class="close" aria-labelledby="close-h">
        <h2 id="close-h" class="close__title">Have a problem worth solving?</h2>
        <p class="close__line">
          Tell me about it. The call goes straight into my calendar.
        </p>
        <div class="close__actions">
          <a
            href={WORK_WITH_ME_HREF}
            class="btn btn-filled btn-primary"
            title="Book a free 15-minute discovery call with Uriel Papa"
            data-event="work_with_me_click"
            data-event-from="about">Book a free 15-minute call</a
          >
          <a
            href={`mailto:${SITE.email}`}
            class="close__mail"
            title="Email Uriel Papa">{SITE.email}</a
          >
        </div>
        <ul class="close__socials">
          {
            SOCIALS.map(s => (
              <li>
                <a
                  href={s.url}
                  rel="me noopener"
                  class="close__social"
                  title={`Uriel Papa on ${s.label}`}
                >
                  <SocialIcon name={s.name} />
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</Layout>

<style>
  /* About page: a portrait-led profile. Strict black and white plus the
     photos' own colour; the page's tokens alias the site's semantic ones. */
  .about-page {
    --ink: var(--foreground);
    --paper: var(--background);
    --rule: var(--border);
    --rule-strong: var(--foreground);
    --quiet: var(--muted-foreground);
    --tile: var(--muted);

    --print: var(--paper);
    --print-shade: color-mix(in oklab, var(--ink) 24%, transparent);

    --step--1: 0.875rem;
    --step-0: 1rem;
    --step-1: 1.1875rem;
    --step-2: clamp(1.3125rem, 1.2rem + 0.6vw, 1.625rem);
    --step-3: clamp(1.75rem, 1.4rem + 1.6vw, 2.5rem);
    --step-4: clamp(2rem, 1.5rem + 2vw, 2.75rem);
    --step-5: clamp(3rem, 2rem + 4.5vw, 5.25rem);
    --step-6: clamp(3.5rem, 2rem + 7vw, 6rem);

    --space-section: clamp(2rem, 4vw, 3rem);
    --space-head: clamp(1.125rem, 2vw, 1.5rem);
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);

    color: var(--ink);
  }
  :global([data-theme="dark"]) .about-page {
    --print: var(--tile);
    --print-shade: transparent;
  }
