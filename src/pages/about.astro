---
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import SocialIcon from "@/components/SocialIcon.astro";
import WorkWithMe from "@/components/WorkWithMe.astro";
import { SITE, SOCIALS } from "@/config";
import { HUBS } from "@/data/hubs";
import events from "@/data/events.json";
import CertificationList from "@/components/CertificationList.astro";
import { getHubs } from "@/utils/content";
import { abs, breadcrumbNode, PERSON_ID } from "@/utils/schema";

const hubs = await getHubs();
// The line on the portrait: job title, city and country.
const [city, country] = SITE.location.split(", ");
const crumbs = [
  { name: "Home", href: "/" },
  { name: "About", href: "/about" },
];

const proof = [
  "Led and co-developed an ERP with 115 pages, 144 data models and 5,241 automated tests in under 3 months.",
  "Led and co-developed 5 WordPress SEO plugins, about 11,700 lines of code.",
  "Contributed about two-thirds of TravelEase's 316 commits; the project has 411 automated tests.",
  "Ran Meta ads at about US$8 a day that started 33 inbound conversations in 5 days, about US$1 each.",
  "Built a multi-agent Claude Code pipeline that audits a production codebase in under 6 minutes.",
];

const schema = [
  {
    "@type": "ProfilePage",
    "@id": `${abs("/about")}#page`,
    url: abs("/about"),
    name: `About ${SITE.name}`,
    mainEntity: { "@id": PERSON_ID },
  },
  breadcrumbNode(crumbs),
];
---

<Layout
  title="About Uriel Papa, Builder and Founder"
  description="Uriel Papa is a builder and founder in the Philippines who shares lessons on AI, automation, tech stacks, SEO, GEO and AEO, marketing and business."
  ogType="profile"
  schema={schema}
>
  <div class="app-layout max-w-read pt-8">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="h1">About {SITE.name}</h1>

    {
      /* The same floating cut-out portrait as the home page on phones: a
        giant name behind it and the name and title over its bottom-left. */
    }
    <figure class="about-portrait">
      <span class="about-portrait__bigname" aria-hidden="true">Uriel Papa</span>
      <div class="about-portrait__float">
        <picture class="contents">
          <source
            type="image/avif"
            srcset="/images/uriel-papa-portrait-320.avif 320w, /images/uriel-papa-portrait-480.avif 480w, /images/uriel-papa-portrait-560.avif 560w, /images/uriel-papa-portrait-800.avif 800w, /images/uriel-papa-portrait.avif 1200w"
            sizes="290px"
          />
          <img
            src="/images/uriel-papa-portrait.webp"
            srcset="/images/uriel-papa-portrait-320.webp 320w, /images/uriel-papa-portrait-480.webp 480w, /images/uriel-papa-portrait-560.webp 560w, /images/uriel-papa-portrait-800.webp 800w, /images/uriel-papa-portrait.webp 1200w"
            sizes="290px"
            width="1200"
            height="1787"
            alt="Uriel Papa smiling, wearing black-framed glasses, a dark charcoal suit and a white open-collar shirt"
            title="Uriel Papa"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="about-portrait__img"
          />
        </picture>
      </div>
      <figcaption>
        <span class="block font-semibold">{SITE.name}</span>
        <span class="text-muted-foreground block text-sm"
          >{SITE.jobTitle}&nbsp;· {city}{country && `, ${country}`}</span
        >
      </figcaption>
    </figure>

    <div class="mt-8 space-y-4 text-lg">
      <p>
        <strong
          >I'm Uriel Papa, a builder and founder in the Philippines.</strong
        >{" "}
        I built my own company, a digital agency I founded at 21, and grew it to a
        team of up to 22. In my blood I'm a builder and founder. The agency closed
        after financial losses, and I'm rebuilding myself and sharing the journey
        here: what I've learned and the mistakes I've made as a founder. I graduated
        cum laude with a BS in Information Systems from the Technological University
        of the Philippines in 2026.
      </p>
      <p>
        This site is where I share what I learn: how AI and large language
        models work, the automations I build, how technology affects business
        and society, how search is changing, what's new in tech stacks,
        marketing basics, and what I've learned as a founder.
      </p>
    </div>

    <section class="mt-10" aria-labelledby="now-h">
      <h2 id="now-h" class="h2 mb-3">What I do now</h2>
      <p>
        I'm {SITE.name}, a {SITE.jobTitle.toLowerCase()} in the Philippines. I build
        software and automations, and I write here about AI, automation, tech stacks,
        SEO, GEO and AEO, marketing and the founder's journey. My work includes leading
        and co-developing an ERP with 115 pages and 5,241 automated tests in under
        3 months, AI chatbots and outreach workflows on n8n, and 5 WordPress SEO plugins.
        In August 2026 I graduated cum laude in Information Systems from the Technological
        University of the Philippines, and in October I co-developed Tell Liora at
        the AppBuildersPH Hackathon 2026. Now I'm deciding what comes next: a job,
        freelance work, or building a business again. For what I'm working on this
        month, see <a href="/now">Now</a>; for the tools I use, see <a
          href="/stack">Stack</a
        >.
      </p>
      <p class="mt-4">
        More detail on the systems themselves is on the <a href="/projects"
          >Projects</a
        > page.
      </p>
    </section>

    <section class="mt-10" aria-labelledby="proof-h">
      <h2 id="proof-h" class="h2 mb-4">In numbers</h2>
      <ul class="list-disc space-y-2 ps-5">{proof.map(p => <li>{p}</li>)}</ul>
    </section>

    <section class="mt-10" aria-labelledby="write-h">
      <h2 id="write-h" class="h2 mb-4">What I write about</h2>
      <ul class="space-y-2">
        {
          HUBS.map(h => (
            <li>
              <a href={`/topics/${h.id}`} class="font-semibold">
                {h.name}
              </a>
              : {hubs.find(e => e.id === h.id)?.data.summary}
            </li>
          ))
        }
      </ul>
      <p class="mt-4">
        I also write <a href="/news">takes on tech news</a> and <a
          href="/events">notes from seminars and trainings</a
        >.
      </p>
    </section>

    <section class="mt-10" aria-labelledby="ev-h">
      <h2 id="ev-h" class="h2 mb-4">Seminars and training</h2>
      <ul class="list-disc space-y-1 ps-5">
        {
          events.attended.map(e => (
            <li>
              {e.name}, {e.organizer} ({e.dateLabel})
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-10" aria-labelledby="cert-h">
      <h2 id="cert-h" class="h2 mb-4">Certifications</h2>
      <CertificationList />
    </section>

    <section class="mt-10" aria-labelledby="lang-h">
      <h2 id="lang-h" class="h2 mb-3">Languages</h2>
      <p>Filipino (native) and English (professional working proficiency).</p>
    </section>

    <section class="mt-10" aria-labelledby="reach-h">
      <h2 id="reach-h" class="h2 mb-3">How to reach me</h2>
      <p>
        Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or use the <a
          href="/contact">contact form</a
        >. I'm also on:
      </p>
      <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-1">
        {
          SOCIALS.map(s => (
            <li>
              <a
                href={s.url}
                rel="me noopener"
                class="inline-flex items-center gap-1.5"
              >
                <SocialIcon name={s.name} />
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <WorkWithMe
      text="Want to work together?"
      linkText="Get in touch."
      from="about"
    />
  </div>
</Layout>

<style>
  /* Floating portrait: soft shadow, a gentle 6s bob that stops for reduced
     motion, and the jacket fading out at the bottom under the caption. No
     light outline or glow, so no white shows around it in dark mode. */
  .about-portrait {
    --portrait-h: clamp(300px, 52svh, 430px);
    --portrait-shadow: rgb(0 0 0 / 0.18);
    position: relative;
    isolation: isolate;
    margin: 1.25rem 0 0;
    overflow-x: clip;
  }
  :global([data-theme="dark"]) .about-portrait {
    --portrait-shadow: rgb(0 0 0 / 0.6);
  }
  .about-portrait__float {
    position: relative;
    z-index: 1;
    width: fit-content;
    margin-inline: auto;
    animation: about-float 6s ease-in-out infinite;
    filter: drop-shadow(0 24px 40px var(--portrait-shadow));
  }
  .about-portrait__img {
    display: block;
    width: auto;
    height: var(--portrait-h);
    mask-image: linear-gradient(to bottom, #000 70%, transparent 100%);
  }
  @keyframes about-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .about-portrait__float {
      animation: none;
    }
  }
  /* Giant "URIEL PAPA" behind the portrait: faint grey in light mode, a white
     outline (no fill) in dark mode. */
  .about-portrait__bigname {
    position: absolute;
    top: 6%;
    left: 0;
    right: 0;
    z-index: 0;
    width: min-content;
    margin-inline: auto;
    font-family: var(--ff-display);
    font-weight: 800;
    font-size: min(29vw, calc(var(--portrait-h) * 0.4));
    line-height: 0.82;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-align: center;
    color: var(--foreground);
    opacity: 0.1;
    pointer-events: none;
    user-select: none;
  }
  :global([data-theme="dark"]) .about-portrait__bigname {
    /* An outline drawn with shadows rather than text-stroke, which would also
       trace the font's overlapping inner contours. */
    --o: rgb(255 255 255 / 0.5);
    color: var(--background);
    text-shadow:
      1px 0 var(--o),
      -1px 0 var(--o),
      0 1px var(--o),
      0 -1px var(--o),
      1px 1px var(--o),
      -1px -1px var(--o),
      1px -1px var(--o),
      -1px 1px var(--o);
    opacity: 1;
  }
  .about-portrait figcaption {
    position: absolute;
    z-index: 2;
    left: 0;
    bottom: 0.25rem;
  }
  .about-portrait figcaption > span:first-child {
    font-size: 1.25rem;
  }
</style>
