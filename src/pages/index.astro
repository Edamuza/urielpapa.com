---
import Layout from "@/layouts/Layout.astro";
import { PERSON_ID } from "@/utils/schema";
import Avatar from "@/components/Avatar.astro";
import PostCard from "@/components/PostCard.astro";
import HubCard from "@/components/HubCard.astro";
import NewsletterBox from "@/components/NewsletterBox.astro";
import WorkWithMe from "@/components/WorkWithMe.astro";
import SiteStats from "@/components/SiteStats.astro";
import { SITE } from "@/config";
import { HUBS } from "@/data/hubs";
import {
  formatDate,
  getAllBlogEntries,
  getEventNotes,
  getHubs,
  getNewsTakes,
  getNotes,
  getPosts,
  isoDate,
  noteUrl,
  postUrl,
  readingTime,
} from "@/utils/content";

const posts = await getPosts();
const latestNews = (await getNewsTakes())[0];
const notes = (await getNotes()).slice(0, 3);
const events = (await getEventNotes()).slice(0, 2);
const hubEntries = await getHubs();
const allBlog = await getAllBlogEntries();
const allNotes = await getNotes();

const hubCount = (id: string) =>
  allBlog.filter(p => p.data.hub === id).length +
  allNotes.filter(n => n.data.hub === id).length;
// Phones show the city only, so the line under the name fits on one row.
const [city, country] = SITE.location.split(", ");
---

<Layout
  webPage={{ about: { "@id": PERSON_ID }, mainEntity: { "@id": PERSON_ID } }}
>
  {
    latestNews && (
      <div class="app-layout">
        {/* Latest news take: always one line under the header; phones drop the date. */}
        <aside
          aria-label="Latest news take"
          class="border-border flex items-baseline gap-x-3 border-b py-2 text-sm sm:py-3"
        >
          <span class="label-caps text-muted-foreground">News</span>
          <a
            href={postUrl(latestNews)}
            class="min-w-0 flex-1 truncate font-semibold"
          >
            {latestNews.data.title}
          </a>
          <time
            datetime={isoDate(latestNews.data.published)}
            class="text-muted-foreground hidden shrink-0 sm:inline"
          >
            {formatDate(latestNews.data.published)}
            {latestNews.data.draft && " · Draft"}
          </time>
          <a
            href="/news"
            aria-label="All news"
            class="shrink-0 whitespace-nowrap"
          >
            <span class="sm:hidden">All →</span>
            <span class="hidden sm:inline">All news →</span>
          </a>
        </aside>
      </div>
    )
  }
  <div class="app-layout">
    <section
      class="border-border border-b pt-6 pb-10 sm:py-14"
      aria-labelledby="intro-h"
    >
      <div class="max-w-3xl">
        <div class="mb-3 flex items-center gap-3 sm:mb-5">
          <Avatar size={56} eager class="max-sm:size-10!" />
          <p class="font-semibold">
            {SITE.name}<span
              class="text-muted-foreground block text-sm font-normal"
              >{SITE.jobTitle} · {city}{
                country && <span class="max-sm:hidden">, {country}</span>
              }</span
            >
          </p>
        </div>
        <h1 id="intro-h" class="h1">
          Uriel Papa: I&nbsp;see the problem. I&nbsp;build the solution.
          I&nbsp;grow the business.
        </h1>
        <p class="max-w-read mt-4 text-lg sm:mt-5">
          <strong
            >I'm Uriel Papa, a builder and founder from the Philippines, and I
            love technology.</strong
          >{" "}
          AI and programming are what excite me most, and I like finding out how things
          really work. Here I share what I've learned and the mistakes I've made as
          a founder, along with my takes on tech news and notes from seminars.
        </p>
        <button
          type="button"
          class="see-more mt-2 min-h-11 items-center font-semibold underline underline-offset-[3px]"
          aria-controls="intro-more"
          aria-expanded="false"
        >
          See more
        </button>
        <p id="intro-more" class="intro-more max-w-read mt-4 text-lg">
          That excitement comes down to a few simple things. Why technology? It
          keeps changing what's possible, and I like being close to that. Why
          programming? It lets me turn an idea into something people can
          actually use, and seeing it work is my favorite part. Why AI? It's
          changing how we build, learn and work faster than anyone can predict,
          and I want to understand how it really works instead of only using it.
          I'll be honest: I don't know what the future looks like, for my own
          work or for society, and I love that. The uncertainty is the exciting
          part, and I'd rather be in the middle of it, learning out loud.
        </p>
        <p class="mt-6 flex flex-wrap gap-3">
          <a href="/blog" class="btn btn-filled">Read the writing</a>
          <a href="/about" class="btn">About me</a>
        </p>
      </div>
    </section>

    <SiteStats />

    <section class="py-10" aria-labelledby="latest-h">
      <h2 id="latest-h" class="h2 mb-5">Latest writing</h2>
      {
        posts.length > 0 ? (
          <ul class="max-w-read">
            {posts.slice(0, 6).map(p => (
              <PostCard
                href={postUrl(p)}
                title={p.data.title}
                summary={p.data.dek}
                hub={p.data.hub}
                date={p.data.published}
                minutes={readingTime(p.body)}
                draft={p.data.draft}
              />
            ))}
          </ul>
        ) : (
          <p class="max-w-read">
            The first posts are being written. Subscribe below to get them when
            they're out.
          </p>
        )
      }
      <p class="mt-4"><a href="/blog">All writing →</a></p>
    </section>

    <section class="border-border border-t py-10" aria-labelledby="topics-h">
      <h2 id="topics-h" class="h2 mb-2">Topics</h2>
      <p class="max-w-read mb-6">
        Seven areas I write about, all about technology and what it changes.
      </p>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          HUBS.map(h => {
            const entry = hubEntries.find(e => e.id === h.id);
            return (
              <HubCard
                href={`/topics/${h.id}`}
                name={h.name}
                summary={entry?.data.summary ?? ""}
                count={hubCount(h.id)}
              />
            );
          })
        }
      </ul>
    </section>

    <div class="border-border grid gap-10 border-t py-10 md:grid-cols-2">
      <section aria-labelledby="notes-h">
        <h2 id="notes-h" class="h2 mb-4">Recent notes</h2>
        {
          notes.length > 0 ? (
            <ul>
              {notes.map(n => (
                <PostCard
                  href={noteUrl(n)}
                  title={n.data.title}
                  hub={n.data.hub}
                  date={n.data.published}
                  draft={n.data.draft}
                />
              ))}
            </ul>
          ) : (
            <p>Short notes and quick tips will show up here.</p>
          )
        }
        <p class="mt-4"><a href="/notes">All notes →</a></p>
      </section>

      <section aria-labelledby="events-h">
        <h2 id="events-h" class="h2 mb-4">Seminars and events</h2>
        {
          events.length > 0 ? (
            <ul>
              {events.map(e => (
                <PostCard
                  href={postUrl(e)}
                  title={e.data.title}
                  hub={e.data.hub}
                  date={e.data.published}
                  draft={e.data.draft}
                />
              ))}
            </ul>
          ) : (
            <p>Notes from the seminars and trainings I attend.</p>
          )
        }
        <p class="mt-4"><a href="/events">All events →</a></p>
      </section>
    </div>

    <NewsletterBox from="home" />
    <WorkWithMe
      text="Want to work together?"
      linkText="Get in touch →"
      from="home"
    />
  </div>
</Layout>

<style>
  /* The second intro paragraph starts collapsed under "See more", so the
     buttons sit right under the opening line. Without JavaScript (no .js class)
     it simply shows. */
  .see-more {
    display: none;
  }
  :global(.js) .see-more {
    display: inline-flex;
  }
  :global(.js) .intro-more {
    margin-top: 0.75rem;
  }
  :global(.js) .intro-more:not(.is-open) {
    display: none;
  }
</style>

<script>
  const more = document.getElementById("intro-more");
  const toggle = document.querySelector<HTMLButtonElement>(
    '[aria-controls="intro-more"]'
  );
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true";
    toggle.setAttribute("aria-expanded", String(open));
    toggle.textContent = open ? "See less" : "See more";
    more?.classList.toggle("is-open", open);
  });
</script>
