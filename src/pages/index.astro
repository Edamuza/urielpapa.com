---
import { getEntries, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { PERSON_ID } from "@/utils/schema";
import PostCard from "@/components/PostCard.astro";
import HubChip from "@/components/HubChip.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { Image } from "astro:assets";
import NewsletterBox from "@/components/NewsletterBox.astro";
import ProjectTile from "@/components/ProjectTile.astro";
import { PROOF, SITE, WORK_WITH_ME_HREF } from "@/config";
import { HUBS } from "@/data/hubs";
import {
  formatDate,
  getAllBlogEntries,
  getEventNotes,
  getNewsTakes,
  getNotes,
  getPosts,
  getProjects,
  isoDate,
  noteUrl,
  postUrl,
  readingTime,
} from "@/utils/content";
import { postThumb } from "@/utils/thumbnails";

const posts = await getPosts();
const allNews = await getNewsTakes();
const latestNews = allNews[0];
const railNews = allNews.slice(0, 5);
const [featured, ...morePosts] = posts.slice(0, 4);
const featuredThumb = featured && postThumb(featured);
const notes = (await getNotes()).slice(0, 3);
const events = (await getEventNotes()).slice(0, 2);
const allBlog = await getAllBlogEntries();
const allNotes = await getNotes();
// The home page shows the top 5 of my own projects (agency work is left to
// /projects) in a looping carousel: featured ones first, then the rest in their
// set order. The full list lives on /projects.
const projects = await getProjects();
const homeProjects = projects.filter(p => p.data.showOnHome);
const topProjects = [
  ...homeProjects.filter(p => p.data.featured),
  ...homeProjects.filter(p => !p.data.featured),
].slice(0, 5);
const topStacks = new Map(
  await Promise.all(
    topProjects.map(
      async p =>
        [
          p.id,
          (await getEntries(
            p.data.stack.slice(0, 4)
          )) as CollectionEntry<"stack">[],
        ] as const
    )
  )
);

const hubCount = (id: string) =>
  allBlog.filter(p => p.data.hub === id).length +
  allNotes.filter(n => n.data.hub === id).length;
// The line under the portrait: job title, city and country.
const [city, country] = SITE.location.split(", ");
---

<Layout
  webPage={{ about: { "@id": PERSON_ID }, mainEntity: { "@id": PERSON_ID } }}
>
  {
    latestNews && (
      <div class="app-layout">
        {/* Latest news take: always one line under the header; phones drop the date. */}
        <aside
          aria-label="Latest news take"
          class="border-border flex items-baseline gap-x-3 border-b py-2 text-sm max-lg:min-h-16 max-lg:items-center max-lg:pe-16 sm:py-3"
        >
          <span class="label-caps text-muted-foreground">News</span>
          <a
            href={postUrl(latestNews)}
            class="min-w-0 flex-1 truncate font-semibold"
          >
            {latestNews.data.title}
          </a>
          <time
            datetime={isoDate(latestNews.data.published)}
            class="text-muted-foreground hidden shrink-0 sm:inline"
          >
            {formatDate(latestNews.data.published)}
            {latestNews.data.draft && " · Draft"}
          </time>
          <a
            href="/news"
            aria-label="View all news"
            title="See all of Uriel Papa's news takes"
            class="shrink-0 whitespace-nowrap"
          >
            view all
          </a>
        </aside>
      </div>
    )
  }
  <div class="app-layout">
    <section
      class="hero-intro border-border border-b pt-6 pb-10 sm:py-14 lg:grid lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-12"
      aria-labelledby="intro-h"
    >
      <div class="hero-text max-w-3xl">
        <h1 id="intro-h" class="h1">
          I&nbsp;see the problem. I&nbsp;build the solution. I&nbsp;grow the
          business.
        </h1>
        <p class="hero-lead max-w-read mt-4 text-lg sm:mt-5">
          <strong
            >I help businesses get more customers and spend less time on manual
            work.</strong
          >{" "}
          I bring marketing, advertising, software and web development, and AI integration
          together, so you work with one person from the problem to a working system:
          a website that gets found, ads that bring in leads, software built around
          how your team works, and AI that takes repetitive tasks off your plate.
        </p>
        <a
          href="/about"
          class="see-more mt-2 inline-flex min-h-11 items-center font-semibold underline underline-offset-[3px]"
          title="Read more about Uriel Papa's background and experience"
          >See more</a
        >
        <p class="hero-actions mt-6 flex flex-wrap gap-3">
          <a
            href={WORK_WITH_ME_HREF}
            class="btn btn-filled"
            title="Work with Uriel Papa on a project or in a role"
            >Work with me</a
          >
          <a
            href="/projects"
            class="btn"
            title="See the projects Uriel Papa has built">See my projects</a
          >
        </p>
      </div>
      {
        /* Floating cut-out portrait. Large screens: beside the intro, with the
          name and title under it. Phones and tablets: between the title and the
          buttons, with a giant name behind it and the name and title over it. */
      }
      <figure class="hero-portrait">
        <span class="hero-portrait__bigname" aria-hidden="true">Uriel Papa</span
        >
        <div class="hero-portrait__float">
          <img
            src="/images/uriel-papa-portrait.webp"
            srcset="/images/uriel-papa-portrait-800.webp 800w, /images/uriel-papa-portrait.webp 1200w"
            sizes="(min-width: 1024px) 320px, 300px"
            width="1200"
            height="1787"
            alt="Uriel Papa smiling, wearing black-framed glasses, a dark charcoal suit and a white open-collar shirt"
            title="Uriel Papa"
            loading="eager"
            decoding="async"
            class="hero-portrait__img"
          />
        </div>
        <figcaption class="relative mt-3 text-center">
          <span class="block font-semibold">{SITE.name}</span>
          <span class="text-muted-foreground block text-sm"
            >{SITE.jobTitle}&nbsp;· {city}{country && `, ${country}`}</span
          >
        </figcaption>
      </figure>
    </section>

    <section class="border-border border-b py-10" aria-labelledby="proof-h">
      <h2 id="proof-h" class="label-caps text-muted-foreground mb-5">
        Proof of work
      </h2>
      <ul class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4">
        {
          PROOF.map(item => (
            <li class="border-foreground border-t-2 pt-3">
              <a
                href={item.href}
                class="block no-underline hover:underline"
                title={`See the case study: ${item.value} ${item.label}`}
              >
                <span class="font-display block text-2xl leading-tight font-bold sm:text-3xl">
                  {item.value}
                </span>
                <span class="meta mt-1 block">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      projects.length > 0 && (
        <section class="py-10" aria-labelledby="projects-h">
          <SectionHeader
            id="projects-h"
            title="Projects"
            href="/projects"
            linkText={`See all ${projects.length} →`}
            linkTitle="See all of Uriel Papa's projects and case studies"
            class="mb-2"
          />
          <p class="max-w-read text-muted-foreground mb-5">
            Projects I built outside my agency, each with a case study on the
            problem, the evidence and the results.
          </p>
          <div class="project-carousel relative" data-carousel>
            <div class="carousel-viewport overflow-hidden py-2">
              <ul
                class="carousel-track flex w-max gap-5"
                aria-label="Top projects"
              >
                {[false, true].map(clone =>
                  topProjects.map(p => (
                    <ProjectTile
                      project={p}
                      stack={topStacks.get(p.id)}
                      showFeatured
                      clone={clone}
                      sizes="(min-width: 640px) 16rem, 15rem"
                      class="carousel-card w-[15rem] shrink-0 sm:w-[16rem]"
                    />
                  ))
                )}
              </ul>
            </div>
          </div>
        </section>
      )
    }

    <div class="border-border with-rail border-t py-10">
      <section aria-labelledby="latest-h" class="min-w-0">
        <SectionHeader
          id="latest-h"
          title="Latest writing"
          href="/blog"
          linkText="All writing →"
          linkTitle="All of Uriel Papa's writing"
        />
        {
          featured ? (
            <>
              <article class="border-border grid gap-5 border-b pb-6 sm:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]">
                {featuredThumb && (
                  <a
                    href={postUrl(featured)}
                    tabindex="-1"
                    aria-hidden="true"
                    class="border-border bg-muted block self-start overflow-hidden rounded-lg border"
                    title={`Read: ${featured.data.title}`}
                  >
                    <Image
                      src={featuredThumb.src}
                      alt={featuredThumb.alt}
                      title={featuredThumb.title}
                      widths={[400, 640, 800]}
                      sizes="(min-width: 1024px) 24rem, (min-width: 640px) 50vw, 100vw"
                      class="aspect-[3/2] h-auto w-full object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                )}
                <div class="min-w-0">
                  <p class="label-caps text-muted-foreground">Newest</p>
                  <h3 class="h3 mt-2 text-xl leading-snug sm:text-2xl">
                    <a
                      href={postUrl(featured)}
                      title={`Read: ${featured.data.title}`}
                    >
                      {featured.data.title}
                    </a>
                  </h3>
                  <p class="mt-2">{featured.data.dek}</p>
                  <p class="meta mt-3 flex flex-wrap items-center gap-x-3 gap-y-1">
                    <HubChip hub={featured.data.hub} />
                    <time datetime={isoDate(featured.data.published)}>
                      {formatDate(featured.data.published)}
                    </time>
                    <span>{readingTime(featured.body)} min read</span>
                  </p>
                </div>
              </article>
              <ul class="pt-5">
                {morePosts.map(p => (
                  <PostCard
                    href={postUrl(p)}
                    title={p.data.title}
                    hub={p.data.hub}
                    date={p.data.published}
                    minutes={readingTime(p.body)}
                    draft={p.data.draft}
                    thumb={postThumb(p)}
                    variant="compact"
                  />
                ))}
              </ul>
            </>
          ) : (
            <p class="max-w-read">
              The first posts are being written. Subscribe below to get them
              when they're out.
            </p>
          )
        }
      </section>

      <aside class="flex flex-col gap-8" aria-label="News and topics">
        {
          railNews.length > 0 && (
            <section aria-labelledby="rail-news-h">
              <SectionHeader
                id="rail-news-h"
                title="Latest news"
                href="/news"
                linkText="All news →"
                linkTitle="All of Uriel Papa's news takes"
                level="h3"
                class="mb-2"
              />
              <ul>
                {railNews.map(n => (
                  <li class="border-border grid grid-cols-[3.5rem_minmax(0,1fr)] gap-3 border-t py-3">
                    <time
                      datetime={isoDate(n.data.published)}
                      class="text-muted-foreground pt-0.5 font-mono text-xs"
                    >
                      {formatDate(n.data.published, "D MMM")}
                    </time>
                    <a
                      href={postUrl(n)}
                      class="leading-snug font-medium"
                      title={`Read: ${n.data.title}`}
                    >
                      {n.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        <section aria-labelledby="topics-h">
          <SectionHeader
            id="topics-h"
            title="Topics"
            href="/topics"
            linkText="All topics →"
            linkTitle="The seven topics Uriel Papa writes about"
            level="h3"
            class="mb-3"
          />
          <ul class="flex flex-wrap gap-2">
            {
              HUBS.map(h => (
                <li>
                  <a
                    href={`/topics/${h.id}`}
                    class="border-foreground inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-sm font-medium no-underline hover:underline"
                    title={`${h.name}: ${hubCount(h.id)} posts by Uriel Papa`}
                  >
                    {h.name}
                    <span class="text-muted-foreground font-mono text-xs">
                      {hubCount(h.id)}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </aside>
    </div>

    <div class="border-border grid gap-10 border-t py-10 md:grid-cols-2">
      <section aria-labelledby="notes-h">
        <h2 id="notes-h" class="h2 mb-4">Recent notes</h2>
        {
          notes.length > 0 ? (
            <ul>
              {notes.map(n => (
                <PostCard
                  href={noteUrl(n)}
                  title={n.data.title}
                  hub={n.data.hub}
                  date={n.data.published}
                  draft={n.data.draft}
                />
              ))}
            </ul>
          ) : (
            <p>Short notes and quick tips will show up here.</p>
          )
        }
        <p class="mt-4"><a href="/notes">All notes →</a></p>
      </section>

      <section aria-labelledby="events-h">
        <h2 id="events-h" class="h2 mb-4">Seminars and events</h2>
        {
          events.length > 0 ? (
            <ul>
              {events.map(e => (
                <PostCard
                  href={postUrl(e)}
                  title={e.data.title}
                  hub={e.data.hub}
                  date={e.data.published}
                  draft={e.data.draft}
                />
              ))}
            </ul>
          ) : (
            <p>Notes from the seminars and trainings I attend.</p>
          )
        }
        <p class="mt-4"><a href="/events">All events →</a></p>
      </section>
    </div>

    <div class="grid gap-5 pt-4 pb-14 md:grid-cols-2">
      <NewsletterBox from="home" variant="rail" />
      <section
        class="bg-accent text-accent-foreground flex flex-col items-start rounded-lg p-5 sm:p-6"
        aria-labelledby="work-h"
      >
        <h2 id="work-h" class="h3">Have a problem worth solving?</h2>
        <p class="mt-1 flex-1 opacity-85">
          Web apps and business systems, AI automation and chatbots, and SEO or
          GEO set-up. I read every message myself.
        </p>
        <a
          href={WORK_WITH_ME_HREF}
          class="btn border-accent-foreground bg-accent-foreground text-accent mt-5"
          title="Work with Uriel Papa: send a message about your project"
          data-event="work_with_me_click"
          data-event-from="home"
        >
          Work with me →
        </a>
      </section>
    </div>
  </div>
</Layout>

<style>
  /* Hero portrait: a very soft radial glow behind it, a soft shadow so it
     looks like it floats, and a gentle 6s bob that stops for reduced motion.
     No light outline or strong white glow in dark mode, so no white shows
     around it on the near-black background. The jacket fades out at the
     bottom, right above the name. */
  .hero-portrait {
    --portrait-glow: rgb(0 0 0 / 0.07);
    --portrait-outline: rgb(0 0 0 / 0);
    --portrait-shadow: rgb(0 0 0 / 0.18);
    position: relative;
    isolation: isolate;
    width: 240px;
    margin: 2.5rem auto 0;
  }
  @media (min-width: 1024px) {
    .hero-portrait {
      width: 320px;
      margin: 0;
    }
  }
  :global([data-theme="dark"]) .hero-portrait {
    --portrait-glow: rgb(255 255 255 / 0.07);
    --portrait-outline: rgb(255 255 255 / 0);
    --portrait-shadow: rgb(0 0 0 / 0.6);
  }
  .hero-portrait::before {
    content: "";
    position: absolute;
    inset: 2% -22% 8%;
    z-index: -1;
    background: radial-gradient(
      ellipse 55% 50% at 50% 38%,
      var(--portrait-glow) 0%,
      transparent 72%
    );
    pointer-events: none;
  }
  /* The outline and shadow go on the wrapper, so the image's bottom fade
     (mask) doesn't clip them into a box. */
  .hero-portrait__float {
    animation: hero-float 6s ease-in-out infinite;
    filter: drop-shadow(0 0 1px var(--portrait-outline))
      drop-shadow(0 24px 40px var(--portrait-shadow));
  }
  .hero-portrait__img {
    display: block;
    width: 100%;
    height: auto;
    mask-image: linear-gradient(to bottom, #000 82%, transparent 100%);
  }
  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-portrait__float {
      animation: none;
    }
  }
  /* Phones and tablets: title, portrait, buttons, then the paragraph, so the
     title and both buttons are on the first screen. The text column flattens
     (display: contents) so its children can be reordered around the portrait,
     and the portrait's height follows the screen height. */
  /* Giant "URIEL PAPA" behind the portrait: faint grey in light mode, a white
     outline (no fill) in dark mode. */
  .hero-portrait__bigname {
    position: absolute;
    top: 6%;
    left: 0;
    right: 0;
    z-index: 0;
    width: min-content;
    margin-inline: auto;
    font-family: var(--ff-display);
    font-weight: 800;
    font-size: 6.5rem;
    line-height: 0.82;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-align: center;
    color: var(--foreground);
    opacity: 0.1;
    pointer-events: none;
    user-select: none;
  }
  :global([data-theme="dark"]) .hero-portrait__bigname {
    /* An outline drawn with shadows rather than text-stroke, which would also
       trace the font's overlapping inner contours. */
    --o: rgb(255 255 255 / 0.5);
    color: var(--background);
    text-shadow:
      1px 0 var(--o),
      -1px 0 var(--o),
      0 1px var(--o),
      0 -1px var(--o),
      1px 1px var(--o),
      -1px -1px var(--o),
      1px -1px var(--o),
      -1px 1px var(--o);
    opacity: 1;
  }
  .hero-portrait__float {
    position: relative;
    z-index: 1;
  }
  @media (max-width: 1023px) {
    .hero-intro {
      display: flex;
      flex-direction: column;
      padding-top: 1.25rem;
    }
    .hero-text {
      display: contents;
    }
    .hero-intro h1 {
      order: 1;
      font-size: clamp(1.6rem, 7vw, 2.25rem);
    }
    .hero-intro .hero-portrait {
      --portrait-h: clamp(215px, calc((100svh - 400px) * 0.95), 400px);
      order: 2;
      width: 100%;
      margin: 0.75rem 0 0;
      overflow-x: clip;
    }
    .hero-actions {
      order: 3;
      margin-top: 1rem;
    }
    .hero-lead {
      order: 4;
      margin-top: 1.75rem;
    }
    .see-more {
      order: 5;
      align-self: flex-start;
    }
    .hero-portrait::before {
      display: none;
    }
    .hero-portrait__bigname {
      font-size: min(29vw, calc(var(--portrait-h) * 0.4));
    }
    .hero-portrait__float {
      width: fit-content;
      margin-inline: auto;
      filter: drop-shadow(0 0 1px var(--portrait-outline));
    }
    .hero-portrait__img {
      width: auto;
      height: var(--portrait-h);
      mask-image: linear-gradient(to bottom, #000 70%, transparent 100%);
    }
    .hero-portrait figcaption {
      position: absolute;
      z-index: 2;
      left: 0;
      bottom: 0.25rem;
      margin: 0;
      text-align: left;
    }
    .hero-portrait figcaption > span:first-child {
      font-size: 1.25rem;
    }
  }
  /* Projects carousel: the list is rendered twice and the track slides left
     by one copy's width, so the loop never shows a seam. It pauses on hover and
     keyboard focus. On touch screens and narrow windows it does not move by
     itself: it swipes, snapping to each card with the next one peeking in
     (NN/g and Smashing advise against auto-rotation on phones). With reduced
     motion it doesn't move at all and scrolls by hand instead. */
  .carousel-viewport {
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 4%,
      #000 96%,
      transparent
    );
  }
  .carousel-track {
    animation: carousel-scroll 40s linear infinite;
  }
  .project-carousel:hover .carousel-track,
  .project-carousel:focus-within .carousel-track {
    animation-play-state: paused;
  }
  @keyframes carousel-scroll {
    to {
      /* One copy's width: half the track, plus half of one gap. */
      transform: translateX(calc(-50% - 0.625rem));
    }
  }
  @media (hover: none), (max-width: 639px), (prefers-reduced-motion: reduce) {
    .carousel-viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 1rem;
      margin-inline: -1rem;
      padding-inline: 1rem;
      scrollbar-width: none;
      mask-image: linear-gradient(to right, #000 85%, transparent);
    }
    .carousel-viewport::-webkit-scrollbar {
      display: none;
    }
    .carousel-track {
      animation: none;
    }
    .carousel-track > :global(.carousel-card) {
      scroll-snap-align: start;
    }
    .carousel-track > :global([aria-hidden="true"]) {
      display: none;
    }
  }
</style>
