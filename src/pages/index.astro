---
import Layout from "@/layouts/Layout.astro";
import Avatar from "@/components/Avatar.astro";
import PostCard from "@/components/PostCard.astro";
import HubCard from "@/components/HubCard.astro";
import NewsletterBox from "@/components/NewsletterBox.astro";
import WorkWithMe from "@/components/WorkWithMe.astro";
import { SITE } from "@/config";
import { HUBS } from "@/data/hubs";
import {
  formatDate,
  getAllBlogEntries,
  getEventNotes,
  getHubs,
  getNewsTakes,
  getNotes,
  getPosts,
  isoDate,
  noteUrl,
  postUrl,
  readingTime,
} from "@/utils/content";

const posts = await getPosts();
const news = (await getNewsTakes()).slice(0, 3);
const notes = (await getNotes()).slice(0, 3);
const events = (await getEventNotes()).slice(0, 2);
const hubEntries = await getHubs();
const allBlog = await getAllBlogEntries();
const allNotes = await getNotes();

const hubCount = (id: string) =>
  allBlog.filter(p => p.data.hub === id).length +
  allNotes.filter(n => n.data.hub === id).length;

const startWith = posts.filter(p => !p.data.draft).slice(0, 2);
---

<Layout>
  <div class="app-layout">
    <section
      class="border-border grid gap-10 border-b py-10 sm:py-14 lg:grid-cols-[minmax(0,1fr)_20rem]"
      aria-labelledby="intro-h"
    >
      <div class="max-w-read">
        <div class="mb-5 flex items-center gap-3">
          <Avatar size={56} eager />
          <p class="font-semibold">
            {SITE.name}<span
              class="text-muted-foreground block text-sm font-normal"
              >{SITE.jobTitle} · {SITE.location}</span
            >
          </p>
        </div>
        <h1 id="intro-h" class="h1">
          A technical founder rebuilding everything, and sharing the journey.
        </h1>
        <p class="mt-5 text-lg">
          <strong
            >I'm Uriel Papa, a technical founder from Metro Manila, and I love
            technology.</strong
          >{" "}
          AI and programming are what excite me most, and I like finding out how things
          really work. I'm rebuilding everything and sharing the journey here: what
          I've learned and the mistakes I've made as a founder, along with my takes
          on tech news and notes from seminars.
          {
            startWith.length > 0 && (
              <>
                {" "}
                New here? Start with{" "}
                {startWith.map((p, i) => (
                  <>
                    {i > 0 && " or "}
                    <a href={postUrl(p)}>{p.data.title}</a>
                  </>
                ))}
                .
              </>
            )
          }
        </p>
        <p class="mt-4 text-lg">
          That excitement comes down to a few simple things. Why technology? It
          keeps changing what's possible, and I like being close to that. Why
          programming? It lets me turn an idea into something people can
          actually use, and seeing it work is my favorite part. Why AI? It's
          changing how we build, learn and work faster than anyone can predict,
          and I want to understand how it really works instead of only using it.
          I'll be honest: I don't know what the future looks like, for my own
          work or for society, and I love that. The uncertainty is the exciting
          part, and I'd rather be in the middle of it, learning out loud.
        </p>
        <p class="mt-6 flex flex-wrap gap-3">
          <a href="/blog" class="btn">Read the writing</a>
          <a href="/about" class="btn">About me</a>
        </p>
        <p class="meta mt-6">
          What I've built: an ERP, an NFC card platform, a tourism portal,
          WordPress SEO plugins and AI chatbots. <a href="/about"
            >More about my work</a
          >.
        </p>
      </div>

      <aside
        aria-labelledby="home-news-h"
        class="border-border max-w-read rounded-lg border p-5 sm:p-6 lg:max-w-none lg:rounded-none lg:border-y-0 lg:border-e-0 lg:p-0 lg:ps-8"
      >
        <h2 id="home-news-h" class="h3 mb-3">Latest news takes</h2>
        {
          news.length > 0 ? (
            <ul class="space-y-4">
              {news.map(n => (
                <li>
                  <a href={postUrl(n)} class="font-semibold">
                    {n.data.title}
                  </a>
                  {/* The sidebar on wide screens stays compact; phones get the summary. */}
                  <p class="mt-1 line-clamp-2 text-[0.95rem] lg:hidden">
                    {n.data.dek}
                  </p>
                  <p class="meta mt-1">
                    <time datetime={isoDate(n.data.published)}>
                      {formatDate(n.data.published)}
                    </time>
                    {n.data.draft && " · Draft"}
                  </p>
                </li>
              ))}
            </ul>
          ) : (
            <p class="meta">
              Recent releases and announcements, with what they mean in
              practice. The first takes are on the way.
            </p>
          )
        }
        <p class="mt-4 text-sm"><a href="/news">All news →</a></p>
      </aside>
    </section>

    <section class="py-10" aria-labelledby="latest-h">
      <h2 id="latest-h" class="h2 mb-5">Latest writing</h2>
      {
        posts.length > 0 ? (
          <ul class="max-w-read">
            {posts.slice(0, 6).map(p => (
              <PostCard
                href={postUrl(p)}
                title={p.data.title}
                summary={p.data.dek}
                hub={p.data.hub}
                date={p.data.published}
                minutes={readingTime(p.body)}
                draft={p.data.draft}
              />
            ))}
          </ul>
        ) : (
          <p class="max-w-read">
            The first posts are being written. Subscribe below to get them when
            they're out.
          </p>
        )
      }
      <p class="mt-4"><a href="/blog">All writing →</a></p>
    </section>

    <section class="border-border border-t py-10" aria-labelledby="topics-h">
      <h2 id="topics-h" class="h2 mb-2">Topics</h2>
      <p class="max-w-read mb-6">
        Seven areas I write about, all about technology and what it changes.
      </p>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          HUBS.map(h => {
            const entry = hubEntries.find(e => e.id === h.id);
            return (
              <HubCard
                href={`/topics/${h.id}`}
                name={h.name}
                summary={entry?.data.summary ?? ""}
                count={hubCount(h.id)}
              />
            );
          })
        }
      </ul>
    </section>

    <div class="border-border grid gap-10 border-t py-10 md:grid-cols-2">
      <section aria-labelledby="notes-h">
        <h2 id="notes-h" class="h2 mb-4">Recent notes</h2>
        {
          notes.length > 0 ? (
            <ul>
              {notes.map(n => (
                <PostCard
                  href={noteUrl(n)}
                  title={n.data.title}
                  hub={n.data.hub}
                  date={n.data.published}
                  draft={n.data.draft}
                />
              ))}
            </ul>
          ) : (
            <p>Short notes and quick tips will show up here.</p>
          )
        }
        <p class="mt-4"><a href="/notes">All notes →</a></p>
      </section>

      <section aria-labelledby="events-h">
        <h2 id="events-h" class="h2 mb-4">Seminars and events</h2>
        {
          events.length > 0 ? (
            <ul>
              {events.map(e => (
                <PostCard
                  href={postUrl(e)}
                  title={e.data.title}
                  hub={e.data.hub}
                  date={e.data.published}
                  draft={e.data.draft}
                />
              ))}
            </ul>
          ) : (
            <p>Notes from the seminars and trainings I attend.</p>
          )
        }
        <p class="mt-4"><a href="/events">All events →</a></p>
      </section>
    </div>

    <NewsletterBox from="home" />
    <WorkWithMe
      text="Want to work together?"
      linkText="Get in touch →"
      from="home"
    />
  </div>
</Layout>
