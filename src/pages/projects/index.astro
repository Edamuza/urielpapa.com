---
import { getEntries, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageIntro from "@/components/PageIntro.astro";
import WorkWithMe from "@/components/WorkWithMe.astro";
import FeaturedProject from "@/components/FeaturedProject.astro";
import { getProjects, projectUrl } from "@/utils/content";
import { breadcrumbNode, collectionNode } from "@/utils/schema";

const projects = await getProjects();
const stacks = new Map(
  await Promise.all(
    projects.map(
      async p =>
        [
          p.id,
          (await getEntries(
            p.data.stack.slice(0, 5)
          )) as CollectionEntry<"stack">[],
        ] as const
    )
  )
);

// Featured projects come first as large cards, then apps built with Lovable,
// then the systems built with my teams.
const featured = projects.filter(p => p.data.featured);
const listed = projects.filter(p => !p.data.featured);
const builtWithLovable = (p: (typeof projects)[number]) =>
  p.data.stack.some(s => s.id === "lovable");
const groups = [
  {
    id: "lovable",
    heading: "AI apps built with Lovable",
    intro:
      "I built these by directing AI agents in Lovable. Each one is live with fictional sample data, and each case study shows how it was tested.",
    items: listed.filter(builtWithLovable),
  },
  {
    id: "systems",
    heading: "Systems and products",
    intro:
      "Work I built with my teams. Most were internal systems, so they're described rather than linked.",
    items: listed.filter(p => !builtWithLovable(p)),
  },
].filter(g => g.items.length > 0);

const title = "Projects";
const intro =
  "Things I've built, from AI apps I made in Lovable to the ERP I led at my agency. Each one has a case study on the problem, the evidence and the results.";
const crumbs = [
  { name: "Home", href: "/" },
  { name: title, href: "/projects" },
];
const schema = [
  collectionNode({
    path: "/projects",
    name: title,
    description: intro,
    items: projects.map(p => ({ name: p.data.title, href: projectUrl(p) })),
  }),
  breadcrumbNode(crumbs),
];
---

<Layout
  title="Projects"
  description="Projects Uriel Papa has built: five AI apps made in Lovable, an ERP, an NFC card platform, the TravelEase tourism portal, WordPress SEO plugins and more."
  schema={schema}
>
  <div class="app-layout pt-8">
    <Breadcrumbs crumbs={crumbs} />
    <PageIntro title={title} intro={intro} />
    {
      featured.length > 0 && (
        <section aria-labelledby="featured-h" class="mb-10">
          <h2 id="featured-h" class="sr-only">
            Featured
          </h2>
          <div class="grid gap-4">
            {featured.map(p => (
              <FeaturedProject project={p} />
            ))}
          </div>
        </section>
      )
    }
    {
      groups.map(g => (
        <section aria-labelledby={`${g.id}-h`} class="mb-10">
          <h2 id={`${g.id}-h`} class="h2 mb-2">
            {g.heading}
          </h2>
          <p class="max-w-read text-muted-foreground mb-4">{g.intro}</p>
          <ul class="max-w-read">
            {g.items.map(p => {
              const stack = stacks.get(p.id) ?? [];
              return (
                <li class="border-border border-b py-5 first:pt-0">
                  <h3 class="text-xl font-semibold">
                    <a href={projectUrl(p)}>{p.data.title}</a>{" "}
                    <span class="meta font-normal">{p.data.year}</span>
                  </h3>
                  <p class="mt-1">{p.data.outcome}</p>
                  {p.data.liveUrl && (
                    <p class="mt-1 text-sm font-semibold">
                      <a href={p.data.liveUrl} rel="noopener">
                        Live: {new URL(p.data.liveUrl).hostname} ↗
                      </a>
                    </p>
                  )}
                  {stack.length > 0 && (
                    <ul class="mt-2 flex flex-wrap gap-2">
                      {stack.map(s => (
                        <li>
                          <a
                            href={`/stack#${s.id}`}
                            class="bg-muted inline-block rounded-full px-2.5 py-0.5 text-xs no-underline hover:underline"
                          >
                            {s.data.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
    <WorkWithMe
      text="Want to work together?"
      linkText="Get in touch."
      from="projects"
    />
  </div>
</Layout>
