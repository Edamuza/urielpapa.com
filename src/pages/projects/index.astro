---
import { getEntries, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageIntro from "@/components/PageIntro.astro";
import FeaturedProject from "@/components/FeaturedProject.astro";
import ProjectTile from "@/components/ProjectTile.astro";
import { getProjects, projectUrl } from "@/utils/content";
import { breadcrumbNode, collectionNode } from "@/utils/schema";

const projects = await getProjects();
const stacks = new Map(
  await Promise.all(
    projects.map(
      async p =>
        [
          p.id,
          (await getEntries(
            p.data.stack.slice(0, 5)
          )) as CollectionEntry<"stack">[],
        ] as const
    )
  )
);

// Featured projects come first as large cards, then apps built with Lovable,
// then the systems built with my teams.
const featured = projects.filter(p => p.data.featured);
const listed = projects.filter(p => !p.data.featured);
const builtWithLovable = (p: (typeof projects)[number]) =>
  p.data.stack.some(s => s.id === "lovable");
const groups = [
  {
    id: "lovable",
    heading: "AI apps built with Lovable",
    intro:
      "I built these by directing AI agents in Lovable. Each one is live with fictional sample data, and each case study shows how it was tested.",
    items: listed.filter(builtWithLovable),
    note: {
      title: "How I built them",
      text: "For each app, one AI agent turned my brief into a spec and built it in Lovable. A separate QA agent then tested the live app in a real browser, and the bugs it found were fixed.",
    },
  },
  {
    id: "systems",
    heading: "Systems and products",
    intro:
      "Systems I built with my teams or on my own, from an agency ERP to tools for my own Mac. Most are private, so their case studies describe them in detail.",
    items: listed.filter(p => !builtWithLovable(p)),
    note: {
      title: "Building something like this?",
      text: "I take on systems, automation and AI work for businesses. Tell me what you need and I'll tell you how I'd build it.",
      cta: "Let's talk →",
    },
  },
].filter(g => g.items.length > 0);

const title = "Projects";
const intro =
  "Things I've built, from my own job and client CRM and Mac tools to AI apps made in Lovable and the ERP I led at my agency. Each one has a case study on the problem, the evidence and the results.";
const crumbs = [
  { name: "Home", href: "/" },
  { name: title, href: "/projects" },
];
const schema = [
  collectionNode({
    path: "/projects",
    name: title,
    description: intro,
    items: projects.map(p => ({ name: p.data.title, href: projectUrl(p) })),
  }),
  breadcrumbNode(crumbs),
];
---

<Layout
  title="Projects"
  description="Projects Uriel Papa has built: a job and client CRM, the Zeke Mac update tool, five AI apps made in Lovable, an ERP, the TravelEase portal and more."
  schema={schema}
>
  <div class="app-layout pt-8">
    <Breadcrumbs crumbs={crumbs} />
    <PageIntro title={title} intro={intro} />
    {
      featured.length > 0 && (
        <section aria-labelledby="featured-h" class="mb-14">
          <h2 id="featured-h" class="sr-only">
            Featured projects
          </h2>
          <div class="grid gap-5">
            {featured.map(p => (
              <FeaturedProject project={p} stack={stacks.get(p.id)} />
            ))}
          </div>
        </section>
      )
    }
    {
      groups.map(g => (
        <section aria-labelledby={`${g.id}-h`} class="mb-14">
          <div class="mb-5 flex flex-wrap items-end justify-between gap-x-6 gap-y-1">
            <h2 id={`${g.id}-h`} class="h2">
              {g.heading}
            </h2>
            <p class="meta">
              {g.items.length} project{g.items.length === 1 ? "" : "s"}
            </p>
          </div>
          <p class="max-w-read text-muted-foreground -mt-2 mb-6">{g.intro}</p>
          <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map(p => (
              <ProjectTile project={p} stack={stacks.get(p.id)} />
            ))}
            {g.note && (
              <li class="bg-muted flex flex-col justify-end rounded-xl p-6">
                <h3 class="h3">{g.note.title}</h3>
                <p class="mt-2 text-[0.95rem] leading-relaxed">{g.note.text}</p>
                {"cta" in g.note && (
                  <p class="mt-4">
                    <a
                      href="/contact#work"
                      class="btn btn-filled"
                      data-event="work_with_me_click"
                      data-event-from="projects"
                    >
                      {g.note.cta}
                    </a>
                  </p>
                )}
              </li>
            )}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>
