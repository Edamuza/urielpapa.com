---
import ShortListPage from "@/components/listings/ShortListPage.astro";
import { getReleases } from "@/utils/content";
import { laterPages } from "@/utils/pagination";

export async function getStaticPaths() {
  return laterPages((await getReleases()).length);
}

const { page } = Astro.props;
---

<ShortListPage kind="releases" page={page} />
