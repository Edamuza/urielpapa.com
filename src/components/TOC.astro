---
import type { MarkdownHeading } from "astro";

type Props = { headings: MarkdownHeading[] };
const items = Astro.props.headings.filter(h => h.depth === 2);
---

{
  items.length > 2 && (
    <nav aria-labelledby="toc-h" class="my-8 xl:sticky xl:top-36 xl:my-0">
      <h2 id="toc-h" class="label-caps text-muted-foreground mb-2 font-sans">
        On this page
      </h2>
      <ul class="space-y-1.5 text-[0.95rem]">
        {items.map(h => (
          <li>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
