---
/**
 * MDX: <SocialPost platform="x" url="https://x.com/user/status/123" author="Name"
 *   handle="user" date="2026-10-25" text="The post's text, copied exactly."
 *   media={[{ src: "https://pbs.twimg.com/media/ID.jpg", alt: "…", width: 1200, height: 800 }]}
 *   card={{ url: "https://…", title: "…", domain: "example.com", image: "https://…", imageAlt: "…" }} />
 * Shows a static card first: the verified text (links and @mentions clickable),
 * the post's photos or video poster, its link preview, who posted it and when.
 * Photos come from X's image server, like YouTube thumbnails do. "Show the post
 * on X/Threads" swaps in the platform's own embed (video, replies, the thread);
 * X's or Threads' script loads only for readers who click. Without JavaScript
 * the links open the post on the platform.
 */
import X from "@/assets/icons/socials/x.svg";
import Threads from "@/assets/icons/socials/threads.svg";
import { formatDate } from "@/utils/content";

type Media = {
  type?: "photo" | "video";
  src: string;
  alt: string;
  width: number;
  height: number;
};
type Card = {
  url: string;
  title: string;
  description?: string;
  domain: string;
  image?: string;
  imageAlt?: string;
};
type Props = {
  platform: "x" | "threads";
  url: string;
  author: string;
  handle: string;
  date: string;
  text: string;
  media?: Media[];
  card?: Card;
};
const { platform, url, author, handle, date, text, card } = Astro.props;
const media = (Astro.props.media ?? []).filter(m => m.src).slice(0, 4);
const site = platform === "threads" ? "Threads" : "X";
const Icon = platform === "threads" ? Threads : X;
const paragraphs = text.split(/\n{2,}|\n/).filter(Boolean);
const when = formatDate(new Date(date), "D MMM YYYY");
const profile = (h: string) =>
  platform === "threads"
    ? `https://www.threads.net/@${h}`
    : `https://x.com/${h}`;

// Split a paragraph into text, links and @mentions, the way the platform shows them.
type Part = { text: string; href?: string; title?: string };
const parts = (p: string): Part[] =>
  p
    .split(/(https?:\/\/[^\s]+[^\s.,;:!?)]|(?<![\w@])@\w{1,30})/)
    .filter(Boolean)
    .map(t =>
      t.startsWith("http")
        ? {
            text: t.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, ""),
            href: t,
            title: `Link in ${author}'s post: ${t}`,
          }
        : /^@\w+$/.test(t)
          ? { text: t, href: profile(t.slice(1)), title: `${t} on ${site}` }
          : { text: t }
    );

// X serves each photo in several sizes; other hosts get the URL as given.
const sized = (src: string, name: string) =>
  src.includes("pbs.twimg.com/media/")
    ? `${src.split("?")[0]}?format=jpg&name=${name}`
    : src;
const photoUrl = (i: number) =>
  platform === "x" ? `${url}/photo/${i + 1}` : url;
const grid =
  media.length === 1
    ? ""
    : media.length === 3
      ? "grid grid-cols-2 grid-rows-2 gap-0.5 aspect-[16/9]"
      : "grid grid-cols-2 gap-0.5 aspect-[16/9]";
---

<figure class="not-prose my-8" data-social-post={platform} data-url={url}>
  <div data-social-embed class="hidden"></div>
  <blockquote
    data-social-card
    cite={url}
    class="border-border rounded-lg border p-5 text-base leading-relaxed"
  >
    <p class="mb-3 flex items-center gap-2 text-sm">
      <Icon class="size-4 shrink-0" aria-hidden="true" />
      <span class="font-semibold">{author}</span>
      <span class="text-muted-foreground">@{handle}</span>
    </p>
    {
      paragraphs.map(p => (
        <p class="mt-2 break-words first:mt-0">
          {parts(p).map(part =>
            part.href ? (
              <a href={part.href} title={part.title} rel="noopener">
                {part.text}
              </a>
            ) : (
              part.text
            )
          )}
        </p>
      ))
    }
    {
      media.length > 0 && (
        <div
          class:list={[
            "border-border mt-4 overflow-hidden rounded-lg border",
            grid,
          ]}
        >
          {media.map((m, i) => (
            <a
              href={photoUrl(i)}
              title={
                m.type === "video"
                  ? `Play the video from ${author}'s post on ${site}`
                  : `Photo ${i + 1} of ${media.length} in ${author}'s post, on ${site}`
              }
              rel="noopener"
              data-social-play={m.type === "video" ? "" : undefined}
              class:list={[
                "relative block bg-black/5",
                media.length === 3 && i === 0 && "row-span-2",
              ]}
            >
              <img
                src={sized(m.src, media.length === 1 ? "medium" : "small")}
                srcset={
                  m.src.includes("pbs.twimg.com/media/")
                    ? `${sized(m.src, "small")} 680w, ${sized(m.src, "medium")} 1200w`
                    : undefined
                }
                sizes="(min-width: 768px) 680px, 100vw"
                alt={m.alt}
                title={m.alt}
                width={m.width}
                height={m.height}
                loading="lazy"
                decoding="async"
                class:list={[
                  media.length === 1
                    ? "max-h-[44rem] w-full object-cover object-top"
                    : "size-full object-cover",
                ]}
              />
              {m.type === "video" && (
                <span
                  class="absolute inset-0 flex items-center justify-center"
                  aria-hidden="true"
                >
                  <span class="flex size-14 items-center justify-center rounded-full bg-black/75">
                    <svg viewBox="0 0 24 24" class="ms-1 size-7 fill-white">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </span>
                </span>
              )}
            </a>
          ))}
        </div>
      )
    }
    {
      card?.url && (
        <a
          href={card.url}
          title={`${card.title}, on ${card.domain}`}
          rel="noopener"
          class="border-border mt-4 block overflow-hidden rounded-lg border no-underline hover:bg-black/5"
        >
          {card.image && (
            <img
              src={card.image}
              alt={card.imageAlt || `Preview image for ${card.title}`}
              title={card.imageAlt || card.title}
              width="600"
              height="314"
              loading="lazy"
              decoding="async"
              class="aspect-[1.91/1] w-full object-cover"
            />
          )}
          <span class="block px-4 py-3">
            <span class="text-muted-foreground block text-sm">
              {card.domain}
            </span>
            <span class="block font-medium">{card.title}</span>
            {card.description && (
              <span class="text-muted-foreground mt-1 block text-sm">
                {card.description}
              </span>
            )}
          </span>
        </a>
      )
    }
  </blockquote>
  <figcaption class="meta mt-2 flex flex-wrap items-center gap-x-4 gap-y-2">
    <a href={url} title={`${author} on ${site}, ${when}`}
      >Post by {author} (@{handle}) on {site}, {when}</a
    >
    <button
      type="button"
      data-social-load
      class="border-border rounded-lg border px-3 py-1.5 font-medium hover:underline"
    >
      Show the post on {site}
    </button>
  </figcaption>
  <p data-social-status class="meta mt-1" role="status" aria-live="polite"></p>
</figure>

<script>
  const scripts: Record<string, Promise<void>> = {};
  const loadScript = (src: string) =>
    (scripts[src] ??= new Promise((resolve, reject) => {
      const el = document.createElement("script");
      el.src = src;
      el.async = true;
      el.onload = () => resolve();
      el.onerror = () => reject(new Error(`Could not load ${src}`));
      document.head.appendChild(el);
    }));

  type Twttr = {
    widgets: {
      createTweet: (
        id: string,
        target: HTMLElement,
        options: Record<string, string>
      ) => Promise<HTMLElement | undefined>;
    };
  };

  async function showX(url: string, target: HTMLElement) {
    await loadScript("https://platform.twitter.com/widgets.js");
    const twttr = (window as unknown as { twttr?: Twttr }).twttr;
    const id = url.match(/status\/(\d+)/)?.[1];
    if (!twttr || !id) return false;
    const theme =
      document.documentElement.getAttribute("data-theme") === "dark"
        ? "dark"
        : "light";
    const el = await twttr.widgets.createTweet(id, target, {
      dnt: "true",
      theme,
      align: "center",
    });
    return Boolean(el);
  }

  async function showThreads(url: string, target: HTMLElement) {
    const quote = document.createElement("blockquote");
    quote.className = "text-post-media";
    quote.setAttribute("data-text-post-permalink", url);
    quote.setAttribute("data-text-post-version", "0");
    const link = document.createElement("a");
    link.href = url;
    link.title = "View this post on Threads";
    link.textContent = "View this post on Threads";
    quote.appendChild(link);
    target.appendChild(quote);
    // Threads' script turns every blockquote on the page into an embed when it
    // runs, so load a fresh copy for each post that is opened.
    await new Promise<void>((resolve, reject) => {
      const el = document.createElement("script");
      el.src = `https://www.threads.net/embed.js?t=${Date.now()}`;
      el.async = true;
      el.onload = () => resolve();
      el.onerror = () => reject(new Error("Could not load Threads"));
      document.head.appendChild(el);
    });
    for (let i = 0; i < 40; i++) {
      if (target.querySelector("iframe")) return true;
      await new Promise(r => setTimeout(r, 200));
    }
    return false;
  }

  for (const figure of document.querySelectorAll<HTMLElement>(
    "[data-social-post]"
  )) {
    const button =
      figure.querySelector<HTMLButtonElement>("[data-social-load]");
    const card = figure.querySelector<HTMLElement>("[data-social-card]");
    const target = figure.querySelector<HTMLElement>("[data-social-embed]");
    const status = figure.querySelector<HTMLElement>("[data-social-status]");
    const platform = figure.dataset.socialPost;
    const url = figure.dataset.url ?? "";
    // A video poster starts the platform's own player instead of leaving the page.
    for (const poster of figure.querySelectorAll<HTMLElement>(
      "[data-social-play]"
    ))
      poster.addEventListener("click", event => {
        if (!button || button.disabled) return;
        event.preventDefault();
        button.click();
      });
    button?.addEventListener("click", async () => {
      if (!target || !card) return;
      button.disabled = true;
      if (status) status.textContent = "Loading the post…";
      target.classList.remove("hidden");
      try {
        const ok =
          platform === "threads"
            ? await showThreads(url, target)
            : await showX(url, target);
        if (!ok) throw new Error("not rendered");
        card.remove();
        button.remove();
        if (status) status.textContent = "";
      } catch {
        target.replaceChildren();
        target.classList.add("hidden");
        button.disabled = false;
        if (status)
          status.textContent =
            "The post couldn't load here (a blocker or the platform may be down). The link above opens it directly.";
      }
    });
  }
</script>
