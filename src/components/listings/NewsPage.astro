---
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageIntro from "@/components/PageIntro.astro";
import HubChip from "@/components/HubChip.astro";
import { HUBS } from "@/data/hubs";
import NewsletterBox from "@/components/NewsletterBox.astro";
import Pagination from "@/components/Pagination.astro";
import { formatDate, getNewsTakes, isoDate, postUrl } from "@/utils/content";
import { breadcrumbNode, collectionNode } from "@/utils/schema";
import { pageCount, pageHref, pageItems } from "@/utils/pagination";

type Props = { page: number };
const { page } = Astro.props;

const allNews = await getNewsTakes();
const pages = pageCount(allNews.length);
const news = pageItems(allNews, page);
const path = pageHref("/news", page);
const pageLabel = page > 1 ? `Page ${page} of ${pages}` : "";
const title = "Tech News, with Context";
// Later pages get their own heading and a dated intro, so no two pages share an H1 or description.
const span =
  news.length > 0
    ? [
        formatDate(news[news.length - 1].data.published, "D MMMM"),
        formatDate(news[0].data.published, "D MMMM YYYY"),
      ].join(" to ")
    : "";
const heading = page > 1 ? `${title}: Page ${page}` : title;
const intro =
  page > 1
    ? `Older news takes, from ${span}: what happened, what changed and what it means in practice.`
    : "Recent releases and announcements in the topics I write about, and what they mean in practice.";
const crumbs = [
  { name: "Home", href: "/" },
  { name: "News", href: "/news" },
  ...(page > 1 ? [{ name: `Page ${page}`, href: path }] : []),
];

/** "openai.com" from the announcement's URL, shown as the take's source. */
const sourceHost = (url?: string) => {
  if (!url) return undefined;
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return undefined;
  }
};

const months = new Map<string, typeof news>();
for (const n of news) {
  const key = formatDate(n.data.published, "MMMM YYYY");
  months.set(key, [...(months.get(key) ?? []), n]);
}

const schema = [
  collectionNode({
    path,
    name: pageLabel ? `${title}, ${pageLabel.toLowerCase()}` : title,
    description: intro,
    items: news.map(n => ({ name: n.data.title, href: postUrl(n) })),
  }),
  breadcrumbNode(crumbs),
];
---

<Layout
  title={`Tech News, with Context${pageLabel ? ` (${pageLabel})` : ""}`}
  description={pageLabel
    ? `Uriel Papa's takes on AI, framework, search and marketing news from ${span}. ${pageLabel}.`
    : "Uriel Papa's takes on recent AI, framework, search and marketing news: what happened, what changed, why it matters and what to do about it."}
  schema={schema}
>
  <div class="app-layout pt-8">
    <Breadcrumbs crumbs={crumbs} />
    <PageIntro title={heading} intro={intro}>
      {pageLabel && <p class="meta mt-2">{pageLabel}</p>}
    </PageIntro>
    <div class="with-rail">
      <div class="min-w-0">
        {
          news.length === 0 ? (
            <p class="max-w-read">The first news takes are on the way.</p>
          ) : (
            [...months].map(([month, items]) => (
              <section class="mb-10">
                <h2 class="h3 border-foreground bg-background sticky top-0 z-10 border-b py-2">
                  {month}
                </h2>
                <ul>
                  {items.map(n => {
                    const host = sourceHost(n.data.sourceUrl);
                    return (
                      <li class="border-border grid grid-cols-[4.25rem_minmax(0,1fr)] gap-4 border-b py-4 last:border-b-0 sm:grid-cols-[5.5rem_minmax(0,1fr)] sm:gap-6">
                        <time
                          datetime={isoDate(n.data.published)}
                          class="text-muted-foreground font-mono text-sm leading-snug"
                        >
                          {formatDate(n.data.published, "D MMM")}
                          <span class="block text-xs">
                            {formatDate(n.data.published, "ddd")}
                          </span>
                        </time>
                        <div class="min-w-0">
                          <h3 class="text-lg leading-snug font-semibold">
                            <a
                              href={postUrl(n)}
                              title={`Read: ${n.data.title}`}
                            >
                              {n.data.title}
                            </a>
                          </h3>
                          <p class="mt-1 text-[0.95rem]">{n.data.dek}</p>
                          <p class="meta mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
                            <HubChip hub={n.data.hub} />
                            {host && <span>Source: {host}</span>}
                            {n.data.draft && (
                              <span class="border-foreground rounded border border-dashed px-1.5 text-xs font-semibold">
                                Draft
                              </span>
                            )}
                          </p>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </section>
            ))
          )
        }
        <Pagination base="/news" page={page} pages={pages} label="News" />
      </div>
      <aside class="flex flex-col gap-6 lg:pb-12" aria-label="About news takes">
        <section class="rail-box" aria-labelledby="what-h">
          <h2 id="what-h" class="h3 mb-2">What's a news take?</h2>
          <p>
            A short post on one announcement: what happened, what changed, why
            it matters and what I think. Longer explainers live in <a
              href="/blog"
              title="All of Uriel Papa's long posts">Writing</a
            >.
          </p>
        </section>
        <section class="rail-box" aria-labelledby="news-topics-h">
          <h2 id="news-topics-h" class="h3 mb-3">Browse by topic</h2>
          <ul class="flex flex-wrap gap-2">
            {
              HUBS.map(h => (
                <li>
                  <HubChip hub={h.id} />
                </li>
              ))
            }
          </ul>
        </section>
        <NewsletterBox
          from="news-index"
          heading="Get the news by email"
          variant="rail"
        />
      </aside>
    </div>
  </div>
</Layout>
