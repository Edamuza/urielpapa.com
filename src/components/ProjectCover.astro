---
// A project's featured image, or a plain panel with its initials when the
// project has no image yet.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

type Props = {
  title: string;
  src?: ImageMetadata;
  alt?: string;
  widths: number[];
  sizes: string;
  class?: string;
};
const { title, src, alt, widths, sizes, class: className } = Astro.props;

const initials = title
  .split(/\s+/)
  .filter(w => /^[A-Za-z]/.test(w))
  .slice(0, 2)
  .map(w => w[0].toUpperCase())
  .join("");
---

{
  src ? (
    <Image
      src={src}
      alt={alt ?? ""}
      title={alt ?? ""}
      widths={widths}
      sizes={sizes}
      class:list={["aspect-[16/10] object-cover object-top", className]}
    />
  ) : (
    <div
      class:list={[
        "bg-muted text-muted-foreground font-display flex aspect-[16/10] items-center justify-center font-bold",
        className,
      ]}
      aria-hidden="true"
    >
      {initials}
    </div>
  )
}
