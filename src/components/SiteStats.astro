---
/**
 * Home page stats, all counted at build from the site's own content (see
 * src/lib/site-stats.ts): published posts, pages in the sitemap, days since
 * launch and outside sources cited.
 */
import { formatDate, getAllBlogEntries } from "@/utils/content";
import {
  countPages,
  countSources,
  daysSinceLaunch,
  LAUNCH_DATE,
} from "@/lib/site-stats";

const entries = await getAllBlogEntries();
const newsCount = entries.filter(p => p.data.frame === "news-take").length;
const days = daysSinceLaunch();
const sources = await countSources();
const pages = await countPages();
const fmt = (n: number) => n.toLocaleString("en-US");
const since = formatDate(new Date(LAUNCH_DATE));
const built = formatDate(new Date());
---

<section class="border-border border-t py-10" aria-labelledby="stats-h">
  <h2 id="stats-h" class="h2 mb-2">The site in numbers</h2>
  <p class="max-w-read mb-6">
    How urielpapa.com is doing since it launched on {since}.
  </p>
  <dl class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="border-foreground/80 rounded-lg border p-4">
      <dt class="label-caps text-muted-foreground">Days since launch</dt>
      <dd class="font-display mt-1 text-3xl font-bold">{fmt(days)}</dd>
      <dd class="meta mt-1">Live since {since}</dd>
    </div>
    <div class="border-foreground/80 rounded-lg border p-4">
      <dt class="label-caps text-muted-foreground">Blog posts</dt>
      <dd class="font-display mt-1 text-3xl font-bold">
        {fmt(entries.length)}
      </dd>
      <dd class="meta mt-1">Including {fmt(newsCount)} news takes</dd>
    </div>
    <div class="border-foreground/80 rounded-lg border p-4">
      <dt class="label-caps text-muted-foreground">Pages</dt>
      <dd class="font-display mt-1 text-3xl font-bold">{fmt(pages)}</dd>
      <dd class="meta mt-1">In the sitemap</dd>
    </div>
    <div class="border-foreground/80 rounded-lg border p-4">
      <dt class="label-caps text-muted-foreground">Sources cited</dt>
      <dd class="font-display mt-1 text-3xl font-bold">{fmt(sources)}</dd>
      <dd class="meta mt-1">Outside pages linked in posts</dd>
    </div>
  </dl>
  <p class="meta mt-4">Updated {built}.</p>
</section>
