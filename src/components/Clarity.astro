---
/**
 * Microsoft Clarity: heatmaps, session recordings and behaviour signals
 * (rage clicks, dead clicks, scroll depth). Clarity's own snippet, loaded
 * like GA4 on the first scroll, tap, key press or mouse move (or when the
 * visitor switches away), never on a timer, so it never runs during page
 * load. In the EEA, the UK and Switzerland Clarity runs without cookies
 * unless consent is given, so no banner is needed for it.
 */
type Props = { id: string };
const { id } = Astro.props;
---

<script is:inline define:vars={{ id }}>
  (function (c, l, a, r, i) {
    c[a] =
      c[a] ||
      function () {
        // Clarity's queue expects the arguments object itself.
        // eslint-disable-next-line prefer-rest-params
        (c[a].q = c[a].q || []).push(arguments);
      };
    let loaded = false;
    const load = () => {
      if (loaded) return;
      loaded = true;
      const t = l.createElement(r);
      t.async = true;
      t.src = "https://www.clarity.ms/tag/" + i;
      const y = l.getElementsByTagName(r)[0];
      y.parentNode.insertBefore(t, y);
    };
    ["scroll", "pointerdown", "pointermove", "keydown", "touchstart"].forEach(
      e => addEventListener(e, load, { once: true, passive: true })
    );
    l.addEventListener("visibilitychange", () => {
      if (l.visibilityState === "hidden") load();
    });
  })(window, document, "clarity", "script", id);
</script>
