---
import IconRss from "@/assets/icons/IconRss.svg";
import SocialIcon from "@/components/SocialIcon.astro";
import Avatar from "./Avatar.astro";
import { SITE, SOCIALS, TRUST_BADGES } from "@/config";
import { HUBS } from "@/data/hubs";

const year = new Date().getFullYear();

const siteLinks = [
  { href: "/blog", label: "Writing", title: "All of Uriel Papa's writing" },
  { href: "/notes", label: "Notes", title: "Short notes and quick tips" },
  { href: "/news", label: "News", title: "Uriel Papa's takes on tech news" },
  {
    href: "/events",
    label: "Events",
    title: "Notes from seminars, expos and events",
  },
  {
    href: "/answers",
    label: "Answers",
    title: "Short answers to common questions",
  },
  {
    href: "/glossary",
    label: "Glossary",
    title: "Glossary of AI, automation and SEO terms",
  },
  {
    href: "/releases",
    label: "Releases",
    title: "Release notes for the tools Uriel Papa follows",
  },
  {
    href: "/projects",
    label: "Projects",
    title: "Uriel Papa's projects and case studies",
  },
  { href: "/now", label: "Now", title: "What Uriel Papa is working on now" },
  {
    href: "/stack",
    label: "Stack",
    title: "The tools and tech stack Uriel Papa uses",
  },
  { href: "/about", label: "About", title: "About Uriel Papa" },
  { href: "/colophon", label: "Colophon", title: "How this site is built" },
  {
    href: "/privacy",
    label: "Privacy",
    title: "Privacy policy for urielpapa.com",
  },
];
---

<!-- The footer's top margin is the only space at the end of a page (see the
     rhythm note in global.css). On phones the three link lists share two
     columns, and the long "Site" list runs in two columns at every width. -->
<footer class="app-layout mt-10 sm:mt-12">
  <div
    class="border-border grid grid-cols-2 gap-x-6 gap-y-8 border-t py-8 md:grid-cols-[1.5fr_1fr_1.2fr_1fr] md:gap-x-8"
  >
    <div class="col-span-2 max-w-sm md:col-span-1">
      <div class="flex items-center gap-3">
        <Avatar size={40} />
        <a
          href="/about"
          class="font-display text-lg font-bold no-underline"
          title="About Uriel Papa">{SITE.name}</a
        >
      </div>
      <p class="meta mt-3">{SITE.bio}</p>
      <p class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
        <a href="/newsletter" title="Get Uriel Papa's newsletter by email"
          >Newsletter</a
        >
        <a
          href="/rss.xml"
          class="inline-flex items-center gap-1"
          title="Follow new posts by RSS feed"
          ><IconRss class="size-4" aria-hidden="true" />RSS</a
        >
        <a href="/contact" title="Contact Uriel Papa">Contact</a>
        <a
          href="/contact#work"
          title="Work with Uriel Papa: book a free 15-minute discovery call"
          data-event="work_with_me_click"
          data-event-from="footer">Work with me</a
        >
      </p>
    </div>

    <nav aria-label="Topics">
      <h2 class="label-caps text-muted-foreground mb-3">Topics</h2>
      <ul class="space-y-2 text-sm">
        {
          HUBS.map(h => (
            <li>
              <a
                href={`/topics/${h.id}`}
                title={`Read Uriel Papa's writing on ${h.name}`}
              >
                {h.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Site" class="max-md:order-last max-md:col-span-2">
      <h2 class="label-caps text-muted-foreground mb-3">Site</h2>
      <ul class="columns-2 space-y-2 gap-x-6 text-sm">
        {
          siteLinks.map(l => (
            <li>
              <a href={l.href} title={l.title}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="label-caps text-muted-foreground mb-3">Elsewhere</h2>
      <ul class="space-y-2 text-sm">
        {
          SOCIALS.map(s => (
            <li>
              <a
                href={s.url}
                rel="me noopener"
                class="inline-flex items-center gap-1.5"
                title={`Uriel Papa on ${s.label}`}
                data-event="outbound_profile_click"
                data-event-network={s.name}
              >
                <SocialIcon name={s.name} />
                {s.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={`mailto:${SITE.email}`} title="Email Uriel Papa">
            {SITE.email}
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div
    class="border-border flex flex-wrap items-center justify-between gap-x-4 gap-y-3 border-t py-4"
  >
    <p class="meta flex flex-wrap items-center gap-x-4">
      <span>© {year} {SITE.name}</span>
      <a href="#top" title="Back to the top of this page">Back to top ↑</a>
    </p>
    {
      TRUST_BADGES.length > 0 && (
        <ul class="flex flex-wrap items-center gap-3" aria-label="Badges">
          {TRUST_BADGES.map(b => (
            <li>
              <a href={b.href} target="_blank" rel="noopener" title={b.alt}>
                <img
                  src={b.src}
                  alt={b.alt}
                  title={b.alt}
                  width={b.width}
                  height={b.height}
                  loading="lazy"
                  decoding="async"
                  class="dark:hue-rotate-180 dark:invert"
                />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>
