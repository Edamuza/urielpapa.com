---
/**
 * The full sponsor list of an event Uriel sponsored, by tier, with Uriel's own
 * entry highlighted. Data lives in src/data/events.json (sponsored[].roster).
 * MDX: <SponsorList event="wordcamp-philippines-2026" />
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Avatar from "@/components/Avatar.astro";
import events from "@/data/events.json";
import wcph2026 from "@/assets/images/content/wordcamp-philippines-2026-micro-sponsors.jpg";

/** Screenshots of each event's official sponsors page, showing my listing. */
const SCREENSHOTS: Record<string, { src: ImageMetadata; taken: string }> = {
  "wordcamp-philippines-2026": { src: wcph2026, taken: "13 November 2026" },
};

type Props = { event: string; class?: string };
const { event, class: className } = Astro.props;
const e = events.sponsored.find(s => s.id === event);
const shot = e ? SCREENSHOTS[e.id] : undefined;
---

{
  e && (
    <figure
      class:list={[
        "not-prose border-border rounded-lg border p-4 sm:p-5",
        className,
      ]}
      aria-labelledby={`${e.id}-sponsors-cap`}
    >
      <figcaption id={`${e.id}-sponsors-cap`} class="mb-4">
        <span class="label-caps text-muted-foreground block">Sponsor list</span>
        <span class="text-foreground font-semibold">{e.name} sponsors</span>
      </figcaption>
      {shot && (
        <div class="mb-5 max-w-3xl">
          <a
            href={e.sponsorsUrl}
            title={`Open the official ${e.name} sponsors page, where Uriel Papa is listed as a ${e.role.toLowerCase()}`}
            rel="noopener"
            class="border-border block overflow-hidden rounded-md border"
          >
            <Image
              src={shot.src}
              alt={`Screenshot of the Micro Sponsors section on the official ${e.name} sponsors page, listing Uriel Papa with a profile photo alongside five other micro sponsors`}
              title={`Uriel Papa listed as a ${e.role.toLowerCase()} on the official ${e.name} sponsors page`}
              widths={[640, 960, 1568]}
              sizes="(min-width: 768px) 720px, 100vw"
              loading="lazy"
              class="h-auto w-full"
            />
          </a>
          <p class="text-muted-foreground mt-2 text-sm">
            Screenshot of the{" "}
            <a
              href={e.sponsorsUrl}
              title={`Official ${e.name} sponsors page`}
              rel="noopener"
            >
              official sponsors page
            </a>
            , taken {shot.taken}.
          </p>
        </div>
      )}
      <dl class="space-y-4">
        {e.roster.map(group => (
          <div>
            <dt class="text-muted-foreground mb-1.5 text-sm">{group.tier}</dt>
            <dd>
              <ul class="flex flex-wrap gap-2">
                {group.sponsors.map(s =>
                  "me" in s && s.me ? (
                    <li>
                      <a
                        href={s.url}
                        title={`About ${s.name}, a ${e.role.toLowerCase()} of ${e.name}`}
                        class="bg-accent text-accent-foreground inline-flex items-center gap-2 rounded-full py-1 ps-1 pe-3 text-sm font-semibold no-underline hover:underline"
                      >
                        <Avatar
                          size={24}
                          alt={`Uriel Papa, ${e.role.toLowerCase()} of ${e.name}`}
                        />
                        {s.name} (me)
                      </a>
                    </li>
                  ) : (
                    <li>
                      <a
                        href={s.url}
                        title={
                          group.tier === "Micro sponsors"
                            ? `${s.name}, micro sponsor of ${e.name}`
                            : `${s.name}, ${group.tier} tier sponsor of ${e.name}`
                        }
                        rel="noopener"
                        class="border-border inline-flex items-center rounded-full border px-3 py-1 text-sm no-underline hover:underline"
                      >
                        {s.name}
                      </a>
                    </li>
                  )
                )}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
      <p class="text-muted-foreground mt-4 text-sm">
        Source:{" "}
        <a
          href={e.sponsorsUrl}
          title={`Official ${e.name} sponsors page`}
          rel="noopener"
        >
          official {e.name} sponsors page
        </a>
        .
      </p>
    </figure>
  )
}
