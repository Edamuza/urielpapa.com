---
/**
 * The full sponsor list of an event Uriel sponsored, as a plain tier-by-tier
 * list with Uriel's own entry in bold. Data lives in src/data/events.json (sponsored[].roster).
 * MDX: <SponsorList event="wordcamp-philippines-2026" />
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import events from "@/data/events.json";
import wcph2026 from "@/assets/images/content/wordcamp-philippines-2026-micro-sponsors.jpg";

/** Screenshots of each event's official sponsors page, showing my listing. */
const SCREENSHOTS: Record<string, { src: ImageMetadata; taken: string }> = {
  "wordcamp-philippines-2026": { src: wcph2026, taken: "13 November 2026" },
};

type Props = { event: string; class?: string };
const { event, class: className } = Astro.props;
const e = events.sponsored.find(s => s.id === event);
const shot = e ? SCREENSHOTS[e.id] : undefined;
---

{
  e && (
    <figure
      class:list={["not-prose", className]}
      aria-labelledby={`${e.id}-sponsors-cap`}
    >
      <figcaption
        id={`${e.id}-sponsors-cap`}
        class="text-foreground mb-3 font-semibold"
      >
        {e.name} sponsors
      </figcaption>
      {shot && (
        <a
          href={e.sponsorsUrl}
          title={`Open the official ${e.name} sponsors page, where Uriel Papa is listed as a ${e.role.toLowerCase()}`}
          rel="noopener"
          class="mb-4 block max-w-2xl"
        >
          <Image
            src={shot.src}
            alt={`Screenshot of the Micro Sponsors section on the official ${e.name} sponsors page, listing Uriel Papa with a profile photo alongside five other micro sponsors`}
            title={`Uriel Papa listed as a ${e.role.toLowerCase()} on the official ${e.name} sponsors page`}
            widths={[640, 960, 1344]}
            sizes="(min-width: 768px) 672px, 100vw"
            loading="lazy"
            class="border-border h-auto w-full rounded-md border"
          />
        </a>
      )}
      <dl class="divide-border border-border divide-y border-y text-[0.95rem]">
        {e.roster.map(group => (
          <div class="grid gap-0.5 py-2.5 sm:grid-cols-[11rem_1fr] sm:gap-4">
            <dt class="text-muted-foreground">{group.tier}</dt>
            <dd>
              {group.sponsors.map((s, i) => (
                <>
                  {i > 0 && ", "}
                  {"me" in s && s.me ? (
                    <a
                      href={s.url}
                      title={`About ${s.name}, a ${e.role.toLowerCase()} of ${e.name}`}
                      class="text-foreground font-semibold"
                    >
                      {s.name} (me)
                    </a>
                  ) : (
                    <a
                      href={s.url}
                      title={
                        group.tier === "Micro sponsors"
                          ? `${s.name}, micro sponsor of ${e.name}`
                          : `${s.name}, ${group.tier} tier sponsor of ${e.name}`
                      }
                      rel="noopener"
                      class="text-foreground no-underline hover:underline"
                    >
                      {s.name}
                    </a>
                  )}
                </>
              ))}
            </dd>
          </div>
        ))}
      </dl>
      <p class="text-muted-foreground mt-2 text-sm">
        From the{" "}
        <a
          href={e.sponsorsUrl}
          title={`Official ${e.name} sponsors page`}
          rel="noopener"
        >
          official sponsors page
        </a>
        {shot && `, screenshot taken ${shot.taken}`}.
      </p>
    </figure>
  )
}
