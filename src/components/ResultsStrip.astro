---
// Results strip on the home page, right under Proof of work: real client results
// (each linked to the story behind it), short client quotes once Uriel adds
// them, and one quiet link to the free discovery call. Nothing here is an
// example figure: the numbers come from RESULTS and TESTIMONIALS in config.ts.
import { RESULTS, TESTIMONIALS, WORK_WITH_ME_HREF } from "@/config";

type Props = { from: string };
const { from } = Astro.props;
---

{
  RESULTS.length > 0 && (
    <section class="border-border border-b py-8" aria-labelledby="results-h">
      <h2 id="results-h" class="label-caps text-muted-foreground mb-5">
        Real numbers from real work
      </h2>
      {/* Phones and tablets: one swipeable row of cards that snaps to each
          card, with the next one peeking in at the edge so it reads as
          scrollable. From lg up it is the three-across grid. */}
      <ul
        class="results-track -mx-4 flex snap-x snap-mandatory scroll-px-4 gap-3 overflow-x-auto px-4 pb-1 sm:-mx-6 sm:scroll-px-6 sm:gap-4 sm:px-6 lg:mx-0 lg:grid lg:grid-cols-3 lg:gap-6 lg:overflow-visible lg:px-0 lg:pb-0"
        aria-label="Client results"
      >
        {RESULTS.map(r => (
          <li class="result-card border-border bg-muted/50 hover:border-foreground w-[80%] shrink-0 snap-start rounded-xl border transition-colors duration-150 sm:w-[19rem] lg:w-auto">
            <a
              href={r.href}
              title={r.title}
              class="group flex h-full flex-col p-4 no-underline sm:p-5"
            >
              <span class="text-muted-foreground flex items-center gap-1.5 text-xs font-semibold tracking-[0.08em] uppercase">
                <span
                  class="bg-foreground size-1.5 rounded-full"
                  aria-hidden="true"
                />
                {r.kind}
              </span>
              <span class="font-display mt-2 block text-lg leading-tight font-bold sm:text-xl">
                {r.value}
              </span>
              <span class="mt-1 block">{r.text}</span>
              <span class="meta mt-auto flex items-center justify-between pt-3 group-hover:underline">
                <span>See how it worked</span>
                <span
                  aria-hidden="true"
                  class="transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                >
                  →
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      {TESTIMONIALS.length > 0 && (
        <ul class="mt-6 grid gap-6 sm:grid-cols-2">
          {TESTIMONIALS.map(t => (
            <li>
              <figure class="border-foreground border-s-2 ps-4">
                <blockquote class="text-lg">“{t.quote}”</blockquote>
                <figcaption class="meta mt-2">
                  {t.href ? (
                    <a href={t.href} title={`${t.name}, ${t.role}`}>
                      {t.name}
                    </a>
                  ) : (
                    t.name
                  )}
                  , {t.role}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )}
      <p class="mt-6 font-semibold">
        Want results like these?{" "}
        <a
          href={WORK_WITH_ME_HREF}
          title="Book a free 15-minute discovery call with Uriel Papa"
          data-event="work_with_me_click"
          data-event-from={from}
          class="whitespace-nowrap"
        >
          Book a free 15-minute call →
        </a>
      </p>
      <p class="meta mt-1">
        No obligation. I read and answer every message myself.
      </p>
    </section>
  )
}

<style>
  /* Below lg the cards scroll sideways. The scrollbar is hidden: the next
     card peeking in at the edge already shows there is more to swipe. */
  @media (max-width: 1023px) {
    .results-track {
      scrollbar-width: none;
    }
    .results-track::-webkit-scrollbar {
      display: none;
    }
  }
</style>
