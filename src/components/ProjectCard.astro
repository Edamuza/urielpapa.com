---
type Props = {
  href: string;
  title: string;
  summary: string;
  liveUrl?: string;
};
const { href, title, summary, liveUrl } = Astro.props;
---

<li class="border-foreground/80 flex flex-col rounded-lg border p-4">
  <h3 class="text-lg font-semibold"><a href={href}>{title}</a></h3>
  <p class="mt-1 flex-1 text-[0.95rem]">{summary}</p>
  <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm font-semibold">
    <a href={href}>Case study →</a>
    {
      liveUrl && (
        <a href={liveUrl} rel="noopener">
          Live demo ↗
        </a>
      )
    }
  </p>
</li>
