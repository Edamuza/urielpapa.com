---
import type { ImageMetadata } from "astro";
import ProjectCover from "@/components/ProjectCover.astro";

type Props = {
  href: string;
  title: string;
  summary: string;
  liveUrl?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
};
const { href, title, summary, liveUrl, cover, coverAlt } = Astro.props;
---

<li
  class="border-foreground/80 flex flex-col overflow-hidden rounded-lg border"
>
  <ProjectCover
    title={title}
    src={cover}
    alt={coverAlt}
    widths={[400, 560, 720, 800, 960]}
    sizes="(min-width: 1024px) 24rem, (min-width: 640px) calc(50vw - 2rem), calc(100vw - 2rem)"
    class="border-border w-full border-b text-4xl"
  />
  <div class="flex flex-1 flex-col p-4">
    <h3 class="text-lg font-semibold"><a href={href}>{title}</a></h3>
    <p class="mt-1 flex-1 text-[0.95rem]">{summary}</p>
    <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm font-semibold">
      <a href={href}>Case study →</a>
      {
        liveUrl && (
          <a href={liveUrl} rel="noopener">
            Live demo ↗
          </a>
        )
      }
    </p>
  </div>
</li>
