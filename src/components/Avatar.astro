---
import { SITE } from "@/config";

type Props = { size?: number; class?: string };
const { size = 56, class: className } = Astro.props;
---

{
  SITE.photo ? (
    <img
      src={SITE.photo}
      alt={SITE.name}
      width={size}
      height={size}
      class:list={["rounded-full object-cover", className]}
      style={{ width: `${size}px`, height: `${size}px` }}
    />
  ) : (
    // Placeholder monogram until a real photo is added (SITE.photo in src/config.ts)
    <span
      class:list={[
        "bg-accent text-accent-foreground font-display inline-flex shrink-0 items-center justify-center rounded-full font-bold select-none",
        className,
      ]}
      style={{
        width: `${size}px`,
        height: `${size}px`,
        fontSize: `${Math.round(size * 0.38)}px`,
      }}
      aria-hidden="true"
    >
      UP
    </span>
  )
}
