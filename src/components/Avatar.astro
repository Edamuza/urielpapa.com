---
import { Image } from "astro:assets";
import { SITE } from "@/config";
import photo from "@/assets/images/uriel-papa.jpg";

/**
 * Set eager where the avatar is above the fold (home intro, About). The name
 * always sits next to the avatar, so the photo is decorative (empty alt).
 */
type Props = { size?: number; class?: string; eager?: boolean };
const { size = 56, class: className, eager = false } = Astro.props;
---

{
  SITE.photo ? (
    <Image
      src={photo}
      alt=""
      width={size}
      height={size}
      densities={[1, 2]}
      loading={eager ? "eager" : "lazy"}
      class:list={["shrink-0 rounded-full object-cover", className]}
      style={{ width: `${size}px`, height: `${size}px` }}
    />
  ) : (
    // Placeholder monogram until a real photo is added (SITE.photo in src/config.ts)
    <span
      class:list={[
        "bg-accent text-accent-foreground font-display inline-flex shrink-0 items-center justify-center rounded-full font-bold select-none",
        className,
      ]}
      style={{
        width: `${size}px`,
        height: `${size}px`,
        fontSize: `${Math.round(size * 0.38)}px`,
      }}
      aria-hidden="true"
    >
      UP
    </span>
  )
}
