---
/** Copy link + native share + plain intent links. No third-party scripts. */
type Props = { url: string; title: string };
const { url, title } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const links = [
  {
    name: "LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
  },
  { name: "X", href: `https://x.com/intent/post?url=${u}&text=${t}` },
  {
    name: "Threads",
    href: `https://www.threads.net/intent/post?text=${t}%20${u}`,
  },
  {
    name: "Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
  },
  { name: "Reddit", href: `https://www.reddit.com/submit?url=${u}&title=${t}` },
];
---

<div class="my-6" data-share data-url={url} data-title={title}>
  <p class="label-caps text-muted-foreground mb-2">Share</p>
  <ul class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
    <li>
      <button type="button" class="underline underline-offset-[3px]" data-copy
        >Copy link</button
      >
    </li>
    <li class="hidden" data-native-wrap>
      <button type="button" class="underline underline-offset-[3px]" data-native
        >Share…</button
      >
    </li>
    {
      links.map(l => (
        <li>
          <a href={l.href} rel="noopener" target="_blank">
            {l.name}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="sr-only" aria-live="polite" data-share-status></p>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>("[data-share]")) {
    const url = box.dataset.url ?? location.href;
    const title = box.dataset.title ?? document.title;
    const status = box.querySelector("[data-share-status]");
    const copy = box.querySelector<HTMLButtonElement>("[data-copy]");
    copy?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(url);
        copy.textContent = "Link copied";
        if (status) status.textContent = "Link copied to clipboard";
        setTimeout(() => (copy.textContent = "Copy link"), 1500);
      } catch {
        if (status) status.textContent = "Could not copy the link";
      }
    });
    if (typeof navigator.share === "function") {
      box.querySelector("[data-native-wrap]")?.classList.remove("hidden");
      box.querySelector("[data-native]")?.addEventListener("click", () => {
        navigator.share({ url, title }).catch(() => {});
      });
    }
  }
</script>
