---
// Certificates with a thumbnail, issuer, date and a way to verify each one.
import { Image } from "astro:assets";
import { CERTIFICATIONS } from "@/data/certifications";

const items = [...CERTIFICATIONS].sort((a, b) => b.date.localeCompare(a.date));
---

<ul class="space-y-6">
  {
    items.map(c => (
      <li class="border-border flex flex-col gap-4 rounded-lg border p-4 sm:flex-row">
        <a
          href={c.pdf ?? c.image.src}
          class="block shrink-0 sm:w-56"
          rel="noopener"
        >
          <Image
            src={c.image}
            alt={c.imageAlt}
            title={c.name}
            width={448}
            class="border-border w-full rounded border"
          />
        </a>
        <div class="min-w-0">
          <p class="font-semibold">{c.name}</p>
          <p class="meta mt-0.5">
            {c.issuer} · {c.dateLabel}
          </p>
          <p class="mt-1.5 text-[0.95rem]">{c.detail}</p>
          <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[0.95rem]">
            {c.verifyUrl && (
              <a href={c.verifyUrl} rel="noopener">
                Verify on {new URL(c.verifyUrl).hostname} ↗
              </a>
            )}
            {c.pdf && <a href={c.pdf}>View the PDF</a>}
            {c.project && (
              <a href={`/projects/${c.project}`}>See the project</a>
            )}
          </p>
          {c.verifyHint && <p class="meta mt-1">{c.verifyHint}</p>}
        </div>
      </li>
    ))
  }
</ul>
