---
// An image card for one project, used in the project grids on the home and
// projects pages. The whole card opens the case study; the live demo link
// sits above that so it stays clickable on its own.
import type { CollectionEntry } from "astro:content";
import ProjectCover from "@/components/ProjectCover.astro";
import { projectUrl } from "@/utils/content";

type Props = {
  project: CollectionEntry<"projects">;
  stack?: CollectionEntry<"stack">[];
  headingLevel?: 2 | 3;
};
const { project, stack = [], headingLevel = 3 } = Astro.props;
const { data } = project;
const href = projectUrl(project);
const Heading = `h${headingLevel}` as "h2" | "h3";
const liveHost = data.liveUrl ? new URL(data.liveUrl).hostname : undefined;
---

<li
  class="group border-border bg-background hover:border-foreground/70 relative flex flex-col overflow-hidden rounded-xl border transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_12px_32px_-16px_rgb(0_0_0/0.35)] motion-reduce:hover:translate-y-0"
>
  <div class="bg-muted border-border overflow-hidden border-b">
    <ProjectCover
      title={data.title}
      src={data.cover}
      alt={data.coverAlt}
      widths={[400, 560, 720, 800]}
      sizes="(min-width: 1024px) 22rem, (min-width: 640px) calc(50vw - 2.5rem), calc(100vw - 2rem)"
      class="w-full text-4xl transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:group-hover:scale-100"
    />
  </div>
  <div class="flex flex-1 flex-col p-5">
    <p class="label-caps text-muted-foreground">
      {data.year}{data.status.startsWith("Live") && " · Live"}
    </p>
    <Heading class="h3 mt-1.5 leading-snug">
      <a
        href={href}
        title={`${data.title} case study`}
        class="no-underline group-hover:underline after:absolute after:inset-0 after:content-['']"
        >{data.title}</a
      >
    </Heading>
    <p class="text-muted-foreground mt-2 flex-1 text-[0.95rem] leading-relaxed">
      {data.outcome}
    </p>
    {
      stack.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Built with">
          {stack.slice(0, 3).map(s => (
            <li class="bg-muted rounded-full px-2.5 py-0.5 text-xs">
              {s.data.name}
            </li>
          ))}
        </ul>
      )
    }
    <p
      class="border-border mt-4 flex items-center justify-between gap-3 border-t pt-3 text-sm font-semibold"
    >
      <span aria-hidden="true">Case study →</span>
      {
        liveHost && (
          <a
            href={data.liveUrl}
            rel="noopener"
            title={`Open the live ${data.title} demo at ${liveHost}`}
            class="relative z-10 truncate"
          >
            Live demo ↗
          </a>
        )
      }
    </p>
  </div>
</li>
