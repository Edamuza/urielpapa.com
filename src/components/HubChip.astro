---
import { hubName } from "@/data/hubs";

type Props = { hub: string; active?: boolean; size?: "sm" | "md" };
const { hub, active = false, size = "sm" } = Astro.props;
---

<a
  href={`/topics/${hub}`}
  class:list={[
    "border-foreground inline-flex items-center rounded-full border font-medium no-underline hover:underline",
    size === "sm" ? "px-2.5 py-0.5 text-xs" : "px-3 py-1 text-sm",
    active && "bg-accent text-accent-foreground border-accent",
  ]}
  aria-current={active ? "page" : undefined}
>
  {hubName(hub)}
</a>
