---
// A GitHub repository card for a project page or a post (as <RepoCard repo="owner/name" /> in MDX).
import GitHub from "@/assets/icons/socials/github.svg";
import { getRepo } from "@/data/repos";

type Props = { repo: string; class?: string };
const { class: className = "my-8" } = Astro.props;
const info = await getRepo(Astro.props.repo);

// GitHub's own colors for the languages these projects use.
const LANGUAGE_COLORS: Record<string, string> = {
  TypeScript: "#3178c6",
  JavaScript: "#f1e05a",
  PHP: "#4f5d95",
  Python: "#3572a5",
  Swift: "#f05138",
  CSS: "#663399",
  HTML: "#e34c26",
  Blade: "#f7523f",
};
const dot = info.language ? LANGUAGE_COLORS[info.language] : undefined;
const stars = (info.stars ?? 0).toLocaleString("en-US");
---

<aside
  class:list={[
    "not-prose max-w-read border-border flex flex-wrap items-center gap-x-4 gap-y-3 rounded-lg border p-4",
    className,
  ]}
  aria-label="Source code"
>
  <GitHub class="size-8 shrink-0" aria-hidden="true" />
  <div class="min-w-0 flex-1 basis-56">
    <p class="font-semibold break-words">
      <a href={info.url} rel="noopener" title={`${info.repo} on GitHub`}>
        <span class="font-normal">{info.owner}/</span>{info.name}
      </a>
    </p>
    {
      info.description && (
        <p class="mt-0.5 text-[0.95rem]">{info.description}</p>
      )
    }
    {
      (info.language || info.license || (info.stars ?? 0) > 0) && (
        <p class="meta mt-1.5 flex flex-wrap gap-x-4 gap-y-1">
          {info.language && (
            <span class="inline-flex items-center gap-1.5">
              <span
                class="bg-muted-foreground inline-block size-2.5 rounded-full"
                style={dot ? `background-color:${dot}` : undefined}
                aria-hidden="true"
              />
              {info.language}
            </span>
          )}
          {info.license && <span>{info.license} license</span>}
          {(info.stars ?? 0) > 0 && (
            <span>
              {stars} {info.stars === 1 ? "star" : "stars"}
            </span>
          )}
        </p>
      )
    }
  </div>
  <a
    href={info.url}
    rel="noopener"
    class="btn shrink-0"
    title={`View ${info.repo} on GitHub`}
  >
    View on GitHub ↗
  </a>
  {
    info.readme && (
      <div class="border-border basis-full border-t pt-3">
        <p class="label-caps text-muted-foreground">From the README</p>
        <div class="mt-1.5 space-y-2 text-[0.95rem]">
          {info.readme.map(p => (
            <p>{p}</p>
          ))}
        </div>
        <p class="mt-2 text-[0.95rem]">
          <a
            href={`${info.url}#readme`}
            rel="noopener"
            title={`Read the full README of ${info.repo} on GitHub`}
          >
            Read the full README ↗
          </a>
        </p>
      </div>
    )
  }
</aside>
