---
type Props = { href: string; name: string; summary: string; count: number };
const { href, name, summary, count } = Astro.props;
---

<li class="border-foreground/80 flex flex-col rounded-lg border p-4">
  <h3 class="text-lg font-semibold"><a href={href}>{name}</a></h3>
  <p class="mt-1 flex-1 text-[0.95rem]">{summary}</p>
  <p class="meta mt-3">
    {
      count === 0
        ? "First posts coming soon"
        : `${count} ${count === 1 ? "post" : "posts"}`
    }
  </p>
</li>
