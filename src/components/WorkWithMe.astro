---
/** Quiet "work with me" line (ux-ui-spec.md §5.10): end of long posts, About, Projects only. */
type Props = {
  text?: string;
  linkText?: string;
  from: string;
  align?: "center" | "start";
};
const {
  text = "Building something like this?",
  linkText = "Let's talk →",
  from,
  align = "center",
} = Astro.props;
---

<p
  class:list={[
    "max-w-read my-8 text-lg",
    align === "center" && "mx-auto text-center",
  ]}
>
  {text}{" "}
  <a
    href="/contact#work"
    class="font-semibold whitespace-nowrap"
    data-event="work_with_me_click"
    data-event-from={from}>{linkText}</a
  >
</p>
