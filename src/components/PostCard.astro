---
import { Image } from "astro:assets";
import HubChip from "./HubChip.astro";
import { formatDate, isoDate } from "@/utils/content";
import { frameLabel } from "@/data/hubs";
import type { Thumb } from "@/utils/thumbnails";

type Props = {
  href: string;
  title: string;
  summary?: string;
  hub?: string;
  date: Date;
  minutes?: number;
  frame?: string;
  draft?: boolean;
  headingLevel?: "h2" | "h3";
  showHub?: boolean;
  /** Small picture on the right of the row (see utils/thumbnails.ts). */
  thumb?: Thumb;
  /** "compact" drops the summary and uses a smaller title, for short lists. */
  variant?: "default" | "compact";
};

const {
  href,
  title,
  summary,
  hub,
  date,
  minutes,
  frame,
  draft,
  headingLevel: Heading = "h3",
  showHub = true,
  thumb,
  variant = "default",
} = Astro.props;
const compact = variant === "compact";
---

<li
  class:list={[
    "post-card border-border border-b py-5 first:pt-0 last:border-b-0",
    thumb &&
      "grid grid-cols-[minmax(0,1fr)_6rem] items-start gap-4 sm:grid-cols-[minmax(0,1fr)_8.5rem] sm:gap-5",
  ]}
>
  <div class="min-w-0">
    <Heading
      class:list={[
        "leading-snug font-semibold",
        compact ? "text-base sm:text-lg" : "text-lg sm:text-xl",
      ]}
    >
      <a href={href} title={`Read: ${title}`}>{title}</a>
    </Heading>
    {summary && !compact && <p class="mt-1.5">{summary}</p>}
    <p class="meta mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
      {showHub && hub && <HubChip hub={hub} />}
      {frame && <span>{frameLabel(frame)}</span>}
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
      {minutes && <span>{minutes} min read</span>}
      {
        draft && (
          <span class="border-foreground rounded border border-dashed px-1.5 text-xs font-semibold">
            Draft
          </span>
        )
      }
    </p>
  </div>
  {
    thumb && (
      <a
        href={href}
        tabindex="-1"
        aria-hidden="true"
        class="post-card__thumb border-border bg-muted block overflow-hidden rounded-lg border"
        title={`Read: ${title}`}
      >
        <Image
          src={thumb.src}
          alt={thumb.alt}
          title={thumb.title}
          widths={[192, 288, 384]}
          sizes="(min-width: 640px) 8.5rem, 6rem"
          class="aspect-[3/2] h-auto w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </a>
    )
  }
</li>
